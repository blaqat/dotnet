@variants(tagStatesI10)
tagStates = frame : doc.docBoard {
  title: "Tag · states · i9",
  left: 0px,
  top: 556px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Tag · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-tag, after = .nil),
      insert(st-tagHover, after = st-tag),
      insert(st-tagFocus, after = st-tagHover),
      insert(st-tagMatch, after = st-tagFocus),
      insert(st-tagMatchHover, after = st-tagMatch),
      insert(st-tagMore, after = st-tagMatchHover)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-tagStack, after = .nil),
      insert(st-tagStackMatch, after = st-tagStack),
      insert(st-tagPress, after = st-tagStackMatch)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-tagRow, after = .nil),
      insert(st-tagStackRow, after = st-tagRow)
    ]
  }

  st-tag = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tag"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "rest: a hashtag"
    }

    it = frame : tag {}
  }

  st-tagHover = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tagHover"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "hover"
    }

    it = frame : tagHover {}
  }

  st-tagFocus = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tagFocus"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "focus (keys)"
    }

    it = frame : tagFocus {}
  }

  st-tagMatch = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tagMatch"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "match: pressed / a typed hit"
    }

    it = frame : tagMatch {}
  }

  st-tagMatchHover = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tagMatchHover"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "match + hover: the strike"
    }

    it = frame : tagMatchHover {}
  }

  st-tagMore = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tagMore"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the rest of a folded list"
    }

    it = frame : tagMore {}
  }

  st-tagStack = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tagStack"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a stack tag"
    }

    it = frame : tagStack {}
  }

  st-tagStackMatch = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tagStackMatch"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "stack tag · match"
    }

    it = frame : tagStackMatch {}
  }

  st-tagPress = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tagPress"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a tag you press (Thoughts)"
    }

    it = frame : tagPress {}
  }

  st-tagRow = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tagRow"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a row's tags"
    }

    it = frame : tagRow {}
  }

  st-tagStackRow = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tagStackRow"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a project's stack"
    }

    it = frame : tagStackRow {}
  }
}

@variants(tagStatesI11)
@context(i10="on")
tagStatesI10 = frame : tagStates {
  title: "Tag · states · i10",
  left: 1094px,
  top: 556px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }
}

@context(i10="on", i11="on")
tagStatesI11 = frame : tagStatesI10 {
  title: "Tag · states · i11",
  left: 2191px,
  top: 556px,

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
    }
  }
}
