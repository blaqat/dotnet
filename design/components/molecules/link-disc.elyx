@variants(linkDiscStatesI10)
linkDiscStates = frame : doc.docBoard {
  title: "Link disc · states · i9",
  left: 0px,
  top: 400px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [insert(row-1, after = .nil), insert(row-2, after = row-1)]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Link disc · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-linkDisc, after = .nil),
      insert(st-linkDiscHover, after = st-linkDisc),
      insert(st-linkDiscFocus, after = st-linkDiscHover)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-linkDiscSoundcloud, after = .nil),
      insert(st-linkDiscBeepbox, after = st-linkDiscSoundcloud),
      insert(st-linkDiscYoutube, after = st-linkDiscBeepbox),
      insert(st-linkDiscGithub, after = st-linkDiscYoutube),
      insert(st-linkDiscExternal, after = st-linkDiscGithub),
      insert(st-linkDiscWriteup, after = st-linkDiscExternal),
      insert(st-linkDiscDiscord, after = st-linkDiscWriteup)
    ]
  }

  st-linkDisc = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "linkDisc"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "rest · link"
    }

    it = frame : linkDisc {}
  }

  st-linkDiscHover = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "linkDiscHover"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "hover: lifts, fills"
    }

    it = frame : linkDiscHover {}
  }

  st-linkDiscFocus = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "linkDiscFocus"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "focus (keys)"
    }

    it = frame : linkDiscFocus {}
  }

  st-linkDiscSoundcloud = frame : doc.spec {
    label {
      contents: "linkDiscSoundcloud"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    it = frame : linkDiscSoundcloud {}
  }

  st-linkDiscBeepbox = frame : doc.spec {
    label {
      contents: "linkDiscBeepbox"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    it = frame : linkDiscBeepbox {}
  }

  st-linkDiscYoutube = frame : doc.spec {
    label {
      contents: "linkDiscYoutube"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    it = frame : linkDiscYoutube {}
  }

  st-linkDiscGithub = frame : doc.spec {
    label {
      contents: "linkDiscGithub"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    it = frame : linkDiscGithub {}
  }

  st-linkDiscExternal = frame : doc.spec {
    label {
      contents: "linkDiscExternal"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    it = frame : linkDiscExternal {}
  }

  st-linkDiscWriteup = frame : doc.spec {
    label {
      contents: "linkDiscWriteup"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    it = frame : linkDiscWriteup {}
  }

  st-linkDiscDiscord = frame : doc.spec {
    label {
      contents: "linkDiscDiscord"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    it = frame : linkDiscDiscord {}
  }
}

