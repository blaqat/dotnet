import "assets/icons/bold/soundcloud-logo.svg" as soundcloudBold
import "assets/icons/brand/beepbox.svg" as beepboxBold
import "assets/icons/bold/youtube-logo.svg" as youtubeBold
import "assets/icons/bold/github-logo.svg" as githubBold
import "assets/icons/bold/arrow-up-right.svg" as externalBold
import "assets/icons/bold/article.svg" as writeupBold
import "assets/icons/duotone/link.svg" as linkDuo
import "assets/icons/duotone/soundcloud-logo.svg" as soundcloudDuo
import "assets/icons/duotone/circle.svg" as beepboxDuo
import "assets/icons/duotone/youtube-logo.svg" as youtubeDuo
import "assets/icons/duotone/github-logo.svg" as githubDuo
import "assets/icons/duotone/arrow-up-right.svg" as externalDuo
import "assets/icons/duotone/article.svg" as writeupDuo
