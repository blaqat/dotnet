// ---- interaction states (the kit's round link icons: rest · hover ·
// focus). Hover lifts and fills: ink with a white glyph (a known site
// fades to its own colour in the live kit). Focus: the ink ring outside.
@variants(linkDiscHoverI10)
export linkDiscHover = frame : linkDisc {
  title: "Link disc · hover",
  left: 185px,
  top: 40px,
  border[0].color: pal.palette.hairline,
  fill[0].color: col.roles.fg,
  shadow[0].drop-shadow.blur-radius: 22px,
  shadow[0].drop-shadow.color: pal.palette.shadow-lift,
  shadow[0].drop-shadow.offset: [0px, 10px],
  shadow[0].drop-shadow.spread: -4px,

  glyph {
    fill[0].color: col.roles.surface
  }
}

@variants(linkDiscFocusI10)
export linkDiscFocus = frame : linkDisc {
  title: "Link disc · focus",
  left: 370px,
  top: 40px,
  overrides: [insert(discFocusRing, after = linkDisc.glyph)],

  discFocusRing = frame : surf.focusRing {
    left: spc.layout.focus-out,
    top: spc.layout.focus-out,
    right: spc.layout.focus-out,
    bottom: spc.layout.focus-out,
    width: .nil,
    height: .nil,
    ignore-stack: .true
  }
}

