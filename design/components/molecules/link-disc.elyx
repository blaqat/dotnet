// Every outside link is one part (i10 R7): a 32px disc and its site's glyph.
// i9 (the base): white discs, the bold glyph in ink, a hairline + a soft
// shadow (the link glyph, the SoundCloud mark, BeepBox's ringed circle each
// on a white disc). i10: the one cotton-2 disc, the Phosphor duotone glyph
// in ink-3, no shadow. Colours are col.roles.linkdisc-* tokens; the glyph's
// weight (bold → duotone) is the I10 variant of each kind. A parent's I10
// variant picks it with @with-variant (e.g. lnk.linkDiscSoundcloudI10).
// Child: `glyph`.
@variants(
  linkDiscI10,
  linkDiscSoundcloud,
  linkDiscBeepbox,
  linkDiscYoutube,
  linkDiscGithub,
  linkDiscExternal,
  linkDiscWriteup,
  linkDiscDiscord,
  linkDiscHover,
  linkDiscFocus
)
export linkDisc = frame : surf.disc {
  title: "Link disc · link",
  left: 0px,
  top: 40px,
  border[0].color: col.roles.linkdisc-line,
  border[0].position: .outside,
  fill[0].color: col.roles.linkdisc-bg,
  overrides: [insert(glyph, after = .nil)],
  shadow[0].drop-shadow.blur-radius: 2px,
  shadow[0].drop-shadow.color: col.roles.linkdisc-shadow,
  shadow[0].drop-shadow.offset: [0px, 1px],

  glyph = asset {
    width: spc.controls.linkdisc-icon,
    height: spc.controls.linkdisc-icon,
    fill: col.roles.linkdisc-fg,
    contents: linkBold
  }
}

@variants(linkDiscSoundcloudI10)
export linkDiscSoundcloud = frame : linkDisc {
  title: "Link disc · SoundCloud",
  left: 542px,
  top: 40px,

  glyph {
    contents: soundcloudBold
  }
}

