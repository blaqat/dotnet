@variants(feedbackStatesI10)
feedbackStates = frame : doc.docBoard {
  title: "Toast · hint · empty · states · i9",
  left: 0px,
  top: 745px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Toast · hint · empty · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-kbd, after = .nil),
      insert(st-kbdIcon, after = st-kbd),
      insert(st-kbdDark, after = st-kbdIcon),
      insert(st-hint, after = st-kbdDark),
      insert(st-tip, after = st-hint)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-toast, after = .nil),
      insert(st-toastAction, after = st-toast),
      insert(st-toastPlain, after = st-toastAction)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-empty, after = .nil),
      insert(st-emptyText, after = st-empty),
      insert(st-emptyQuiet, after = st-emptyText)
    ]
  }

  st-kbd = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "kbd"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a key"
    }

    it = frame : kbd {}
  }

  st-kbdIcon = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "kbdIcon"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a key with a glyph"
    }

    it = frame : kbdIcon {}
  }

  st-kbdDark = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "kbdDark"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a key on ink"
    }

    it = frame : kbdDark {}
  }

  st-hint = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "hint"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a key hint"
    }

    it = frame : hint {}
  }

  st-tip = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tip"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the hint (.ytip)"
    }

    it = frame : tip {}
  }

  st-toast = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "toast"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "toast · Undo"
    }

    it = frame : toast {}
  }

  st-toastAction = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "toastAction"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "toast · an action"
    }

    it = frame : toastAction {}
  }

  st-toastPlain = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "toastPlain"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "toast · words only"
    }

    it = frame : toastPlain {}
  }

  st-empty = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "empty"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "empty · title + action"
    }

    it = frame : empty {}
  }

  st-emptyText = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "emptyText"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "empty · + a second line"
    }

    it = frame : emptyText {}
  }

  st-emptyQuiet = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "emptyQuiet"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "empty · quiet"
    }

    it = frame : emptyQuiet {}
  }
}

@variants(feedbackStatesI11)
@context(i10="on")
feedbackStatesI10 = frame : feedbackStates {
  title: "Toast · hint · empty · states · i10",
  left: 2208px,
  top: 745px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }
}

@context(i10="on", i11="on")
feedbackStatesI11 = frame : feedbackStatesI10 {
  title: "Toast · hint · empty · states · i11",
  left: 4416px,
  top: 745px,

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
    }
  }
}
