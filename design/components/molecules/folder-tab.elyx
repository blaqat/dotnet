@context(i10="on")
folderTabStatesI10 = frame : folderTabStates {
  title: "Folder tab · states · i10",
  left: 1329px,
  top: 672px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }
}

@context(i10="on", i11="on")
folderTabStatesI11 = frame : folderTabStatesI10 {
  title: "Folder tab · states · i11",
  left: 2658px,
  top: 672px,

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
    }
  }
}
