@variants(folderTabStatesI10)
folderTabStates = frame : doc.docBoard {
  title: "Folder tab · states · i9",
  left: 0px,
  top: 672px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Folder tab · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-folderTab, after = .nil),
      insert(st-folderTabHover, after = st-folderTab),
      insert(st-folderTabCurrent, after = st-folderTabHover),
      insert(st-folderTabLive, after = st-folderTabCurrent)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-folderTabs, after = .nil),
      insert(st-folderTabsCurrent, after = st-folderTabs),
      insert(st-folderTabsLive, after = st-folderTabsCurrent)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-onCard, after = .nil),
      insert(st-onCardLive, after = st-onCard)
    ]
  }

  st-folderTab = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "folderTab"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a song's tab · rest"
    }

    it = frame : folderTab {}
  }

  st-folderTabHover = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "folderTabHover"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "hover: stands up"
    }

    it = frame : folderTabHover {}
  }

  st-folderTabCurrent = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "folderTabCurrent"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "current: loaded, paused"
    }

    it = frame : folderTabCurrent {}
  }

  st-folderTabLive = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "folderTabLive"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "live: playing"
    }

    it = frame : folderTabLive {}
  }

  st-folderTabs = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "folderTabs"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a collection's tabs · rest"
    }

    it = frame : folderTabs {}
  }

  st-folderTabsCurrent = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "folderTabsCurrent"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "one current"
    }

    it = frame : folderTabsCurrent {}
  }

  st-folderTabsLive = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "folderTabsLive"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "one live"
    }

    it = frame : folderTabsLive {}
  }

  st-onCard = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "onCard"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "in place on a card"
    }

    it = frame : onCard {}
  }

  st-onCardLive = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "onCardLive"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "on a card · live"
    }

    it = frame : onCardLive {}
  }
}

