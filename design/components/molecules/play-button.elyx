import "tokens/color/roles.elyx" as col
import "tokens/color/palette.elyx" as pal
import "tokens/space/space.elyx" as spc
import "components/atoms/text.elyx" as txt
import "components/atoms/surface.elyx" as surf
import "components/atoms/eq-bars.elyx" as eqa
import "assets/icons/fill/play.svg" as playIcon
import "assets/icons/fill/pause.svg" as pauseIcon
import "components/atoms/doc.elyx" as doc

@with-context()
file {}

// Yarn.playBtn: the ONE play button (i10 R7). A state changes its fill,
// never its shape or size. Rest = the act role: i9 red with a white stitch
// (every ▶ was solid red), i10 white with a hairline and an ink ▶.
// Current (loaded, paused) adds the live ring; Live (playing) is the live
// fill with white bars; LivePause shows ⏸ instead (hover, focus, eq off).
// Children: `playStitch`, `slot` (holds `playGlyph`, `pauseGlyph`, `eq`;
// one shows at a time) and `label` (shown only on the labelled pill).
@variants(playBtnCurrent, playBtnLive, playBtnSm, playBtnLabel)
export playBtn = frame {
  title: "Play · rest (act)",
  left: 0px,
  top: 40px,
  width: spc.controls.play,
  height: spc.controls.play,
  layout: {
    stack: {
      justify-content: .center,
      align-items: .center,
      item-gap: spc.layout.play-l-gap
    }
  },
  fill: col.roles.act-bg,
  border: [
    {color: col.roles.act-line, position: .outside},
    {color: col.roles.live, visible: .false, width: spc.layout.ring-w}
  ],
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: col.roles.ctl-shadow,
        offset: point(0px, 2px),
        blur-radius: 6px
      }
    }
  ],
  corner-radius: spc.radii.pill,
  children: [playStitch, slot, label],

  playStitch = frame : surf.stitch {
    left: spc.layout.stitch-in-ctl,
    top: spc.layout.stitch-in-ctl,
    right: spc.layout.stitch-in-ctl,
    bottom: spc.layout.stitch-in-ctl,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.pill,
    border[0].color: col.roles.ctl-stitch-fill
  }

  slot = frame {
    width: spc.controls.play-slot,
    height: spc.controls.play-slot,
    layout: {stack: {justify-content: .center, align-items: .center}},
    children: [playGlyph, pauseGlyph, eq]
  }

  // ▶ sits 1px right of centre (its optical centre in a round button)
  playGlyph = asset {
    width: spc.controls.play-icon,
    height: spc.controls.play-icon,
    transform: [1, 0, 1, 0, 1, 0],
    fill: col.roles.act-fg,
    contents: playIcon
  }

  pauseGlyph = asset {
    width: spc.controls.play-icon,
    height: spc.controls.play-icon,
    display: .none,
    fill: col.roles.live-fg,
    contents: pauseIcon
  }

  eq = frame : eqa.eqBarsOnLive {
    left: 0px,
    top: 0px,
    display: .none
  }

  label = text : txt.label {
    display: .none,
    contents: "Play all",
    fill[0].color: col.roles.act-fg
  }
}

// Current: loaded and paused. Act + the live ring; the ▶ in live-deep
// (i9: unchanged, the ring is red on red).
export playBtnCurrent = frame : playBtn {
  title: "Play · current",
  left: 192px,
  top: 40px,
  border[1].visible: .true,

  slot {
    playGlyph {
      fill[0].color: col.roles.act-current
    }
  }
}

// Live: playing. The live fill, white bars in the glyph's slot.
@variants(playBtnLivePause)
export playBtnLive = frame : playBtn {
  title: "Play · live",
  left: 403px,
  top: 40px,
  border[0].visible: .false,
  fill[0].color: col.roles.live,
  shadow[0].drop-shadow.color: pal.palette.shadow-lift,
  shadow[1].drop-shadow.blur-radius: 12px,
  shadow[1].drop-shadow.color: col.roles.live-glow,
  shadow[1].drop-shadow.offset: [0px, 4px],
  shadow[1].drop-shadow.spread: -4px,

  slot {
    playGlyph {
      display: .none
    }

    eq {
      display: .visible
    }
  }
}

// Live, showing ⏸ (hover / focus, or eq off).
export playBtnLivePause = frame : playBtnLive {
  title: "Play · live ⏸",
  left: 608px,
  top: 40px,

  slot {
    eq {
      display: .none
    }

    pauseGlyph {
      display: .visible
    }
  }
}

// Small (36): rows and dense cards.
@variants(playBtnSmCurrent, playBtnSmLive)
export playBtnSm = frame : playBtn {
  title: "Play · sm",
  left: 0px,
  top: 220px,
  width: spc.controls.play-sm,
  height: spc.controls.play-sm,

  slot {
    width: spc.controls.play-slot-sm,

    playGlyph {
      width: spc.controls.play-icon-sm,
      height: spc.controls.play-icon-sm
    }

    pauseGlyph {
      width: spc.controls.play-icon-sm,
      height: spc.controls.play-icon-sm
    }

    eq {
      width: spc.controls.eq-w,
      height: spc.controls.eq-h
    }

    height: spc.controls.play-slot-sm
  }
}

export playBtnSmCurrent = frame : playBtnSm {
  title: "Play · sm current",
  left: 192px,
  top: 220px,
  border[1].visible: .true,

  slot {
    playGlyph {
      fill[0].color: col.roles.act-current
    }
  }
}

export playBtnSmLive = frame : playBtnSm {
  title: "Play · sm live",
  left: 403px,
  top: 220px,
  border[0].visible: .false,
  fill[0].color: col.roles.live,
  shadow[0].drop-shadow.color: pal.palette.shadow-lift,
  shadow[1].drop-shadow.blur-radius: 12px,
  shadow[1].drop-shadow.color: col.roles.live-glow,
  shadow[1].drop-shadow.offset: [0px, 4px],
  shadow[1].drop-shadow.spread: -4px,

  slot {
    playGlyph {
      display: .none
    }

    eq {
      display: .visible
    }
  }
}

// The labelled pill ("▶ Play all"): act at rest, like the round one.
@variants(playBtnLabelSm, playBtnPrimary)
export playBtnLabel = frame : playBtn {
  title: "Play · labelled",
  left: 0px,
  top: 392px,
  width: .auto,
  padding-left: spc.layout.play-l-l,
  padding-right: spc.layout.play-l-r,

  label {
    display: .visible
  }
}

export playBtnLabelSm = frame : playBtnLabel {
  title: "Play · labelled sm",
  left: 192px,
  top: 392px,
  height: spc.controls.play-sm,
  padding-left: spc.layout.play-l-sm-l,
  padding-right: spc.layout.play-l-sm-r,
  layout.stack.item-gap: spc.layout.play-l-sm-gap,

  @with-variant(txt.labelCard)
  label {
    left: .nil
  }

  slot {
    width: spc.controls.play-slot-sm,

    playGlyph {
      width: spc.controls.play-icon-sm,
      height: spc.controls.play-icon-sm
    }

    height: spc.controls.play-slot-sm
  }
}

// Primary: the one primary per view (a release page's Play all): ink at
// rest from i10 (red in i9).
@variants(playBtnPrimaryLive)
export playBtnPrimary = frame : playBtnLabel {
  title: "Play · primary",
  left: 403px,
  top: 392px,
  border[0].visible: .false,
  fill[0].color: col.roles.primary-bg,
  shadow[1].drop-shadow.color: pal.palette.shadow-1,

  label {
    fill[0].color: col.roles.primary-fg
  }

  slot {
    playGlyph {
      fill[0].color: col.roles.primary-fg
    }
  }
}

// Primary while it plays ("Pause"): live, not ink.
export playBtnPrimaryLive = frame : playBtnPrimary {
  title: "Play · primary live",
  left: 608px,
  top: 392px,
  fill[0].color: col.roles.live,
  shadow[0].drop-shadow.color: pal.palette.shadow-lift,
  shadow[1].drop-shadow.blur-radius: 12px,
  shadow[1].drop-shadow.color: col.roles.live-glow,
  shadow[1].drop-shadow.offset: [0px, 4px],
  shadow[1].drop-shadow.spread: -4px,

  label {
    fill[0].color: col.roles.live-fg,
    contents: "Pause"
  }

  slot {
    playGlyph {
      display: .none
    }

    eq {
      display: .visible
    }
  }
}

