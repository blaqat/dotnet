@variants(playBtnStatesI10)
playBtnStates = frame : doc.docBoard {
  title: "Play button · states · i9",
  left: 0px,
  top: 596px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Play button · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-playBtn, after = .nil),
      insert(st-playBtnCurrent, after = st-playBtn),
      insert(st-playBtnLive, after = st-playBtnCurrent),
      insert(st-playBtnLivePause, after = st-playBtnLive)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-playBtnSm, after = .nil),
      insert(st-playBtnSmCurrent, after = st-playBtnSm),
      insert(st-playBtnSmLive, after = st-playBtnSmCurrent)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-playBtnLabel, after = .nil),
      insert(st-playBtnLabelSm, after = st-playBtnLabel),
      insert(st-playBtnPrimary, after = st-playBtnLabelSm),
      insert(st-playBtnPrimaryLive, after = st-playBtnPrimary)
    ]
  }

  st-playBtn = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playBtn"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "rest (act)"
    }

    it = frame : playBtn {}
  }

  st-playBtnCurrent = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playBtnCurrent"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "current: loaded, paused"
    }

    it = frame : playBtnCurrent {}
  }

  st-playBtnLive = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playBtnLive"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "live: playing, eq bars"
    }

    it = frame : playBtnLive {}
  }

  st-playBtnLivePause = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playBtnLivePause"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "live, pause glyph (hover · focus · eq off)"
    }

    it = frame : playBtnLivePause {}
  }

  st-playBtnSm = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playBtnSm"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "sm (36) · rest"
    }

    it = frame : playBtnSm {}
  }

  st-playBtnSmCurrent = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playBtnSmCurrent"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "sm · current"
    }

    it = frame : playBtnSmCurrent {}
  }

  st-playBtnSmLive = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playBtnSmLive"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "sm · live"
    }

    it = frame : playBtnSmLive {}
  }

  st-playBtnLabel = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playBtnLabel"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "labelled pill · rest"
    }

    it = frame : playBtnLabel {}
  }

  st-playBtnLabelSm = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playBtnLabelSm"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "labelled · sm"
    }

    it = frame : playBtnLabelSm {}
  }

  st-playBtnPrimary = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playBtnPrimary"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "primary (one per view)"
    }

    it = frame : playBtnPrimary {}
  }

  st-playBtnPrimaryLive = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playBtnPrimaryLive"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "primary · live (Pause)"
    }

    it = frame : playBtnPrimaryLive {}
  }
}

@variants(playBtnStatesI11)
@context(i10="on")
playBtnStatesI10 = frame : playBtnStates {
  title: "Play button · states · i10",
  left: 863px,
  top: 596px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }
}

@context(i10="on", i11="on")
playBtnStatesI11 = frame : playBtnStatesI10 {
  title: "Play button · states · i11",
  left: 1726px,
  top: 596px,

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
    }
  }
}
