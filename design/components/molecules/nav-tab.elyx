import "tokens/color/roles.elyx" as col
import "tokens/color/palette.elyx" as pal
import "tokens/color/sections.elyx" as sec
import "tokens/space/space.elyx" as spc
import "components/atoms/text.elyx" as txt
import "components/atoms/surface.elyx" as surf
import "assets/icons/bold/folder-simple.svg" as projectsIcon
import "assets/icons/fill/folder-simple.svg" as projectsIconFill
import "assets/icons/bold/music-notes.svg" as musicIcon
import "assets/icons/fill/music-notes.svg" as musicIconFill
import "assets/icons/bold/cloud.svg" as thoughtsIcon
import "assets/icons/fill/cloud.svg" as thoughtsIconFill
import "components/atoms/doc.elyx" as doc

@with-context()
file {}

// A nav tab (`.ynav__tab`): a raised 46px pill, a felt dot in the tab's own
// section hue, then its Label. i9: a knit pill with a dashed stitch and every
// dot in its hue. i10 (L1, calm): a hairline ring, no stitch, and the other
// tabs' dots grey until hover (`col.roles.dot-rest*`). An instance sets the
// section: `dot { fill[0].color: sec.section.hue-music  glyph {contents: …} }`
// and `label {contents: "Music"}`.
@variants(navTabHover, navTabHere)
export navTab = frame {
  title: "Nav tab · rest",
  left: 0px,
  top: 40px,
  height: spc.controls.tab,
  layout: {stack: {align-items: .center, item-gap: spc.steps.s2}},
  fill: col.roles.surface,
  shadow: [
    {
      drop-shadow: {
        color: col.roles.ctl-line,
        offset: point(0px, 0px),
        blur-radius: 0px,
        spread: 1px
      }
    },
    {
      drop-shadow: {
        color: col.roles.ctl-shadow,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: col.roles.ctl-shadow,
        offset: point(0px, 3px),
        blur-radius: 8px,
        spread: -2px
      }
    },
    {
      inner-shadow: {
        color: col.roles.ctl-shadow,
        offset: point(0px, -2px),
        blur-radius: 0px
      }
    }
  ],
  corner-radius: spc.radii.pill,
  padding: [0px, spc.layout.tab-r, 0px, spc.layout.tab-l],
  children: [tabStitch, dot, label],

  // the control's stitch (i9); clear from i10
  tabStitch = frame : surf.stitch {
    left: spc.layout.stitch-in,
    top: spc.layout.stitch-in,
    right: spc.layout.stitch-in,
    bottom: spc.layout.stitch-in,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.pill,
    border[0].color: col.roles.ctl-stitch,
    border[0].width: spc.layout.stitch-w-sm
  }

  // the felt dot: the section's hue + a soft highlight; `dotRest` greys it
  // at rest from i10 (clear in i9)
  dot = frame : surf.disc {
    border[0]: .nil,
    fill[0].color: sec.section.hue-projects,
    fill[1].radial-gradient.ellipse-scale: 1,
    fill[1].radial-gradient.from: [34%, 28%],
    fill[1].radial-gradient.to: [34%, -24%],
    overrides: [
      insert(dotRest, after = .nil),
      insert(dotStitch, after = dotRest),
      insert(glyph, after = dotStitch)
    ],
    shadow[0].drop-shadow.blur-radius: 2px,
    shadow[0].drop-shadow.color: pal.palette.shadow-lift,
    shadow[0].drop-shadow.offset: [0px, 1px],
    shadow[1].inner-shadow.blur-radius: 3px,
    shadow[1].inner-shadow.color: pal.palette.shadow-pop,
    shadow[1].inner-shadow.offset: [0px, -2px],

    dotRest = frame {
      left: 0px,
      top: 0px,
      right: 0px,
      bottom: 0px,
      ignore-stack: .true,
      fill: col.roles.dot-rest,
      border: col.roles.ctl-line,
      corner-radius: spc.radii.pill
    }

    dotStitch = frame : surf.stitch {
      left: spc.layout.stitch-in-ctl,
      top: spc.layout.stitch-in-ctl,
      right: spc.layout.stitch-in-ctl,
      bottom: spc.layout.stitch-in-ctl,
      width: .nil,
      height: .nil,
      ignore-stack: .true,
      corner-radius: spc.radii.pill,
      border[0].color: col.roles.dot-rest-stitch,
      border[0].dash: [3px, 2px],
      border[0].width: 1
    }

    glyph = asset {
      width: spc.controls.dot-icon,
      height: spc.controls.dot-icon,
      fill: col.roles.dot-rest-fg,
      contents: projectsIcon
    }
  }

  label = text : txt.label {
    contents: "Projects",
    fill[0].color: col.roles.fg-2
  }
}

// Hover: it lifts; the dot takes its hue (i10), the Label goes ink.
export navTabHover = frame : navTab {
  title: "Nav tab · hover",
  left: 186px,
  top: 40px,
  shadow[2].drop-shadow.blur-radius: 22px,
  shadow[2].drop-shadow.color: pal.palette.shadow-lift,
  shadow[2].drop-shadow.offset: [0px, 10px],
  shadow[2].drop-shadow.spread: -4px,

  label {
    fill[0].color: col.roles.fg
  }

  dot {
    glyph {
      fill[0].color: col.roles.dot-fg
    }

    dotStitch {
      border[0].color: col.roles.dot-stitch
    }

    dotRest {
      display: .none
    }
  }
}

// Here (`aria-current="page"`): the HERE rope on its edge (i9 red; i10 the
// page's section hue), the filled glyph, no stitch.
export navTabHere = frame : navTab {
  title: "Nav tab · here",
  left: 372px,
  top: 40px,
  overrides: [insert(tabRope, after = navTab.label)],

  label {
    fill[0].color: col.roles.fg
  }

  dot {
    glyph {
      fill[0].color: col.roles.dot-fg,
      contents: projectsIconFill
    }

    dotStitch {
      border[0].color: col.roles.dot-stitch
    }

    dotRest {
      display: .none
    }
  }

  tabStitch {
    display: .none
  }

  tabRope = frame : surf.ropeHere {
    left: 0px,
    top: 0px,
    right: 0px,
    bottom: 0px,
    width: .nil,
    height: .nil,
    ignore-stack: .true
  }
}

// Every section's tab, in each state (Home is the brand, not a tab).
musicTab = frame : navTab {
  title: "Music · rest",
  left: 0px,
  top: 222px,

  dot {
    fill[0].color: sec.section.hue-music,

    glyph {
      contents: musicIcon
    }
  }

  label {
    contents: "Music"
  }
}

musicTabHover = frame : navTabHover {
  title: "Music · hover",
  left: 186px,
  top: 222px,

  dot {
    fill[0].color: sec.section.hue-music,

