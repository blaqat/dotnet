@variants(navTabStatesI10)
navTabStates = frame : doc.docBoard {
  title: "Nav tab · states · i9",
  left: 0px,
  top: 610px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Nav tab · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-navTab, after = .nil),
      insert(st-navTabHover, after = st-navTab),
      insert(st-navTabHere, after = st-navTabHover)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-musicTab, after = .nil),
      insert(st-musicTabHover, after = st-musicTab),
      insert(st-musicTabHere, after = st-musicTabHover)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-thoughtsTab, after = .nil),
      insert(st-thoughtsTabHover, after = st-thoughtsTab),
      insert(st-thoughtsTabHere, after = st-thoughtsTabHover)
    ]
  }

  st-navTab = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "navTab"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "rest"
    }

    it = frame : navTab {}
  }

  st-navTabHover = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "navTabHover"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "hover"
    }

    it = frame : navTabHover {}
  }

  st-navTabHere = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "navTabHere"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "here: the current section"
    }

    it = frame : navTabHere {}
  }

  st-musicTab = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "musicTab"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Music · rest"
    }

    it = frame : musicTab {}
  }

  st-musicTabHover = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "musicTabHover"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Music · hover"
    }

    it = frame : musicTabHover {}
  }

  st-musicTabHere = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "musicTabHere"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Music · here"
    }

    it = frame : musicTabHere {}
  }

  st-thoughtsTab = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "thoughtsTab"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Thoughts · rest"
    }

    it = frame : thoughtsTab {}
  }

  st-thoughtsTabHover = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "thoughtsTabHover"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Thoughts · hover"
    }

    it = frame : thoughtsTabHover {}
  }

  st-thoughtsTabHere = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "thoughtsTabHere"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Thoughts · here"
    }

    it = frame : thoughtsTabHere {}
  }
}

@variants(navTabStatesI11)
@context(i10="on")
navTabStatesI10 = frame : navTabStates {
  title: "Nav tab · states · i10",
  left: 710px,
  top: 610px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }
}

@context(i10="on", i11="on")
navTabStatesI11 = frame : navTabStatesI10 {
  title: "Nav tab · states · i11",
  left: 1402px,
  top: 610px,

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
    }
  }
}
