import "tokens/color/roles.elyx" as col
import "tokens/space/space.elyx" as spc
import "tokens/type/type.elyx" as typ
import "components/atoms/text.elyx" as txt
import "assets/icons/bold/check.svg" as doneIcon
import "assets/icons/bold/hammer.svg" as wipIcon
import "assets/icons/bold/trash-simple.svg" as droppedIcon
import "assets/icons/bold/pause.svg" as pausedIcon
import "assets/icons/bold/user.svg" as personalIcon
import "assets/icons/bold/briefcase.svg" as workIcon
import "assets/icons/bold/graduation-cap.svg" as schoolIcon
import "assets/icons/bold/broadcast.svg" as liveIcon
import "assets/icons/bold/push-pin.svg" as editsIcon
import "assets/icons/bold/pencil-simple-line.svg" as draftIcon
import "assets/icons/bold/folder-simple.svg" as chipIcon
import "components/atoms/doc.elyx" as doc

// The kit's .yfact, the card meta's one face: a status glyph + Meta words
// ("✓ Completed Aug 2025 · 4 tracks"). i9: an 18px felt disc per status
// (Complete ink, Paused grey, Dropped red, WIP gold) + Nunito 750 words in
// fg-2; i10 L3: a bare 15px glyph in fg-3, Meta words in fg-3, and WIP
// keeps its small gold disc (col.roles.fact-*, spc.controls.fact*).
// Children: `disc` (holds `glyph`), `label`, `sub` (the quiet second part).
// Override `label {contents: …}`, `sub {contents: …}` or hide `sub`.
@variants(
  factWip,
  factDropped,
  factPaused,
  factMatch,
  factPersonal,
  factWork,
  factSchool,
  factLive,
  factEdits,
  factDraft,
  factChip
)
export fact = frame {
  title: "Fact · complete",
  left: 0px,
  top: 40px,
  height: spc.controls.tag,
  layout: {stack: {align-items: .center, item-gap: spc.layout.fact-gap}},
  corner-radius: spc.radii.pill,
  children: [disc, label, sub],

  disc = frame {
    width: spc.controls.fact,
    height: spc.controls.fact,
    layout: {stack: {justify-content: .center, align-items: .center}},
    fill: col.roles.fact-done,
    corner-radius: spc.radii.pill,
    children: glyph,

    glyph = asset {
      width: spc.controls.fact-glyph,
      height: spc.controls.fact-glyph,
      fill: col.roles.fact-ic,
      contents: doneIcon
    }
  }

  label = text : txt.metaCard {
    contents: "Completed Aug 2025",
    font-size: typ.sizes.fact,
    font-family: typ.faces.fact,
    font-style: typ.faces.fact-style,
    fill[0].color: col.roles.fact-fg
  }

  sub = text : txt.metaCard {
    contents: "· 4 tracks",
    font-size: typ.sizes.fact,
    font-family: typ.faces.fact,
    font-style: typ.faces.fact-style
  }
}

// WIP: the one status with a colour, a gold disc + an ink hammer, in
// every iteration.
export factWip = frame : fact {
  title: "Fact · WIP",
  left: 264px,
  top: 40px,

  disc {
    fill[0].color: col.roles.wip,

    glyph {
      fill[0].color: col.roles.fg,
      width: spc.controls.fact-wip-glyph,
      height: spc.controls.fact-wip-glyph,
      contents: wipIcon
    }

    width: spc.controls.fact-wip,
    height: spc.controls.fact-wip
  }

  label {
    contents: "WIP since Dec 2022"
  }
}

// Dropped: i9 the red felt disc + a white trash can; i10 the bare glyph.
export factDropped = frame : fact {
  title: "Fact · dropped",
  left: 748px,
  top: 40px,

  disc {
    fill[0].color: col.roles.fact-dropped,

    glyph {
      contents: droppedIcon
    }
  }

  sub {
    display: .none
  }

  label {
    contents: "Dropped, started Mar 2022"
  }
}

export factPaused = frame : fact {
  title: "Fact · paused",
  left: 521px,
  top: 40px,

  disc {
    fill[0].color: col.roles.fact-paused,

    glyph {
      contents: pausedIcon
    }
  }

  sub {
    display: .none
  }

  label {
    contents: "Paused, started Jun 2024"
  }
}

// Matched (.is-match): the in-card match chip grows out of the glyph;
// the words go full strength.
export factMatch = frame : fact {
  title: "Fact · match",
  left: 987px,
  top: 40px,
  padding-left: spc.layout.match-x,
  padding-right: spc.layout.match-x,
  fill[0].color: col.roles.chip,

  label {
    fill[0].color: col.roles.fg
  }

  sub {
    display: .none
  }
}

// ---- a project's type (Projects): i9 a felt disc in the type's colour
// with an ink glyph; i10 L3 a bare glyph in the type's deep shade
// (col.roles.fact-<type>). No second part.
export factPersonal = frame : fact {
  title: "Fact · personal",
  left: 0px,
  top: 204px,

  disc {
    fill[0].color: col.roles.fact-personal,

    glyph {
      fill[0].color: col.roles.fact-personal-ic,
      contents: personalIcon
    }
  }

  sub {
    display: .none
  }

  label {
    contents: "Personal"
  }
}

