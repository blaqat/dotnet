// ---- the publish state (Yarn.fact.pub; Studio's lists, cards and the
// editor's head): live = sewn on (i9 an ink disc), edits = pinned on (i9 a
// red disc), draft = basted (a dashed ring on white). From i10 (L1 + L3)
// bare glyphs: live in ink, edits in the WIP gold's deep shade, draft the
// dashed ring alone (col.roles.pub-*). No second part.
export factLive = frame : fact {
  title: "Fact · live",
  left: 0px,
  top: 368px,

  disc {
    fill[0].color: col.roles.fact-done,

    glyph {
      fill[0].color: col.roles.pub-live-ic,
      contents: liveIcon
    }
  }

  sub {
    display: .none
  }

  label {
    contents: "Live"
  }
}

export factEdits = frame : fact {
  title: "Fact · edits",
  left: 264px,
  top: 368px,

  disc {
    fill[0].color: col.roles.pub-edits,

    glyph {
      fill[0].color: col.roles.pub-edits-ic,
      contents: editsIcon
    }
  }

  sub {
    display: .none
  }

  label {
    contents: "Edits"
  }
}

export factDraft = frame : fact {
  title: "Fact · draft",
  left: 521px,
  top: 368px,

  disc {
    border[0].color: col.roles.fg-3,
    fill[0].color: col.roles.pub-draft,

    glyph {
      fill[0].color: col.roles.pub-draft-ic,
      contents: draftIcon
    }

    border[0].width: 1.5px,
    border[0].dash: [3px, 2px]
  }

  sub {
    display: .none
  }

  label {
    contents: "Draft"
  }
}

// A quiet fact (.yfact--text / --date): a chip disc with a hairline and a
// glyph in fg-2 (a type, a date, "Saved 4:44 pm"); i10 L3 the bare glyph in
// fg-3. Swap the glyph with `disc { glyph {contents: …} }`.
export factChip = frame : fact {
  title: "Fact · chip (a type, a date)",
  left: 748px,
  top: 204px,

  disc {
    border[0].color: col.roles.fact-chip-line,
    fill[0].color: col.roles.fact-chip,

    glyph {
      fill[0].color: col.roles.fact-chip-ic,
      contents: chipIcon
    }
  }

  sub {
    display: .none
  }

  label {
    contents: "Project"
  }
}

