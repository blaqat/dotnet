@variants(factStatesI10)
factStates = frame : doc.docBoard {
  title: "Fact · states · i9",
  left: 0px,
  top: 556px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Fact · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-fact, after = .nil),
      insert(st-factWip, after = st-fact),
      insert(st-factPaused, after = st-factWip),
      insert(st-factDropped, after = st-factPaused),
      insert(st-factMatch, after = st-factDropped)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-factPersonal, after = .nil),
      insert(st-factWork, after = st-factPersonal),
      insert(st-factSchool, after = st-factWork),
      insert(st-factChip, after = st-factSchool)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-factLive, after = .nil),
      insert(st-factEdits, after = st-factLive),
      insert(st-factDraft, after = st-factEdits)
    ]
  }

  st-fact = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "fact"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "status · complete"
    }

    it = frame : fact {}
  }

  st-factWip = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "factWip"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "status · WIP"
    }

    it = frame : factWip {}
  }

  st-factPaused = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "factPaused"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "status · paused"
    }

    it = frame : factPaused {}
  }

  st-factDropped = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "factDropped"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "status · dropped"
    }

    it = frame : factDropped {}
  }

  st-factMatch = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "factMatch"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "matched (in-card chip)"
    }

    it = frame : factMatch {}
  }

  st-factPersonal = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "factPersonal"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "type · personal"
    }

    it = frame : factPersonal {}
  }

  st-factWork = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "factWork"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "type · work"
    }

    it = frame : factWork {}
  }

  st-factSchool = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "factSchool"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "type · school"
    }

    it = frame : factSchool {}
  }

  st-factChip = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "factChip"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a quiet fact (date, text)"
    }

    it = frame : factChip {}
  }

  st-factLive = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "factLive"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "publish · live"
    }

    it = frame : factLive {}
  }

  st-factEdits = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "factEdits"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "publish · edits"
    }

    it = frame : factEdits {}
  }

  st-factDraft = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "factDraft"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "publish · draft"
    }

    it = frame : factDraft {}
  }
}

@variants(factStatesI11)
@context(i10="on")
factStatesI10 = frame : factStates {
  title: "Fact · states · i10",
  left: 1420px,
  top: 556px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }
}

@context(i10="on", i11="on")
factStatesI11 = frame : factStatesI10 {
  title: "Fact · states · i11",
  left: 2865px,
  top: 556px,

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
    }
  }
}
