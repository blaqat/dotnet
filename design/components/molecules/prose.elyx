@variants(proseStatesI10)
proseStates = frame : doc.docBoard {
  title: "Prose blocks · states · i9",
  left: 0px,
  top: 1614px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3),
      insert(row-5, after = row-4),
      insert(row-6, after = row-5)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Prose blocks · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-proseP, after = .nil),
      insert(st-prosePSm, after = st-proseP)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-proseH2, after = .nil),
      insert(st-proseH3, after = st-proseH2),
      insert(st-proseCodeInline, after = st-proseH3)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-proseQuote, after = .nil),
      insert(st-proseDivider, after = st-proseQuote)
    ]
  }

  row-4 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-proseItem, after = .nil),
      insert(st-proseItemSm, after = st-proseItem)
    ]
  }

  row-5 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-proseCode, after = .nil),
      insert(st-proseTable, after = st-proseCode)
    ]
  }

  row-6 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-proseFigure, after = .nil)]
  }

  st-proseP = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "proseP"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "reading size (.yprose)"
    }

    it = text : proseP {}
  }

  st-prosePSm = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "prosePSm"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "detail size (.ydetail__text)"
    }

    it = text : prosePSm {}
  }

  st-proseH2 = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "proseH2"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a section heading"
    }

    it = frame : proseH2 {}
  }

  st-proseH3 = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "proseH3"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a sub-heading"
    }

    it = text : proseH3 {}
  }

  st-proseCodeInline = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "proseCodeInline"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "inline code"
    }

    it = frame : proseCodeInline {}
  }

  st-proseQuote = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "proseQuote"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a quote"
    }

    it = frame : proseQuote {}
  }

  st-proseDivider = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "proseDivider"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a divider"
    }

    it = frame : proseDivider {}
  }

  st-proseItem = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "proseItem"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a list item"
    }

    it = frame : proseItem {}
