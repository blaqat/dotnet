// ---- interaction states (the kit's chips table: rest · hover · focus ·
// on · on + hover · disabled)
// Hover (mouse): lifts 1.5px with a soft shadow; the words go full ink.
export chipHover = frame : chip {
  title: "Chip · hover",
  left: 178px,
  top: 40px,
  shadow[0].drop-shadow.color: pal.palette.shadow-1,
  shadow[1].drop-shadow.blur-radius: 14px,
  shadow[1].drop-shadow.color: pal.palette.shadow-lift,
  shadow[1].drop-shadow.offset: [0px, 6px],
  shadow[1].drop-shadow.spread: -4px,

  label {
    fill[0].color: col.roles.fg
  }
}

// Focus (keys only): the dark thread ring 3px outside.
export chipFocus = frame : chip {
  title: "Chip · focus",
  left: 343px,
  top: 40px,
  overrides: [insert(chipFocusRing, after = chip.chipRing)],

  chipFocusRing = frame : surf.focusRing {
    left: spc.layout.focus-out,
    top: spc.layout.focus-out,
    right: spc.layout.focus-out,
    bottom: spc.layout.focus-out,
    width: .nil,
    height: .nil,
    ignore-stack: .true
  }
}

// On + hover: the strike says a click clears it.
export chipOnHover = frame : chipOn {
  title: "Chip · on + hover",
  left: 713px,
  top: 40px,

  label {
    strikethrough: .single
  }
}

// Disabled (the zero facet: the chip would find nothing): no fill, no
// shadow, the stitch (i9) at half strength, ink-3 words, the glyph at .55.
export chipDisabled = frame : chip {
  title: "Chip · disabled (zero)",
  left: 1129px,
  top: 40px,
  fill[0].visible: .false,
  shadow[0].drop-shadow.visible: .false,
  shadow[1].drop-shadow.visible: .false,

  label {
    fill[0].color: col.roles.fg-3
  }

  chipStitch {
    opacity: 0.5
  }

  glyph {
    opacity: 0.55
  }
}

