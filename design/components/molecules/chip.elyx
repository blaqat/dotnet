import "tokens/color/roles.elyx" as col
import "tokens/color/palette.elyx" as pal
import "tokens/space/space.elyx" as spc
import "tokens/type/type.elyx" as typ
import "components/atoms/text.elyx" as txt
import "components/atoms/surface.elyx" as surf
import "assets/icons/fill/check-circle.svg" as completeIcon
import "assets/icons/bold/hammer.svg" as wipIcon
import "assets/icons/bold/piano-keys.svg" as pianoIcon
import "assets/icons/bold/circle.svg" as beepboxIcon
import "assets/icons/bold/wave-sine.svg" as dawIcon
import "assets/icons/bold/user.svg" as personalIcon
import "assets/icons/bold/briefcase.svg" as workIcon
import "assets/icons/bold/graduation-cap.svg" as schoolIcon
import "components/atoms/doc.elyx" as doc

// The kit's .ychip: a 40px pill, a leading glyph (`glyph`), a Label
// (`label`) and an optional count (`count`, hidden unless shown).
// Rest: i9 white knit + a dashed stitch inside (`chipStitch`); i10 R9
// "calm": flat white with a 1px ring, no stitch (col.roles.ctl-*).
// States: …On = a toggle that's on (the on fill; from i10 the section's
// tint + a ring, `chipRing`) · …Picked = a single choice (the rope,
// `chipRope`) · …Sm = 32px.
// Content chips (instruments, project types) wear their own colour when
// on: i9 the solid colour, i10 its soft tint (col.roles.on-<content>).
// The on stitch and ring are the role's colour at an alpha: the alpha is
// the layer's opacity (opacity() and a border paint's opacity resolve
// statically / don't render). The ring is 0px wide in i9 (on-ring-w).
// Override `glyph {contents: …}`, `label {contents: …}`, `count {…}`.
@variants(
  chipOn,
  chipPicked,
  chipSm,
  chipCount,
  chipAll,
  chipPiano,
  chipBeepbox,
  chipDaw,
  chipPersonal,
  chipWork,
  chipSchool,
  chipHover,
  chipFocus,
  chipDisabled
)
export chip = frame {
  title: "Chip · rest",
  left: 0px,
  top: 40px,
  height: spc.controls.chip,
  layout: {stack: {align-items: .center, item-gap: spc.layout.chip-gap}},
  fill: col.roles.surface,
  border: {color: col.roles.ctl-line, position: .outside},
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: col.roles.ctl-shadow,
        offset: point(0px, 1px),
        blur-radius: 3px
      }
    }
  ],
  corner-radius: spc.radii.pill,
  padding-left: spc.layout.chip-x,
  padding-right: spc.layout.chip-x,
  children: [chipStitch, glyph, label, count, chipRing],

  chipStitch = frame : surf.stitch {
    left: spc.steps.s1,
    top: spc.steps.s1,
    right: spc.steps.s1,
    bottom: spc.steps.s1,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.pill,
    border[0].color: col.roles.ctl-stitch,
    border[0].width: spc.layout.stitch-w-sm
  }

  glyph = asset {
    width: spc.controls.icon-sm,
    height: spc.controls.icon-sm,
    fill: col.roles.fg,
    contents: completeIcon
  }

  label = text : txt.label {
    contents: "Complete",
    font-size: typ.sizes.chip,
    fill[0].color: col.roles.fg-2
  }

  count = text : txt.meta {
    display: .none,
    contents: "4"
  }

  chipRing = frame {
    left: 0px,
    top: 0px,
    right: 0px,
    bottom: 0px,
    display: .none,
    opacity: 0.3,
    ignore-stack: .true,
    border: {color: col.roles.on-fg, width: spc.layout.on-ring-w},
    corner-radius: spc.radii.pill
  }
}

// A toggle that's on (filter chips, search tokens): i9 the red fill
// (tog-red) with a quiet white stitch; i10 L1 the section's soft tint,
// its deep words, the stitch and a 1px ring in the deep shade at .3.
@variants(chipOnHover)
export chipOn = frame : chip {
  title: "Chip · on",
  left: 508px,
  top: 40px,
  border[0].visible: .false,
  fill[0].color: col.roles.on-bg,
  shadow[1].drop-shadow.visible: .false,

  chipStitch {
    border[0].color: col.roles.on-fg,
    opacity: 0.3
  }

  glyph {
    fill[0].color: col.roles.on-fg
  }

  label {
    fill[0].color: col.roles.on-fg
  }

  count {
    fill[0].color: col.roles.on-fg
  }

  chipRing {
    display: .visible
  }
}

// A single choice (a radio chip, a sort): the rope on the edge. The rope
// replaces the stitch; pick is red in i9, ink from i10.
export chipPicked = frame : chip {
  title: "Chip · picked",
  left: 918px,
  top: 40px,
  overrides: [insert(chipRope, after = chip.chipRing)],

  label {
    fill[0].color: col.roles.fg
  }

  chipStitch {
    display: .none
  }

  chipRope = frame : surf.rope {
    left: 0px,
    top: 0px,
    right: 0px,
    bottom: 0px,
    width: .nil,
    height: .nil,
    ignore-stack: .true
  }
}

// 32px (a suggestion in the search popover, tight rows).
export chipSm = frame : chip {
  title: "Chip · sm",
  left: 0px,
  top: 216px,
  height: spc.controls.chip-sm,
  padding-left: spc.layout.chip-sm-x,
  padding-right: spc.layout.chip-sm-x,

  label {
    font-size: typ.sizes.chip-sm
  }
}

// With a count (Browse's "rust · 4", a rail's rows).
export chipCount = frame : chip {
  title: "Chip · count",
  left: 178px,
  top: 216px,

  glyph {
    contents: wipIcon
  }

  label {
    contents: "WIP"
  }

  count {
    display: .visible
  }
}

// "All": a 40px circle, pressed = nothing filtered.
@variants(chipAllOn)
export chipAll = frame : chip {
  title: "Chip · All",
  left: 343px,
  top: 216px,
  width: spc.controls.chip,
  padding-left: 0px,
  padding-right: 0px,
  layout.stack.justify-content: .center,

  glyph {
    display: .none
  }

  label {
    contents: "All"
  }
}

export chipAllOn = frame : chipAll {
  title: "Chip · All on",
  left: 508px,
  top: 216px,
  border[0].visible: .false,
  fill[0].color: col.roles.on-bg,
  shadow[1].drop-shadow.visible: .false,

  chipStitch {
    border[0].color: col.roles.on-fg,
    opacity: 0.3
  }

  label {
    fill[0].color: col.roles.on-fg
  }

  chipRing {
    display: .visible
  }
}

// ---- instrument chips (Music): rest = a plain chip; on = the
// instrument's colour (i9 solid, white words, a white stitch at .4; i10
// its soft tint, ink words, the glyph + a ring in its deep shade)
@variants(chipPianoOn)
export chipPiano = frame : chip {
  title: "Chip · piano",
  left: 0px,
  top: 392px,

  glyph {
    contents: pianoIcon
  }

  label {
    contents: "Piano"
  }
}

export chipPianoOn = frame : chipPiano {
  title: "Chip · piano on",
  left: 0px,
  top: 568px,
  border[0].visible: .false,
  fill[0].color: col.roles.on-piano,
  shadow[1].drop-shadow.visible: .false,

  chipStitch {
    border[0].color: col.roles.ctl-stitch-fill,
    opacity: 0.4
  }

  glyph {
    fill[0].color: col.roles.on-piano-ic
  }

  label {
    fill[0].color: col.roles.on-inst-fg
  }

  chipRing {
    border[0].color: col.roles.on-piano-ic,
    display: .visible,
    opacity: 0.45
  }
}

