@variants(chipStatesI10)
chipStates = frame : doc.docBoard {
  title: "Chip · states · i9",
  left: 0px,
  top: 768px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Chip · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-chip, after = .nil),
      insert(st-chipHover, after = st-chip),
      insert(st-chipFocus, after = st-chipHover),
      insert(st-chipOn, after = st-chipFocus),
      insert(st-chipOnHover, after = st-chipOn),
      insert(st-chipPicked, after = st-chipOnHover),
      insert(st-chipDisabled, after = st-chipPicked)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-chipSm, after = .nil),
      insert(st-chipCount, after = st-chipSm),
      insert(st-chipAll, after = st-chipCount),
      insert(st-chipAllOn, after = st-chipAll)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-chipPiano, after = .nil),
      insert(st-chipBeepbox, after = st-chipPiano),
      insert(st-chipDaw, after = st-chipBeepbox),
      insert(st-chipPersonal, after = st-chipDaw),
      insert(st-chipWork, after = st-chipPersonal),
      insert(st-chipSchool, after = st-chipWork)
    ]
  }

  row-4 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-chipPianoOn, after = .nil),
      insert(st-chipBeepboxOn, after = st-chipPianoOn),
      insert(st-chipDawOn, after = st-chipBeepboxOn),
      insert(st-chipPersonalOn, after = st-chipDawOn),
      insert(st-chipWorkOn, after = st-chipPersonalOn),
      insert(st-chipSchoolOn, after = st-chipWorkOn)
    ]
  }

  st-chip = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "chip"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "rest"
    }

    it = frame : chip {}
  }

  st-chipHover = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "chipHover"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "hover: lifts"
    }

    it = frame : chipHover {}
  }

  st-chipFocus = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "chipFocus"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "focus (keys)"
    }

    it = frame : chipFocus {}
  }

  st-chipOn = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "chipOn"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "on: a toggle that's on"
    }

    it = frame : chipOn {}
  }

  st-chipOnHover = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "chipOnHover"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "on + hover: the strike"
    }

    it = frame : chipOnHover {}
  }

  st-chipPicked = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "chipPicked"
    }

    slot {
