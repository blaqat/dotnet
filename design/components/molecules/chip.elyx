@variants(chipStatesI11)
@context(i10="on")
chipStatesI10 = frame : chipStates {
  title: "Chip · states · i10",
  left: 1382px,
  top: 768px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }
}

