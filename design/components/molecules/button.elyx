@variants(btnStatesI10)
btnStates = frame : doc.docBoard {
  title: "Button · states · i9",
  left: 0px,
  top: 784px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Button · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-btn, after = .nil),
      insert(st-btnHover, after = st-btn),
      insert(st-btnFocus, after = st-btnHover),
      insert(st-btnDisabled, after = st-btnFocus)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-btnPrimary, after = .nil),
      insert(st-btnPrimaryHover, after = st-btnPrimary),
      insert(st-btnPrimaryFocus, after = st-btnPrimaryHover),
      insert(st-btnPrimaryDisabled, after = st-btnPrimaryFocus)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-btnLive, after = .nil),
      insert(st-btnGhost, after = st-btnLive),
      insert(st-btnGhostSm, after = st-btnGhost)
    ]
  }

  row-4 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-btnSm, after = .nil),
      insert(st-btnIcon, after = st-btnSm),
      insert(st-btnIconSm, after = st-btnIcon),
      insert(st-btnD, after = st-btnIconSm)
    ]
  }

  st-btn = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btn"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "rest (i10: calm, the ring)"
    }

    it = frame : btn {}
  }

  st-btnHover = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnHover"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "hover: lifts"
    }

    it = frame : btnHover {}
  }

  st-btnFocus = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnFocus"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "focus (keys): the ink ring"
    }

    it = frame : btnFocus {}
  }

  st-btnDisabled = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnDisabled"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "disabled: .5, flat"
    }

    it = frame : btnDisabled {}
  }

  st-btnPrimary = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnPrimary"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "primary (one per view)"
    }

    it = frame : btnPrimary {}
  }

  st-btnPrimaryHover = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnPrimaryHover"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "primary · hover"
    }

    it = frame : btnPrimaryHover {}
  }

  st-btnPrimaryFocus = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnPrimaryFocus"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "primary · focus"
    }

    it = frame : btnPrimaryFocus {}
  }

  st-btnPrimaryDisabled = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnPrimaryDisabled"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "primary · disabled"
    }

    it = frame : btnPrimaryDisabled {}
  }

  st-btnLive = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnLive"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "live: something playing"
    }

    it = frame : btnLive {}
  }

  st-btnGhost = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnGhost"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "ghost: no fill"
    }

    it = frame : btnGhost {}
  }

  st-btnGhostSm = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnGhostSm"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "ghost · sm (36)"
    }

    it = frame : btnGhostSm {}
  }

  st-btnSm = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnSm"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "sm (36)"
    }

    it = frame : btnSm {}
  }

  st-btnIcon = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnIcon"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "icon only (44)"
    }

    it = frame : btnIcon {}
  }

  st-btnIconSm = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnIconSm"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "icon only · sm (36)"
    }

    it = frame : btnIconSm {}
  }

  st-btnD = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "btnD"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "link button (.btn--d, 40)"
    }

    it = frame : btnD {}
  }
}

