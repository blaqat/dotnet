import "tokens/color/roles.elyx" as col
import "tokens/color/palette.elyx" as pal
import "tokens/space/space.elyx" as spc
import "components/atoms/text.elyx" as txt
import "components/atoms/surface.elyx" as surf
import "assets/icons/bold/shuffle.svg" as shuffleIcon
import "assets/icons/bold/arrow-up-right.svg" as visitIcon
import "assets/icons/bold/music-notes.svg" as liveIcon
import "assets/icons/bold/arrow-counter-clockwise.svg" as resetIcon
import "assets/icons/bold/github-logo.svg" as githubIcon
import "components/atoms/doc.elyx" as doc

// The kit's .btn: a pill with an optional leading glyph (`glyph`) and a
// Label (`label`). Rest = the control at rest: i9 white knit with a dashed
// stitch inside (`btnStitch`); i10 "calm" = flat white with a 1px ring
// (the act look), no stitch. Both come from col.roles.ctl-* tokens.
// Override `glyph {contents: …}` and `label {contents: …}`; hide the glyph
// with `glyph {display: .none}` (`icon` is a reserved word).
@variants(
  btnPrimary,
  btnLive,
  btnGhost,
  btnSm,
  btnIcon,
  btnD,
  btnHover,
  btnFocus,
  btnDisabled
)
export btn = frame {
  title: "Button · rest",
  left: 0px,
  top: 40px,
  height: spc.controls.btn,
  layout: {
    stack: {
      justify-content: .center,
      align-items: .center,
      item-gap: spc.layout.btn-gap
    }
  },
  fill: col.roles.surface,
  border: {color: col.roles.ctl-line, position: .outside},
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: col.roles.ctl-shadow,
        offset: point(0px, 2px),
        blur-radius: 6px
      }
    }
  ],
  corner-radius: spc.radii.pill,
  padding-left: spc.layout.btn-x,
  padding-right: spc.layout.btn-x,
  children: [btnStitch, glyph, label],

  btnStitch = frame : surf.stitch {
    left: spc.layout.stitch-in-ctl,
    top: spc.layout.stitch-in-ctl,
    right: spc.layout.stitch-in-ctl,
    bottom: spc.layout.stitch-in-ctl,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.pill,
    border[0].color: col.roles.ctl-stitch
  }

  glyph = asset {
    width: spc.controls.btn-icon,
    height: spc.controls.btn-icon,
    fill: col.roles.fg,
    contents: shuffleIcon
  }

  label = text : txt.label {
    contents: "Shuffle all"
  }
}

// The ONE primary per view: red in i9, ink from i10.
@variants(btnPrimaryHover, btnPrimaryFocus, btnPrimaryDisabled)
export btnPrimary = frame : btn {
  title: "Button · primary",
  left: 0px,
  top: 220px,
  border[0].visible: .false,
  fill[0].color: col.roles.primary-bg,
  shadow[1].drop-shadow.color: pal.palette.shadow-1,

  label {
    fill[0].color: col.roles.primary-fg,
    contents: "Visit site"
  }

  glyph {
    fill[0].color: col.roles.primary-fg,
    contents: visitIcon
  }

  btnStitch {
    border[0].color: col.roles.ctl-stitch-fill
  }
}

// Something live (playing): the live fill.
export btnLive = frame : btn {
  title: "Button · live",
  left: 0px,
  top: 400px,
  border[0].visible: .false,
  fill[0].color: col.roles.live,
  shadow[1].drop-shadow.color: pal.palette.shadow-1,

  label {
    fill[0].color: col.roles.live-fg,
    contents: "Now playing"
  }

  glyph {
    fill[0].color: col.roles.live-fg,
    contents: liveIcon
  }

  btnStitch {
    border[0].color: col.roles.ctl-stitch-fill
  }
}

// Ghost: no fill, no shadow; the stitch (i9) or the ring (i10) only.
@variants(btnGhostSm)
export btnGhost = frame : btn {
  title: "Button · ghost",
  left: 231px,
  top: 400px,
  border[0].position: .inside,
  fill[0]: .nil,
  shadow[0]: .nil,
  shadow[1]: .nil,

  glyph {
    display: .none
  }

  label {
    contents: "Cancel"
  }
}

// Small (36): dense rows, toolbars.
export btnSm = frame : btn {
  title: "Button · sm",
  left: 0px,
  top: 580px,
  height: spc.controls.btn-sm,
  padding-left: spc.layout.btn-sm-x,
  padding-right: spc.layout.btn-sm-x,

  @with-variant(txt.labelCard)
  label {
    left: .nil,
    contents: "Clear filters"
  }

  glyph {
    width: spc.controls.icon-sm,
    height: spc.controls.icon-sm,
    contents: resetIcon
  }
}

// Icon-only: a 44 circle; the name stays in aria-label.
@variants(btnIconSm)
export btnIcon = frame : btn {
  title: "Button · icon",
  left: 231px,
  top: 580px,
  width: spc.controls.btn,
  padding-left: 0px,
  padding-right: 0px,

  label {
    display: .none
  }
}

// The link button (kit .btn--d, Yarn.dlink): glyph + site name, 40 tall.
export btnD = frame : btn {
  title: "Button · link (d)",
  left: 653px,
  top: 580px,
  height: spc.controls.btn-d,
  padding-left: spc.layout.btn-d-l,
  padding-right: spc.layout.btn-d-r,
  layout.stack.item-gap: spc.layout.btn-d-gap,

  @with-variant(txt.labelCard)
  label {
    left: .nil,
    contents: "GitHub"
  }

  glyph {
    width: spc.controls.btn-d-icon,
    height: spc.controls.btn-d-icon,
    contents: githubIcon
  }
}

// Ghost, small (.btn--ghost.btn--sm, 36): quiet actions beside a field or
// in a toolbar (Replace, Remove track, Import from Notion, View site).
export btnGhostSm = frame : btnGhost {
  title: "Button · ghost sm",
  left: 422px,
  top: 400px,
  height: spc.controls.btn-sm,
  padding-left: spc.layout.btn-sm-x,
  padding-right: spc.layout.btn-sm-x,

  @with-variant(txt.labelCard)
  label {
    left: .nil,
    contents: "Replace"
  }

  glyph {
    width: spc.controls.icon-sm,
    height: spc.controls.icon-sm,
    contents: resetIcon,
    display: .visible
  }
}

// Icon-only, small (.btn--icon.btn--sm): a 36 circle (a card's +).
export btnIconSm = frame : btnIcon {
  title: "Button · icon sm",
  left: 422px,
  top: 580px,
  width: spc.controls.btn-sm,
  height: spc.controls.btn-sm,

  glyph {
    width: spc.controls.icon-sm,
    height: spc.controls.icon-sm
  }
}

// ---- interaction states (the kit's buttons table: rest · hover · focus ·
// disabled). Pressed is a .97 dip, the same face.
// Hover (mouse): lifts with the lift shadow (.btn:hover).
export btnHover = frame : btn {
  title: "Button · hover",
  left: 231px,
  top: 40px,
  shadow[0].drop-shadow.offset: [0px, 2px],
  shadow[1].drop-shadow.blur-radius: 22px,
  shadow[1].drop-shadow.color: pal.palette.shadow-lift,
  shadow[1].drop-shadow.offset: [0px, 10px],
  shadow[1].drop-shadow.spread: -4px
}

// Focus (keys only): the dark thread ring 3px outside.
export btnFocus = frame : btn {
  title: "Button · focus",
  left: 422px,
  top: 40px,
  overrides: [insert(btnRing, after = btn.label)],

  btnRing = frame : surf.focusRing {
    left: spc.layout.focus-out,
    top: spc.layout.focus-out,
    right: spc.layout.focus-out,
    bottom: spc.layout.focus-out,
    width: .nil,
    height: .nil,
    ignore-stack: .true
  }
}

// Disabled: flat and quiet but readable (.5, no shadow).
export btnDisabled = frame : btn {
  title: "Button · disabled",
  left: 653px,
  top: 40px,
  opacity: 0.5,
  shadow[0].drop-shadow.visible: .false,
  shadow[1].drop-shadow.visible: .false
}

export btnPrimaryHover = frame : btnPrimary {
  title: "Button · primary hover",
  left: 231px,
  top: 220px,
  shadow[0].drop-shadow.offset: [0px, 2px],
  shadow[1].drop-shadow.blur-radius: 22px,
  shadow[1].drop-shadow.color: pal.palette.shadow-lift,
  shadow[1].drop-shadow.offset: [0px, 10px],
  shadow[1].drop-shadow.spread: -4px
}

export btnPrimaryFocus = frame : btnPrimary {
  title: "Button · primary focus",
  left: 422px,
  top: 220px,
  overrides: [insert(btnRing, after = btn.label)],

  btnRing = frame : surf.focusRing {
    left: spc.layout.focus-out,
    top: spc.layout.focus-out,
    right: spc.layout.focus-out,
    bottom: spc.layout.focus-out,
    width: .nil,
    height: .nil,
    ignore-stack: .true
  }
}

export btnPrimaryDisabled = frame : btnPrimary {
  title: "Button · primary disabled",
  left: 653px,
  top: 220px,
  opacity: 0.5,
  shadow[0].drop-shadow.visible: .false,
  shadow[1].drop-shadow.visible: .false
}

