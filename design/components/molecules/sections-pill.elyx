import "tokens/color/roles.elyx" as col
import "tokens/color/palette.elyx" as pal
import "tokens/color/sections.elyx" as sec
import "tokens/space/space.elyx" as spc
import "components/atoms/text.elyx" as txt
import "components/atoms/doc.elyx" as doc
import "components/atoms/surface.elyx" as surf
import "components/molecules/nav-tab.elyx" as tab
import "assets/icons/fill/folder-simple.svg" as projectsIcon
import "assets/icons/fill/music-notes.svg" as musicIcon
import "assets/icons/fill/cloud.svg" as thoughtsIcon
import "assets/icons/fill/house.svg" as homeIcon
import "assets/icons/bold/caret-up.svg" as caretIcon
import "assets/icons/bold/caret-down.svg" as caretDownIcon
import "assets/icons/fill/squares-four.svg" as studioIcon

// The sections pill (`.yspool__btn`): the phones' nav, closed. A 52px white
// pill at the sheet's bottom-left: the page's felt dot (34, the section's
// hue: Home red), its name (Label) and a caret (it unspools upward into
// the four sections). It keeps its thin stitch in every iteration.
// Children: `pillStitch`, `dot` (its `glyph`), `label`, `caret`.
// Variants: one per section (`section=…`: a top-level instance picks it
// from the canvas; inside a component pick it with `@with-variant`), Open
// (the caret turns down while the menu is out: organisms/phone-nav.elyx)
// and Up (.846: it waits on the up line while the player's bar holds the
// slot). Set the section on Open / Up with `dot { fill[0].color: …
// glyph {contents: …} }` and `label {contents: …}`.
@variants(
  sectionsPillProjects,
  sectionsPillMusic,
  sectionsPillThoughts,
  sectionsPillStudio,
  sectionsPillOpen,
  sectionsPillUp
)
export sectionsPill = frame {
  title: "Sections pill · Home (closed)",
  left: 0px,
  top: 40px,
  height: spc.controls.spool,
  layout: {stack: {align-items: .center, item-gap: spc.layout.spool-gap}},
  fill: col.roles.surface,
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: pal.palette.shadow-pop,
        offset: point(0px, 6px),
        blur-radius: 16px,
        spread: -5px
      }
    }
  ],
  corner-radius: spc.radii.pill,
  padding: [0px, spc.layout.spool-r, 0px, spc.layout.spool-l],
  children: [pillStitch, dot, label, caret],

  pillStitch = frame : surf.stitch {
    left: spc.layout.stitch-in,
    top: spc.layout.stitch-in,
    right: spc.layout.stitch-in,
    bottom: spc.layout.stitch-in,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.pill,
    border[0].width: 1
  }

  dot = frame : tab.navTab.dot {
    width: spc.controls.spool-dot,
    height: spc.controls.spool-dot,
    fill[0].color: sec.section.sec,

    dotStitch {
      border[0].color: col.roles.dot-stitch
    }

    glyph {
      fill[0].color: col.roles.dot-fg,
      width: spc.controls.spool-icon,
      height: spc.controls.spool-icon,
      contents: homeIcon
    }

    dotRest {
      display: .none
    }
  }

  label = text : txt.label {
    contents: "Home"
  }

  caret = asset {
    width: spc.controls.spool-caret,
    height: spc.controls.spool-caret,
    fill: col.roles.fg-3,
    contents: caretIcon
  }
}

// ---- one per section (the page's felt dot, its filled glyph, its name) ----
@context(section="projects")
export sectionsPillProjects = frame : sectionsPill {
  title: "Sections pill · Projects",
  left: 0px,
  top: 212px,

  dot {
    fill[0].color: sec.section.hue-projects,

    glyph {
      contents: projectsIcon
    }
  }

  label {
    contents: "Projects"
  }
}

@context(section="music")
export sectionsPillMusic = frame : sectionsPill {
  title: "Sections pill · Music",
  left: 204px,
  top: 212px,

  dot {
    fill[0].color: sec.section.hue-music,

    glyph {
      contents: musicIcon
    }
  }

  label {
    contents: "Music"
  }
}

