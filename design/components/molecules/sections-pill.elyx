// Studio: its own page list (Studio · Projects · Music · Thoughts · Media);
// the ink dot with the dashboard's grid.
@context(section="studio")
export sectionsPillStudio = frame : sectionsPill {
  title: "Sections pill · Studio",
  left: 606px,
  top: 212px,

  dot {
    fill[0].color: sec.section.hue-studio,

