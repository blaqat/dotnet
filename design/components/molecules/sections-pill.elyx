// ---- states ----
// Open: the caret turns down while the sections menu is out above it.
export sectionsPillOpen = frame : sectionsPill {
  title: "Sections pill · open",
  left: 204px,
  top: 40px,

  caret {
    contents: caretDownIcon
  }
}

// Up: while the player's bar holds the slot the pill waits on the up line,
// .846 of its size (44 tall: the menu's rows keep their 48).
export sectionsPillUp = frame : sectionsPill {
  title: "Sections pill · up (the player has the slot)",
  left: 392px,
  top: 40px,
  height: spc.controls.spool-up,
  padding-left: spc.layout.spool-up-l,
  padding-right: spc.layout.spool-up-r,
  layout.stack.item-gap: spc.layout.spool-up-gap,

  caret {
    width: spc.controls.spool-up-caret,
    height: spc.controls.spool-up-caret
  }

  @with-variant(txt.labelCard)
  label {}

  dot {
    width: spc.controls.spool-up-dot,

    glyph {
      width: spc.controls.spool-up-icon,
      height: spc.controls.spool-up-icon
    }

    height: spc.controls.spool-up-dot
  }
}

// ==== states page (labels over the definitions, then the states boards: i9 · i10 · i11) ====
lbl-sectionsPill = text : doc.specLabel {
  left: 0px,
  top: 0px,
  contents: "sectionsPill"
}

note-sectionsPill = text : doc.specNote {
  left: 0px,
  top: 16px,
  contents: "Home · closed"
}

lbl-sectionsPillOpen = text : doc.specLabel {
  left: 204px,
  top: 0px,
  contents: "sectionsPillOpen"
}

note-sectionsPillOpen = text : doc.specNote {
  left: 204px,
  top: 16px,
  contents: "the menu out"
}

lbl-sectionsPillUp = text : doc.specLabel {
  left: 392px,
  top: 0px,
  contents: "sectionsPillUp"
}

note-sectionsPillUp = text : doc.specNote {
  left: 392px,
  top: 16px,
  contents: "the player in the slot"
}

lbl-sectionsPillProjects = text : doc.specLabel {
  left: 0px,
  top: 172px,
  contents: "sectionsPillProjects"
}

note-sectionsPillProjects = text : doc.specNote {
  left: 0px,
  top: 188px,
  contents: "section = projects"
}

lbl-sectionsPillMusic = text : doc.specLabel {
  left: 204px,
  top: 172px,
  contents: "sectionsPillMusic"
}

note-sectionsPillMusic = text : doc.specNote {
  left: 204px,
  top: 188px,
  contents: "section = music"
}

lbl-sectionsPillThoughts = text : doc.specLabel {
  left: 392px,
  top: 172px,
  contents: "sectionsPillThoughts"
}

note-sectionsPillThoughts = text : doc.specNote {
  left: 392px,
  top: 188px,
  contents: "section = thoughts"
}

lbl-sectionsPillStudio = text : doc.specLabel {
  left: 606px,
  top: 172px,
  contents: "sectionsPillStudio"
}

note-sectionsPillStudio = text : doc.specNote {
  left: 606px,
  top: 188px,
  contents: "section = studio"
}

@variants(
  sectionsPillStatesI10,
  sectionsPillStatesProjects,
  sectionsPillStatesMusic,
  sectionsPillStatesThoughts,
  sectionsPillStatesStudio
)
sectionsPillStates = frame : doc.docBoard {
  title: "Sections pill · states · i9",
  left: 0px,
  top: 408px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [insert(row-1, after = .nil)]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Sections pill · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-sectionsPill, after = .nil),
      insert(st-sectionsPillOpen, after = st-sectionsPill),
      insert(st-sectionsPillUp, after = st-sectionsPillOpen)
    ]
  }

  st-sectionsPill = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "sectionsPill"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Home · closed"
    }

    it = frame : sectionsPill {}
  }

  st-sectionsPillOpen = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "sectionsPillOpen"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the menu out"
    }

    it = frame : sectionsPillOpen {}
  }

  st-sectionsPillUp = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "sectionsPillUp"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the player in the slot"
    }

    it = frame : sectionsPillUp {}
  }
}

