}

// Home & About: its first line, the keyword scribbled.
export fanWords = frame : fan {
  title: "Fan · Home (its line)",
  left: 3834px,
  top: 220px,
  padding-left: 0px,

  p1 {
    display: .none
  }

  p2 {
    display: .none
  }

  p3 {
    display: .none
  }

  p4 {
    display: .none
  }

  words {
    display: .visible
  }
}

// ---- a section card (.st-seccard): a kit card (the patch) holding the
// section's dot + its name and a + (a new item), the fan, the publish
// counts (live · with edits · drafts) and "Last touched …".
// Children: `top` (`lead` (`dot`, `name`), `add`), `fan`, `counts`
// (`live`, `edits`, `drafts`), `last`. A section is a variant.
@variants(secCardMusic, secCardThoughts, secCardHome)
export secCard = frame : surf.patch {
  title: "Section card · Projects",
  left: 0px,
  top: 394px,
  width: spc.controls.st-tile-w,
  min-height: spc.controls.st-tile-h,
  padding-top: spc.layout.st-tile-x,
  padding-left: spc.layout.st-tile-x,
  padding-bottom: spc.layout.st-tile-b,
  padding-right: spc.layout.st-tile-x,
  overrides: [
    insert(top, after = surf.patch.patchStitch),
    insert(fanRow, after = top),
    insert(counts, after = fanRow),
    insert(last, after = counts)
  ],

  top = frame {
    width: 100%,
    layout: {stack: {justify-content: .space-between, align-items: .center}},
    children: [lead, add],

    lead = frame {
      layout: {stack: {align-items: .center, item-gap: spc.steps.s3}},
      children: [dot, name],

      dot = frame : prt.secDot {}

      name = text : txt.title {
        contents: "Projects",
        font-size: typ.sizes.st-tile,
        font-style: typ.faces.st-tile-style
      }
    }

    add = frame : btn.btnIconSm {
      glyph {
        contents: plusIcon
      }
    }
  }

  fanRow = frame : fan {}

  counts = frame {
    height: spc.controls.st-fact,
    layout: {stack: {align-items: .center, item-gap: spc.layout.facts-gap}},
    children: [live, edits, drafts],

    live = frame : fct.factLive {
      label {
        contents: "11 live"
      }
    }

    edits = frame : fct.factEdits {
      label {
        contents: "1 with edits"
      }
    }

    drafts = frame : fct.factDraft {
      label {
        contents: "1 draft"
      }
    }
  }

  // "Last touched <thing> <stamp>": the thing in the strong words, the time
  // in Meta
  last = text : txt.body {
    width: 100%,
    contents: "Last touched Studio 4 min ago",
    font-size: typ.sizes.st-note,
    line-height: typ.leading.st-quiet,
    fill[0].color: col.roles.fg-2,
    subrange[0].fill[0].color: col.roles.fg,
    subrange[0].font-style: typ.faces.st-strong-style,
    subrange[0].range: [13, 19],
    subrange[1].fill[0].color: col.roles.fg-3,
    subrange[1].font-family: typ.faces.meta,
    subrange[1].font-size: typ.sizes.meta,
    subrange[1].font-style: typ.faces.meta-style,
    subrange[1].range: [20, 29]
  }
}

export secCardMusic = frame : secCard {
  title: "Section card · Music",
  left: 1596px,
  top: 394px,

  last {
    subrange[1].range: [26, 36],
