@variants(studioDashboardStatesI10)
studioDashboardStates = frame : doc.docBoard {
  title: "Studio · dashboard parts · states · i9",
  left: 0px,
  top: 929px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3),
      insert(row-5, after = row-4),
      insert(row-6, after = row-5),
      insert(row-7, after = row-6)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Studio · dashboard parts · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-siteStrip, after = .nil)]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-print, after = .nil),
      insert(st-printSwatch, after = st-print),
      insert(st-printIcon, after = st-printSwatch)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-fan, after = .nil),
      insert(st-fanSwatches, after = st-fan),
      insert(st-fanIcons, after = st-fanSwatches),
      insert(st-fanWords, after = st-fanIcons)
    ]
