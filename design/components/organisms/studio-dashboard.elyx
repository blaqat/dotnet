// Studio's dashboard (studio-screens.js "dashboard"): the site strip, the
// four section cards, the drafts ("On the needles") and Recently.
// i9 → i10 is tokens (the facts go bare, the strip's dot goes ink, the
// type roles); i11 is tokens too (insets 16 all round, the card context's
// 16 / 14 / 12) except the panes' heads (prt.eyebrowHeading, in the block).
// ---- the site strip (.st-strip): is the site live, the last publish,
// the storage meter, the unused files. A white patch, its stitch 6 in.
// Children: `stripStitch`, `info` (`live` (`liveDot`, `liveWords`),
// `last`, `store` (`storeWords`, `meter` (`meterFill`))), `orphans`.
export siteStrip = frame {
  title: "Site strip",
  left: 0px,
  top: 40px,
  width: 1332px,
  layout: {stack: {justify-content: .space-between, align-items: .center}},
  fill: col.roles.surface,
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 2px),
        blur-radius: 6px
      }
    }
  ],
  corner-radius: spc.radii.st-strip,
  padding: [spc.layout.st-strip-y, spc.layout.st-strip-x],
  children: [stripStitch, info, orphans],

  stripStitch = frame : surf.stitch {
    left: spc.layout.stitch-in,
    top: spc.layout.stitch-in,
    right: spc.layout.stitch-in,
    bottom: spc.layout.stitch-in,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.steps.s3
  }

  info = frame {
    layout: {stack: {align-items: .center, item-gap: spc.layout.st-strip-gap}},
    children: [live, last, store],

    live = frame {
      layout: {stack: {align-items: .center, item-gap: spc.steps.s2}},
      children: [liveDot, liveWords],

      // "now" that isn't music: i9 red, from i10 Studio's ink; a soft ring
      liveDot = frame {
        width: spc.controls.st-live-dot,
        height: spc.controls.st-live-dot,
        fill: col.roles.now,
        shadow: {
          drop-shadow: {
            color: col.roles.now-soft,
            offset: point(0px, 0px),
            blur-radius: 0px,
            spread: spc.layout.stitch-in-ctl
          }
        },
        corner-radius: spc.radii.pill
      }

      liveWords = text : txt.label {
        contents: "blaqat.net is live"
      }
    }

    last = text : txt.meta {
      contents: "last publish 5 h ago · no redeploys needed"
    }

    store = frame {
      layout: {stack: {align-items: .center, item-gap: spc.layout.st-list-gap}},
      children: [storeWords, meter],

      storeWords = text : txt.meta {
        contents: "media 270.7 MB of 10 GB"
      }

      // the storage meter: a recessed track, a dashed line along it, the
      // used part in the now colour (270.7 MB of 10 GB: 3%)
      meter = frame {
        width: spc.controls.st-meter-w,
        height: spc.controls.st-meter-h,
        fill: col.roles.recess,
        shadow: {
          inner-shadow: {
            color: pal.palette.stitch,
            offset: point(0px, 1px),
            blur-radius: 2px
          }
        },
        corner-radius: spc.radii.pill,
        overflow: .clip,
        children: [meterLine, meterFill],

        meterLine = frame {
          left: spc.layout.stitch-in,
          top: spc.steps.s1,
          right: spc.layout.stitch-in,
          height: 2px,
          border: {
            color: col.roles.stitch,
            width: spc.layout.stitch-w-sm,
            dash: [5px, 4px],
            sides: .top
          }
        }

        meterFill = frame {
          left: 0px,
          top: 0px,
          bottom: 0px,
          width: 3%,
          fill: col.roles.now,
          corner-radius: spc.radii.pill
        }
      }
    }
  }

  orphans = frame : btn.btnSm {
    glyph {
      contents: scissorsIcon
    }

    label {
      contents: "3 unused files"
    }
  }
}

// ---- a section card's fan: the section's latest things, fanned (each
// leans −4° / +3° in turn, overlapping 8): a project's media (`print`,
// 68 × 46), a release's swatch (`printSwatch`, 46), a post type's glyph
// on a white disc (`printIcon`, 42). Each wears a white ring and a soft
// shadow. The print is a holder (a stack ignores transforms) with the
// leaning `card` in it (`pic`, the picture; `glyph`).
@variants(printSwatch, printIcon)
export print = frame {
  title: "Fan print · a project's media",
  left: 0px,
  top: 220px,
  width: spc.controls.st-print-w,
  height: spc.controls.st-print-h,
  children: card,

  card = frame {
    left: 0px,
    top: 0px,
    right: 0px,
    bottom: 0px,
    transform: [0.9976, 0.0698, -1.52, -0.0698, 0.9976, 2.43],
    layout: {stack: {justify-content: .center, align-items: .center}},
    fill: col.roles.recess,
    border: {
      color: col.roles.surface,
      width: spc.layout.ring-w,
      position: .outside
    },
    shadow: {
      drop-shadow: {
        color: pal.palette.shadow-lift,
        offset: point(0px, 2px),
        blur-radius: 6px
      }
    },
    corner-radius: spc.radii.inner,
    overflow: .clip,
    children: [pic, glyph],

    pic = frame {
      left: 0px,
      top: 0px,
      right: 0px,
      bottom: 0px,
      ignore-stack: .true,
      fill: {image: {ref: sitePlanImg}}
    }

    glyph = asset {
      width: spc.controls.icon,
      height: spc.controls.icon,
      display: .none,
      fill: col.roles.fg,
      contents: scratchIcon
    }
  }
}

// A release's swatch (46, the art radius).
export printSwatch = frame : print {
  title: "Fan print · a swatch",
  left: 1596px,
  top: 220px,
  width: spc.controls.st-fan-sw,
  height: spc.controls.st-fan-sw,

  card {
    pic {
      fill[0].image.ref: fanCouch
    }

    transform: [0.9976, 0.0698, -1.55, -0.0698, 0.9976, 1.66],
    corner-radius: spc.radii.art
  }
}

// A post type's glyph on a white disc (42).
export printIcon = frame : print {
  title: "Fan print · a post type",
  left: 2164px,
  top: 220px,
  width: spc.controls.st-fan-ic,
  height: spc.controls.st-fan-ic,

  card {
    fill[0].color: col.roles.surface,

    pic {
      display: .none
    }

    transform: [0.9976, 0.0698, -1.41, -0.0698, 0.9976, 1.52],
    corner-radius: spc.radii.pill,

    glyph {
      display: .visible
    }
  }
}

// The fan: Projects' prints (base), Music's swatches, Thoughts' post types,
// Home's line (its keyword scribbled). Children: `p1` … `p6`, `words`.
@variants(fanSwatches, fanIcons, fanWords)
export fan = frame {
  title: "Fan · Projects (media)",
  left: 2732px,
  top: 220px,
  height: spc.controls.st-fan-h,
  layout: {stack: {align-items: .center, item-gap: spc.layout.st-fan-overlap}},
  padding-left: spc.layout.st-fan-l,
  children: [p1, p2, p3, p4, p5, p6, words],

  p1 = frame : print {}

  p2 = frame : print {
    card {
      pic {
        fill[0].image.ref: sonaImg
      }

      transform: [0.9986, -0.05, 1.25, 0.05, 0.9986, -1.75]
    }
  }

  p3 = frame : print {}

  p4 = frame : print {
    card {
      pic {
        fill[0].image.ref: portalImg
      }

      transform: [0.9986, -0.05, 1.25, 0.05, 0.9986, -1.75]
    }
  }

  p5 = frame : print {
    display: .none
  }

  p6 = frame : print {
    display: .none
  }

  // Home's line: Title words in fg-2, the keyword scribbled
  words = frame {
    display: .none,
    layout: {stack: {align-items: .center}},
    padding: [spc.steps.s1, 0px, spc.layout.fact-gap],
    children: [wordsA, wordsKey, wordsB],

    wordsA = text : txt.label {
      contents: "hi, i’m aiden! a ",
      font-size: typ.sizes.st-words,
      fill[0].color: col.roles.fg-2
    }

    wordsKey = frame : kw.keyword {
      word {
        fill[0].color: col.roles.fg-2,
        font-size: typ.sizes.st-words,
        font-family: typ.faces.label,
        font-style: typ.faces.label-style,
        line-height: typ.leading.label
      }
    }

    wordsB = text : txt.label {
      contents: "…",
      font-size: typ.sizes.st-words,
      fill[0].color: col.roles.fg-2
    }
  }
}

