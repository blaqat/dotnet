    card {
      pic {
        fill[0].image.ref: fanFarewell
      }

      transform: [0.9986, -0.05, 1.24, 0.05, 0.9986, -1.17]
    }
  }

  @with-variant(printSwatch)
  p3 {
    card {
      pic {
        fill[0].image.ref: fanPiano
      }
    }
  }

  @with-variant(printSwatch)
  p2 {
    card {
      pic {
        fill[0].image.ref: fanStars
      }

      transform: [0.9986, -0.05, 1.24, 0.05, 0.9986, -1.17]
    }
  }

  @with-variant(printSwatch)
  p1 {}
}

// Thoughts' six post types (scratch, article, tags, playlist, images,
