        contents: "Thoughts"
      }
    }
  }
}

// Home & About: no +, its line instead of a fan, live.
export secCardHome = frame : secCard {
  title: "Section card · Home & About",
  left: 2732px,
  top: 394px,

  last {
    subrange[1].range: [26, 31],
    subrange[0].range: [13, 25],
    contents: "Last touched Home & About Nov 1"
  }

  counts {
    drafts {
      display: .none
    }

    edits {
      display: .none
    }

    live {
      label {
        contents: "Live"
      }
    }
  }

  @with-variant(fanWords)
  fanRow {}

  top {
    lead {
      dot {
        fill[0].color: sec.section.hue-home,

        glyph {
          contents: homeIcon
        }
      }

      name {
        contents: "Home & About"
      }
    }

    add {
      display: .none
    }
  }
}

// ---- a list row (.st-drow, the kit row): the section's dot, the title
// over its facts (publish state · type · stamp), the › at the end.
// Children: `rowStitch`, `lead` (`dot`, `main` (`name`, `sub` (`state`,
// `kind`, `stamp`))), `go`.
export draftRow = frame {
  title: "List row · a draft",
  left: 0px,
  top: 719px,
  width: 958px,
  min-height: spc.controls.st-row-h,
  layout: {stack: {justify-content: .space-between, align-items: .center}},
  fill: col.roles.surface,
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 2px),
        blur-radius: 6px
      }
    }
  ],
  corner-radius: spc.radii.row,
  padding: [
    spc.layout.st-row-y,
    spc.layout.st-row-r,
    spc.layout.st-row-y,
    spc.layout.st-row-l
  ],
  children: [rowStitch, lead, go],

  rowStitch = frame : surf.stitch {
    left: spc.layout.stitch-in-ctl,
    top: spc.layout.stitch-in-ctl,
    right: spc.layout.stitch-in-ctl,
    bottom: spc.layout.stitch-in-ctl,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.opt,
    border[0].width: spc.layout.stitch-w-sm
  }

  lead = frame {
    layout: {stack: {align-items: .center, item-gap: spc.steps.s3}},
    children: [dot, main],

    dot = frame : prt.secDotRow {}

    main = frame {
      layout: {stack: {direction: .column, item-gap: spc.steps.s1}},
      children: [name, sub],

      name = text : txt.titleCard {
        contents: "Studio",
        font-size: typ.sizes.st-row
      }

      sub = frame {
        height: spc.controls.st-fact,
        layout: {stack: {align-items: .center, item-gap: spc.steps.s2}},
        children: [state, kind, stamp],

        state = frame : fct.factDraft {}

        kind = frame : fct.factChip {}

        stamp = text : txt.meta {
          contents: "autosaved 4 min ago"
        }
      }
    }
  }

  go = asset {
    width: spc.controls.btn-icon,
    height: spc.controls.btn-icon,
    fill: col.roles.fg-3,
    contents: goIcon
  }
}

// ---- Recently: a day (the small year pill) and its changes on the
// timeline's thread, each a knot, the words (the thing in the strong
// words) and the section's dot + the time.
// `actItem` children: `knot`, `body` (`words`, `stamp` (`dot`, `time`)).
export actItem = frame {
  title: "Activity · a change",
  left: 1596px,
  top: 719px,
  width: spc.controls.st-recent-w,
  layout: {stack: {}},
  padding-left: spc.layout.st-act-indent,
  children: [knot, body],

  knot = frame {
    left: spc.layout.st-knot-x,
    top: spc.layout.st-knot-y,
    width: spc.controls.st-knot,
    height: spc.controls.st-knot,
    ignore-stack: .true,
    fill: col.roles.sheet,
    border: {
      color: col.roles.fg-3,
      width: spc.layout.stitch-w-sm,
      dash: [3px, 3px]
    },
    corner-radius: spc.radii.pill
  }

  body = frame {
    width: 100%,
    layout: {stack: {direction: .column, item-gap: spc.steps.s1}},
    children: [words, stamp],

    words = text : txt.body {
      width: 100%,
      contents: "Autosaved Studio",
      font-size: typ.sizes.st-act,
      line-height: typ.leading.st-quiet,
      fill[0].color: col.roles.fg,
      subrange[0].font-style: typ.faces.st-strong-style,
      subrange[0].range: [10, 16]
    }

    stamp = frame {
      layout: {stack: {align-items: .center, item-gap: spc.layout.fact-gap}},
      children: [dot, time],

      dot = frame : prt.secDotAct {}

      time = text : txt.meta {
        contents: "2:28 pm"
      }
    }
  }
}

// A day: its pill, then its changes on the thread. Insert the changes
// into `changes`: `changes { overrides: [insert(c1, after = .nil), …] }`.
export actDay = frame {
  title: "Activity · a day",
  left: 2164px,
  top: 719px,
  width: spc.controls.st-recent-w,
  layout: {stack: {direction: .column, item-gap: spc.steps.s3}},
  padding-bottom: spc.layout.fact-gap,
  children: [thread, pill, changes],

  // the thread: a dashed line from the pill down the day
  thread = frame {
    left: spc.layout.st-thread-x,
    top: spc.steps.s5,
    bottom: 0px,
    width: 2px,
    ignore-stack: .true,
    border: {
      color: col.roles.stitch,
      width: spc.layout.stitch-w-sm,
      dash: [5px, 4px],
      sides: .left
    }
  }

  pill = frame : yp.yearPillSm {}

  changes = frame {
    width: 100%,
    layout: {stack: {direction: .column, item-gap: spc.layout.st-act-gap}}
  }
}

