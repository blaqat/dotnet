@variants(studioPartsStatesI10)
studioPartsStates = frame : doc.docBoard {
  title: "Studio parts · states · i9",
  left: 0px,
  top: 505px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [insert(row-1, after = .nil), insert(row-2, after = row-1)]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Studio parts · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-secDot, after = .nil),
      insert(st-secDotRow, after = st-secDot),
      insert(st-secDotAct, after = st-secDotRow)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-eyebrow-heading, after = .nil),
      insert(st-eyebrow-title, after = st-eyebrow-heading),
      insert(st-eyebrow-label, after = st-eyebrow-title),
      insert(st-eyebrow-quiet, after = st-eyebrow-label)
    ]
  }

  st-secDot = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "secDot"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a section dot"
    }

    it = frame : secDot {}
  }

  st-secDotRow = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "secDotRow"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "in a row"
    }

    it = frame : secDotRow {}
  }

  st-secDotAct = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "secDotAct"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "in the activity list"
    }

    it = frame : secDotAct {}
  }

  st-eyebrow-heading = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "eyebrow"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "i11 → eyebrowHeading"
    }

    it = frame : eyebrow {}
  }

  st-eyebrow-title = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "eyebrow"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "i11 → eyebrowTitle"
    }

    it = frame : eyebrow {}
  }

  st-eyebrow-label = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "eyebrow"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "i11 → eyebrowLabel"
    }

    it = frame : eyebrow {}
  }

  st-eyebrow-quiet = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "eyebrow"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "i11 → eyebrowQuiet"
    }

    it = frame : eyebrow {}
  }
}

@variants(studioPartsStatesI11)
@context(i10="on")
studioPartsStatesI10 = frame : studioPartsStates {
  title: "Studio parts · states · i10",
  left: 824px,
  top: 505px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }
}

@context(i10="on", i11="on")
studioPartsStatesI11 = frame : studioPartsStatesI10 {
  title: "Studio parts · states · i11",
  left: 1648px,
  top: 505px,

  body {
    row-2 {
      st-eyebrow-quiet {
        slot {
          @with-variant(eyebrowQuiet)
          it {}
        }

        note {
          contents: "i11 · quiet"
        }

        label {
          contents: "eyebrowQuiet"
        }
      }

      st-eyebrow-label {
        slot {
          @with-variant(eyebrowLabel)
          it {}
        }

        note {
          contents: "i11 · the Label role"
        }

        label {
          contents: "eyebrowLabel"
        }
      }

      st-eyebrow-title {
        slot {
          @with-variant(eyebrowTitle)
          it {}
        }

        note {
          contents: "i11 · the Title role"
        }

        label {
          contents: "eyebrowTitle"
        }
      }

      st-eyebrow-heading {
        slot {
          @with-variant(eyebrowHeading)
          it {}
        }

        note {
          contents: "i11 · the Heading role"
        }

        label {
          contents: "eyebrowHeading"
        }
      }
    }
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
    }
  }
}
