@variants(studioArticleStatesI10)
studioArticleStates = frame : doc.docBoard {
  title: "Studio · article editor parts · states · i9",
  left: 0px,
  top: 2630px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3),
      insert(row-5, after = row-4)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Studio · article editor parts · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-tbBtn, after = .nil),
      insert(st-tbBtnLabel, after = st-tbBtn),
      insert(st-coverAdd, after = st-tbBtnLabel)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-mdBar, after = .nil)]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-tagField, after = .nil)]
  }

  row-4 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-proseDoc, after = .nil),
      insert(st-proseDocSite, after = st-proseDoc)
    ]
  }

  row-5 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-docSheet, after = .nil),
      insert(st-prevArticle, after = st-docSheet)
    ]
  }

  st-tbBtn = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tbBtn"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a toolbar button"
    }

    it = frame : tbBtn {}
  }

  st-tbBtnLabel = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "tbBtnLabel"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "with a label"
    }

    it = frame : tbBtnLabel {}
  }

  st-coverAdd = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "coverAdd"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "add a cover"
    }

    it = frame : coverAdd {}
  }

  st-mdBar = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "mdBar"
    }

    slot {
