@variants(playerPhoneStatesI10)
playerPhoneStates = frame : doc.docBoard {
  title: "Phone player · states · i9",
  left: 0px,
  top: 1312px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [insert(row-1, after = .nil), insert(row-2, after = row-1)]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Phone player · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-playerDisc, after = .nil),
      insert(st-queueRow, after = st-playerDisc),
      insert(st-queueRowNow, after = st-queueRow)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-playerPage, after = .nil),
      insert(st-playerPagePaused, after = st-playerPage),
      insert(st-playerPageQueue, after = st-playerPagePaused)
    ]
  }

  st-playerDisc = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playerDisc"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the disc · closed"
    }

    it = frame : playerDisc {}
  }

  st-queueRow = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "queueRow"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a queue row · rest"
    }

    it = frame : queueRow {}
  }

  st-queueRowNow = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "queueRowNow"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "now: playing"
    }

    it = frame : queueRowNow {}
  }

  st-playerPage = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playerPage"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "open · playing"
    }

    it = frame : playerPage {}
  }

  st-playerPagePaused = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playerPagePaused"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "open · paused"
    }

    it = frame : playerPagePaused {}
  }

  st-playerPageQueue = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "playerPageQueue"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "scrolled to the queue"
    }

    it = frame : playerPageQueue {}
  }
}

