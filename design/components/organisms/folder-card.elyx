@variants(folderCardStatesI10)
folderCardStates = frame : doc.docBoard {
  title: "Folder card · states · i9",
  left: 0px,
  top: 1117px,

  body {
    overrides: [insert(row-1, after = .nil)],
    layout.stack.item-gap: 48px
  }

  boardHead {
    boardCaption {
      contents: "Folder card · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-folderCard, after = .nil),
      insert(st-folderCardCurrent, after = st-folderCard),
      insert(st-folderCardLive, after = st-folderCardCurrent),
      insert(st-folderCardSingle, after = st-folderCardLive)
    ]
  }

  st-folderCard = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    slot {
      overrides: [insert(it, after = .nil)]
    }

    label {
      contents: "folderCard"
    }

    note = text : doc.specNote {
      contents: "rest · a collection (its tabs above)"
    }

    it = frame : folderCard {
      left: 0px,
      top: 0px,
      height: 224px
    }
  }

  st-folderCardCurrent = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "folderCardCurrent"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "current: loaded, paused"
    }

    it = frame : folderCardCurrent {}
  }

  st-folderCardLive = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "folderCardLive"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "live: playing"
    }

    it = frame : folderCardLive {}
  }

  st-folderCardSingle = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "folderCardSingle"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a single (no tabs)"
    }

    it = frame : folderCardSingle {}
  }
}

