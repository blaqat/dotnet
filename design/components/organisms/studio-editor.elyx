// Studio's editor (studio-editors.js): the kit's detail shell. The top bar
// (← the section · History · the publish button), the head (the publish
// state + autosave facts, the title, which IS the input), then the form |
// the live preview (studio-preview.elyx). The form is sections of fields:
// kit fields, chips, rows and swatches. i9 → i10 → i11 is tokens, except
// the sections' small caps (prt.eyebrow*, picked in a block's I11).
// ---- the top bar: back on the left, History + publish on the right.
// The publish button: "Published" (a quiet ghost, nothing to publish) or
// `edBarPublish` (the one primary: Publish).
// Children: `back` (`backGlyph`, `backWord`), `acts` (`history`,
// `published`, `publish`).
@variants(edBarPublish)
export edBar = frame {
  title: "Editor bar · published",
  left: 0px,
  top: 40px,
  width: 1332px,
  layout: {stack: {justify-content: .space-between, align-items: .center}},
  padding: [spc.steps.s2, 0px],
  children: [back, acts],

  back = frame : dt.detailBack {
    backWord {
      contents: "Music"
    }
  }

  acts = frame {
    layout: {stack: {align-items: .center, item-gap: spc.layout.chip-gap}},
    children: [history, published, publish],

    history = frame : btn.btnIcon {
      glyph {
        width: spc.controls.icon,
        height: spc.controls.icon,
        contents: historyIcon
      }

      btnStitch {
        display: .none
      }
    }

    // nothing to publish: the ghost, quiet
    published = frame : btn.btnGhost {
      opacity: 0.5,

      glyph {
        contents: checkIcon,
        display: .visible
      }

      label {
        contents: "Published"
      }
    }

    publish = frame : btn.btnPrimary {
      display: .none,

      glyph {
        contents: publishIcon
      }

      label {
        contents: "Publish"
      }
    }
  }
}

// A draft (or unpublished edits): Publish is the page's primary.
export edBarPublish = frame : edBar {
  title: "Editor bar · publish",
  left: 1596px,
  top: 40px,

  acts {
    published {
      display: .none
    }

    publish {
      display: .visible
    }
  }

  back {
    backWord {
      contents: "Thoughts"
    }
  }
}

// ---- the head: the publish state + autosave facts, then the title (the
// shell's title type: i9 2.4rem Black; from i10 Display). `edHeadDraft`:
// a draft. Children: `facts` (`state`, `saved`), `titleBox` (`titleText`).
@variants(edHeadDraft)
export edHead = frame {
  title: "Editor head · live",
  left: 0px,
  top: 220px,
  width: 1332px,
  layout: {stack: {direction: .column, item-gap: spc.steps.s2}},
  padding-top: spc.layout.fact-gap,
  children: [facts, titleBox],

  facts = frame {
    height: spc.controls.tag,
    layout: {stack: {align-items: .center, item-gap: spc.layout.facts-gap}},
    children: [state, saved],

    state = frame : fct.factLive {}

    saved = frame : fct.factChip {
      disc {
        glyph {
          contents: checkIcon
        }
      }

      label {
        contents: "Saved 4:44 pm"
      }
    }
  }

  titleBox = frame {
    width: 100%,
    layout: {stack: {}},
    padding: [spc.steps.s1, 0px, spc.layout.fact-gap],
    children: titleText,

    titleText = text : txt.display {
      contents: "VGM Class Final Project",
      font-size: typ.sizes.st-title,
      line-height: typ.leading.st-title,
      subrange[0].fill[0].color: col.roles.fg
    }
  }
}

export edHeadDraft = frame : edHead {
  title: "Editor head · draft",
  left: 1596px,
  top: 220px,

  titleBox {
    titleText {
      contents: "Building the Studio"
    }
  }

  facts {
    saved {
      label {
        contents: "Saved 2:20 pm"
      }
    }

    @with-variant(fct.factDraft)
    state {}
  }
}

// ---- a form section (.st-sec): a dashed rule on top, its head (an
// eyebrow + an optional small action on the right), then its fields
// (insert them after `headRow`). `formSecSub`: a section inside the
// folder (12 above and below). The first section of a form hides its rule
// (`border[0].visible: .false`).
// Children: `headRow` (`head`, `act`).
@variants(formSecSub)
export formSec = frame {
  title: "Form section",
  left: 0px,
  top: 433px,
  width: spc.controls.st-form-w,
  layout: {
    stack: {
      direction: .column,
      align-items: .stretch,
      item-gap: spc.layout.st-sec-gap
    }
  },
  border: {
    color: col.roles.stitch,
    width: spc.layout.stitch-w-sm,
    dash: [5px, 4px],
    sides: .top
  },
  padding: [spc.layout.st-sec-y, 0px],
  children: headRow,

  headRow = frame {
    layout: {stack: {justify-content: .space-between, align-items: .center}},
    children: [head, act],

    head = frame : prt.eyebrow {
      word {
        contents: "TRACKS"
      }
    }

    act = frame : btn.btnGhostSm {
      display: .none
    }
  }
}

export formSecSub = frame : formSec {
  title: "Form section · in the folder",
  left: 1596px,
  top: 433px,
  padding-top: spc.steps.s3,
  padding-left: 0px,
  padding-bottom: spc.steps.s3,
  padding-right: 0px,

  headRow {
    head {
      word {
        contents: "AUDIO"
      }
    }
  }
}

// ---- a field's label (.st-lab): the Label words + an optional Meta note
// beside them. Children: `word`, `note`.
export fieldLabel = frame {
  title: "Field label",
  left: 3192px,
  top: 433px,
  layout: {stack: {align-items: .center, item-gap: spc.layout.fact-gap}},
  children: [word, note],

  word = text : txt.label {
    contents: "Track name",
    font-size: typ.sizes.st-lab,
    line-height: typ.leading.st-lab,
    fill[0].color: col.roles.fg-2
  }

  note = text : txt.meta {
    display: .none,
    contents: "the yarn says it, so the site never labels it"
  }
}

// A labelled field (.st-field): the label over a kit field.
// Children: `lab`, `input` (fld.field).
export labeled = frame {
  title: "Labelled field",
  left: 0px,
  top: 601px,
  width: spc.controls.st-form-w,
  layout: {
    stack: {
      direction: .column,
      align-items: .stretch,
      item-gap: spc.layout.st-lab-gap
    }
  },
  children: [lab, input],

  lab = frame : fieldLabel {}

  input = frame : fld.field {
    width: 100%,

    value {
      contents: "combat"
    }
  }
}

// ---- a track tab (.st-tab): a collection's tracks sit on its folder as
// tabs (the editor's version of the kit's folder tabs). Cotton-2 knit,
// the track's swatch (20) + its name; chosen (`trackTabPicked`): white,
// 4 up, the pick rope on its edge; `trackTabAdd`: + Track, a dashed edge.
// Children: `sw`, `name`.
@variants(trackTabPicked, trackTabAdd)
export trackTab = frame {
  title: "Track tab",
  left: 0px,
  top: 881px,
  height: spc.controls.st-tab-h,
  layout: {stack: {align-items: .center, item-gap: spc.layout.fact-gap}},
  fill: col.roles.recess,
  shadow: {
    inner-shadow: {
      color: pal.palette.stitch,
      offset: point(0px, -6px),
      blur-radius: 6px,
      spread: -6px
    }
  },
  corner-radius: [spc.radii.st-tab, spc.radii.st-tab, 0px, 0px],
  padding: [0px, spc.layout.st-tab-x, 0px, spc.layout.st-tab-l],
  children: [sw, name],

  sw = frame {
    width: spc.controls.st-tab-sw,
    height: spc.controls.st-tab-sw,
    fill: [col.roles.recess, {image: {ref: explorePianoSw}}],
    corner-radius: spc.radii.st-tab-sw,
    overflow: .clip
  }

  name = text : txt.label {
    contents: "explore (piano)",
    font-size: typ.sizes.st-tab,
    fill[0].color: col.roles.fg-2
  }
}

export trackTabPicked = frame : trackTab {
  title: "Track tab · chosen",
  left: 1596px,
  top: 881px,
  height: spc.controls.st-tab-up,
  padding-top: spc.steps.s2,
  fill[0].color: col.roles.surface,
  layout.stack.align-items: .start,
  overrides: [insert(tabRope, after = trackTab.name)],
  shadow[0].inner-shadow.visible: .false,

  sw {
    fill[1].image.ref: combatSw
  }

  name {
    fill[0].color: col.roles.fg,
    contents: "combat"
  }

  tabRope = frame : surf.rope {
    left: 0px,
    top: 0px,
    right: 0px,
    bottom: 0px,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: [spc.radii.st-tab, spc.radii.st-tab, 0px, 0px]
  }
}

export trackTabAdd = frame : trackTab {
  title: "Track tab · + Track",
  left: 3192px,
  top: 881px,
  padding-left: spc.layout.st-tab-x,
  fill[0].color: pal.palette.clear,
  overrides: [
    insert(addStitch, after = .nil),
    insert(addGlyph, after = addStitch)
  ],
  shadow[0].inner-shadow.visible: .false,

  name {
    fill[0].color: col.roles.link,
    contents: "Track"
  }

  sw {
    display: .none
  }

  addGlyph = asset {
    width: spc.controls.icon-sm,
    height: spc.controls.icon-sm,
    fill: col.roles.link,
    contents: plusIcon
  }

  addStitch = frame : surf.stitch {
    left: spc.layout.stitch-in-ctl,
    top: spc.layout.stitch-in-ctl,
    right: spc.layout.stitch-in-ctl,
    bottom: 0px,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: [spc.radii.inner, spc.radii.inner, 0px, 0px],
    border[0].width: spc.layout.stitch-w-sm
  }
}

// ---- a collection's folder: the track tabs on top (their feet tucked
// under), the body (a patch, its top-left corner tucked under the first
// tab). Insert the track's fields into `body`.
// Children: `tabs` (`t1` … `t6`, `addTab`), `body` (`bodyStitch`).
export folder = frame {
  title: "Folder · VGM Class Final Project",
  left: 1596px,
  top: 601px,
  width: spc.controls.st-form-w,
  layout: {
    stack: {
      direction: .column,
      align-items: .stretch,
      item-gap: spc.layout.st-tab-tuck
    }
  },
  padding-top: spc.steps.s2,
  children: [tabs, body],

  tabs = frame {
    layout: {stack: {align-items: .end, item-gap: spc.steps.s1}},
    padding-left: spc.layout.st-tabs-l,
    children: [t1, t2, t3, t4, t5, t6, addTab],

    t1 = frame : trackTab {}

    t2 = frame : trackTabPicked {}

    t3 = frame : trackTab {
      sw {
        fill[1].image.ref: bossSw
      }

      name {
        contents: "boss"
      }
    }

    t4 = frame : trackTab {
      sw {
        fill[1].image.ref: deathSw
      }

      name {
        contents: "death"
      }
    }

    t5 = frame : trackTab {
      sw {
        fill[1].image.ref: victorySw
      }

      name {
        contents: "victory"
      }
    }

    t6 = frame : trackTab {
      sw {
        fill[1].image.ref: exploreSw
      }

      name {
        contents: "explore"
      }
    }

    addTab = frame : trackTabAdd {}
  }

  body = frame {
    min-height: spc.controls.st-ta-h,
    layout: {
      stack: {
        direction: .column,
        align-items: .stretch,
        item-gap: spc.layout.st-sub-gap
      }
    },
    fill: col.roles.surface,
    shadow: [
      {
        drop-shadow: {
          color: pal.palette.shadow-1,
          offset: point(0px, 1px),
          blur-radius: 0px
        }
      },
      {
        drop-shadow: {
          color: pal.palette.shadow-1,
          offset: point(0px, 2px),
          blur-radius: 6px
        }
      }
    ],
    corner-radius: [
      spc.radii.st-tuck,
      spc.radii.st-folder,
      spc.radii.st-folder,
      spc.radii.st-folder
    ],
    padding: spc.layout.st-folder-inset,
    children: bodyStitch,

    bodyStitch = frame : surf.stitch {
      left: spc.layout.stitch-in,
      top: spc.layout.stitch-in,
      right: spc.layout.stitch-in,
      bottom: spc.layout.stitch-in,
      width: .nil,
      height: .nil,
      ignore-stack: .true,
      corner-radius: [0px, spc.steps.s3, spc.steps.s3, spc.steps.s3]
    }
  }
}

// ---- the audio box (.st-audio): ▶ (ink), the file's name + its time,
// Replace; the waveform (the player's bars) with the scrub pin (the live
// colour). Children: `top` (`play`, `file` (`fileName`, `fileMeta`),
// `replace`), `wave` (`bars`, `pin` (`pinHead`)).
export audioBox = frame {
  title: "Audio box",
  left: 0px,
  top: 1270px,
  width: 642px,
  layout: {
    stack: {
      direction: .column,
      align-items: .stretch,
      item-gap: spc.layout.st-sec-gap
    }
  },
  fill: col.roles.surface,
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 2px),
        blur-radius: 6px
      }
    }
  ],
  corner-radius: spc.radii.card,
  padding: spc.layout.st-box,
  children: [boxStitch, top, wave],

  boxStitch = frame : surf.stitch {
    left: spc.layout.stitch-in,
    top: spc.layout.stitch-in,
    right: spc.layout.stitch-in,
    bottom: spc.layout.stitch-in,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.inner
  }

  top = frame {
    layout: {stack: {justify-content: .space-between, align-items: .center}},
    children: [lead, replace],

    lead = frame {
      layout: {stack: {align-items: .center, item-gap: spc.steps.s3}},
      children: [play, file],

      // ▶ on ink (a sample, not the act)
      play = frame : btn.btnIcon {
        fill[0].color: col.roles.dark,
        shadow[1].drop-shadow.color: pal.palette.shadow-1,

        btnStitch {
          border[0].color: col.roles.ctl-stitch-fill
        }

        glyph {
          fill[0].color: col.roles.dark-fg,
          contents: playIcon
        }
      }

      file = frame {
        layout: {stack: {direction: .column, item-gap: spc.steps.s1}},
        children: [fileName, fileMeta],

        fileName = text : txt.titleCard {
          contents: "combat.mp3",
          font-size: typ.sizes.st-row
        }

        fileMeta = text : txt.meta {
          contents: "0:00 / 1:58 · waveform saved"
        }
      }
    }

    replace = frame : btn.btnGhostSm {
      glyph {
        contents: replaceIcon
      }
    }
  }

  wave = frame {
    height: spc.controls.st-wave-h,
    children: [bars, pin],

    bars = asset {
      left: 0px,
      top: 0px,
      right: 0px,
      bottom: 0px,
      fill: col.roles.line,
      contents: waveArt,
      sizing: .stretch
    }

    pin = frame {
      left: 0px,
      top: -4px,
      bottom: -4px,
      width: 2px,
      fill: col.roles.live-deep,
      corner-radius: 1px,
      children: pinHead,

      pinHead = frame {
        left: -5px,
        top: -6px,
        width: spc.controls.st-pin,
        height: spc.controls.st-pin,
        fill: col.roles.live,
        shadow: {
          drop-shadow: {
            color: pal.palette.shadow-pop,
            offset: point(0px, 1px),
            blur-radius: 2px
          }
        },
        corner-radius: spc.radii.pill
      }
    }
  }
}

// ---- an instrument option (.st-insts .yrow, a single choice): the
// instrument's swatch (44), its name over what its yarn looks like;
// chosen (`instOptPicked`): the pick rope. Children: `sw`, `words`
// (`name`, `look`).
@variants(instOptPicked)
export instOpt = frame {
  title: "Instrument option",
  left: 3466px,
  top: 881px,
  width: spc.controls.st-inst-w,
  height: spc.controls.st-inst-h,
  layout: {stack: {align-items: .center, item-gap: spc.layout.st-list-gap}},
  fill: col.roles.surface,
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 2px),
        blur-radius: 6px
      }
    }
  ],
  corner-radius: spc.radii.row,
  padding: [
    spc.layout.st-opt-l,
    spc.layout.st-opt-r,
    spc.layout.st-opt-l,
    spc.layout.st-opt-l
  ],
  children: [optStitch, sw, words],

  optStitch = frame : surf.stitch {
    left: spc.steps.s1,
    top: spc.steps.s1,
    right: spc.steps.s1,
    bottom: spc.steps.s1,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.inner,
    border[0].width: spc.layout.stitch-w-sm
  }

  sw = frame {
    width: spc.controls.st-inst-sw,
    height: spc.controls.st-inst-sw,
    fill: [col.roles.recess, {image: {ref: pianoSw}}],
    corner-radius: spc.radii.art,
    overflow: .clip
  }

  words = frame {
    layout: {stack: {direction: .column, item-gap: spc.steps.s1}},
    children: [name, look],

    name = text : txt.labelCard {
      contents: "Piano"
    }

    look = text : txt.metaCard {
      contents: "black yarn",
      font-size: typ.sizes.st-small
    }
  }
}

export instOptPicked = frame : instOpt {
