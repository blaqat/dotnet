    ]
  }

  row-13 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-linkAdd, after = .nil)]
  }

  st-edBar = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "edBar"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the editor bar · saved"
    }

    it = frame : edBar {}
  }

  st-edBarPublish = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "edBarPublish"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
