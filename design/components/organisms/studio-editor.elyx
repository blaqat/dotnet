@variants(studioEditorStatesI10)
studioEditorStates = frame : doc.docBoard {
  title: "Studio · editor parts · states · i9",
  left: 0px,
  top: 1944px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3),
      insert(row-5, after = row-4),
      insert(row-6, after = row-5),
      insert(row-7, after = row-6),
      insert(row-8, after = row-7),
      insert(row-9, after = row-8),
      insert(row-10, after = row-9),
      insert(row-11, after = row-10),
      insert(row-12, after = row-11),
      insert(row-13, after = row-12)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Studio · editor parts · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-edBar, after = .nil)]
  }

  row-2 = frame : doc.specRow {
