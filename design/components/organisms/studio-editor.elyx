// The five patterns (auto picks one from the track).
export motifRow = frame {
  title: "Pattern options (DAW)",
  left: 4315px,
  top: 881px,
  layout: {stack: {item-gap: spc.steps.s2}},
  children: [auto, sine, square, triangle, saw],

  auto = frame : motifOptPicked {}

  sine = frame : motifOpt {}

  square = frame : motifOpt {
    sw {
      fill[1].image.ref: squareSw
    }

    name {
      contents: "square"
    }
  }

  triangle = frame : motifOpt {
    sw {
      fill[1].image.ref: triangleSw
    }

    name {
      contents: "triangle"
    }
  }

  saw = frame : motifOpt {
    sw {
      fill[1].image.ref: sawSw
    }

    name {
      contents: "saw"
    }
  }
}

// ---- a status option (.st-opt, a single choice): a 44 chip holding the
// status's fact; chosen (`statusOptPicked`): the pick rope.
// Children: `opt` (a fct.fact*: swap it with @with-variant).
@variants(statusOptPicked)
export statusOpt = frame : chips.chip {
  title: "Status option",
  left: 0px,
  top: 1071px,
  height: spc.controls.btn,
  padding-left: spc.layout.st-tab-x,
  padding-right: spc.layout.st-opt-r,
  overrides: [insert(opt, after = chips.chip.glyph)],

  glyph {
    display: .none
  }

  label {
    display: .none
  }

  opt = frame : fct.factWip {
    label {
      fill[0].color: col.roles.fg,
      contents: "WIP"
    }

    sub {
      display: .none
    }
  }
}

export statusOptPicked = frame : statusOpt {
  title: "Status option · chosen",
  left: 1596px,
  top: 1071px,
  overrides: [insert(optRope, after = chips.chip.chipRing)],

  @with-variant(fct.fact)
  opt {
    label {
      contents: "Complete"
    }
  }

  chipStitch {
    display: .none
  }

  optRope = frame : surf.rope {
    left: 0px,
    top: 0px,
    right: 0px,
    bottom: 0px,
    width: .nil,
    height: .nil,
    ignore-stack: .true
  }
}

// ---- a link (studio-links.js): the grip, then a kit row: the site's
// mark (a link disc, the kind under it), its text (empty = the site's
// name, the placeholder) over its address (mono), ✕.
// Children: `grip` (`gripGlyph`), `row` (`rowStitch`, `mark` (`disc`,
// `kind`), `inputs` (`words`, `url`), `remove`).
export linkRow = frame {
  title: "Link row",
  left: 0px,
  top: 1536px,
  width: 642px,
  layout: {stack: {align-items: .stretch, item-gap: spc.steps.s2}},
  children: [grip, row],

  grip = frame {
    width: spc.controls.st-grip,
    layout: {stack: {justify-content: .center, align-items: .center}},
    children: gripGlyph,

    gripGlyph = asset {
      width: spc.controls.icon,
      height: spc.controls.icon,
      fill: col.roles.fg-3,
      contents: gripIcon
    }
  }

  row = frame {
    width: 100%,
    layout: {stack: {item-gap: spc.steps.s3}},
    fill: col.roles.surface,
    shadow: [
      {
        drop-shadow: {
          color: pal.palette.shadow-1,
          offset: point(0px, 1px),
          blur-radius: 0px
        }
      },
      {
        drop-shadow: {
          color: pal.palette.shadow-1,
          offset: point(0px, 2px),
          blur-radius: 6px
        }
      }
    ],
    corner-radius: spc.radii.row,
    padding: spc.layout.st-list-gap,
    children: [rowStitch, mark, inputs, remove],

    rowStitch = frame : surf.stitch {
      left: spc.layout.stitch-in-ctl,
      top: spc.layout.stitch-in-ctl,
      right: spc.layout.stitch-in-ctl,
      bottom: spc.layout.stitch-in-ctl,
      width: .nil,
      height: .nil,
      ignore-stack: .true,
      corner-radius: spc.radii.opt,
      border[0].width: spc.layout.stitch-w-sm
    }

    mark = frame {
      layout: {
        stack: {
          direction: .column,
          align-items: .center,
          item-gap: spc.steps.s1
        }
      },
      children: [disc, kind],

      disc = frame : lnk.linkDiscSoundcloud {
        width: spc.controls.btn,
        height: spc.controls.btn,

        glyph {
          width: spc.controls.icon,
          height: spc.controls.icon
        }
      }

      kind = text : txt.micro {
        contents: "TRACK",
        letter-spacing: typ.tracking.caps,
        fill[0].color: col.roles.fg-3
      }
    }

    inputs = frame {
      width: 100%,
      layout: {
        stack: {
          direction: .column,
          align-items: .stretch,
          item-gap: spc.layout.fact-gap
        }
      },
      children: [words, url],

      words = frame : fld.fieldPlaceholder {
        width: 100%,
        height: spc.controls.st-in-sm,
        padding-top: 0px,
        padding-left: spc.layout.st-in-x,
        padding-bottom: 0px,
        padding-right: spc.layout.st-in-x,

        value {
          contents: "SoundCloud"
        }
      }

      url = frame : fld.field {
        width: 100%,
        height: spc.controls.st-in-xs,
        padding-top: 0px,
        padding-left: spc.layout.st-in-x,
        padding-bottom: 0px,
        padding-right: spc.layout.st-in-x,

        value {
          contents: "https://soundcloud.com/litter_box/combat?in=litter_box/sets/…",
          font-size: typ.sizes.meta,
          font-family: typ.faces.meta,
          font-style: typ.faces.meta-style
        }
      }
    }

    remove = frame : lnk.linkDisc {
      glyph {
        contents: removeIcon
      }
    }
  }
}

// Add links: paste one or many (one per line), then Add.
// Children: `paste` (fld.field), `add` (btn.btn).
export linkAdd = frame {
  title: "Links · add",
  left: 0px,
  top: 1758px,
  width: 642px,
  layout: {stack: {align-items: .center, item-gap: spc.steps.s2}},
  children: [paste, add],

  paste = frame : fld.fieldPlaceholder {
    width: 100%,

    value {
      contents: "Paste links: SoundCloud, YouTube, BeepBox…",
      font-size: typ.sizes.meta,
      font-family: typ.faces.meta,
      font-style: typ.faces.meta-style
    }
  }

  add = frame : btn.btn {
    height: spc.controls.st-in-sm,

    glyph {
      contents: plusIcon
    }

    label {
      contents: "Add"
    }
  }
}

// ---- a collection's facts, read-only, from its tracks (.st-derived): a
// dashed box, the fact's name over its value and where it comes from
// ("from explore (piano)", a link). Base: the status (a fact + its tally);
// `derivedBoxDate`: a month. Children: `dt`, `dd` (`value`, `valueText`,
// `from`).
@variants(derivedBoxDate)
export derivedBox = frame {
  title: "Derived fact · status",
  left: 3192px,
  top: 1071px,
  width: 218px,
  layout: {
    stack: {direction: .column, align-items: .stretch, item-gap: spc.steps.s1}
  },
  border: {
    color: col.roles.stitch,
    width: spc.layout.stitch-w-sm,
    dash: [5px, 4px]
  },
  corner-radius: spc.radii.row,
  padding: [spc.layout.st-list-gap, spc.steps.s3],
  children: [dt, dd],

  dt = frame : fieldLabel {
    word {
      contents: "Status"
    }
  }

  dd = frame {
    layout: {stack: {direction: .column, item-gap: 2px}},
    children: [value, valueText, from],

    value = frame : fct.fact {
      height: spc.controls.st-fact,

      sub {
        display: .none
      }

      label {
        contents: "Complete"
      }
    }

    valueText = text : txt.titleCard {
      display: .none,
      contents: "May 2021",
      font-size: typ.sizes.st-row
    }

    from = text : txt.meta {
      contents: "5 complete · 1 dropped"
    }
  }
}

// A month, and the track it comes from (a link).
export derivedBoxDate = frame : derivedBox {
  title: "Derived fact · a month",
  left: 3466px,
  top: 1071px,

  dd {
    from {
      subrange[0].range: [5, 20],
      subrange[0].fill[0].color: col.roles.link,
      subrange[0].underline: .single,
      contents: "from explore (piano)"
    }

    value {
      display: .none
    }

    valueText {
      display: .visible
    }
  }

  dt {
    word {
      contents: "Started"
    }
  }
}

// ---- a collection's instrument, from its tracks (.st-instmix): its mixed
// swatch, the fact ("DAW + Piano" on a split disc) over the tally.
// Children: `sw`, `words` (`inst`, `tally`).
export instMix = frame {
  title: "Instrument · from the tracks",
  left: 1596px,
  top: 1270px,
  width: spc.controls.st-form-w,
  height: spc.controls.st-inst-h,
  layout: {stack: {align-items: .center, item-gap: spc.steps.s3}},
  fill: col.roles.surface,
  shadow: {
    drop-shadow: {
      color: pal.palette.shadow-1,
      offset: point(0px, 1px),
      blur-radius: 0px
    }
  },
  corner-radius: spc.radii.row,
  padding: [
    spc.layout.st-opt-l,
    spc.layout.st-opt-r,
    spc.layout.st-opt-l,
    spc.layout.st-opt-l
  ],
  children: [sw, words],

  sw = frame {
    width: spc.controls.st-inst-sw,
    height: spc.controls.st-inst-sw,
    fill: [col.roles.recess, {image: {ref: vgmSw}}],
    corner-radius: spc.radii.art,
    overflow: .clip
  }

  words = frame {
    layout: {stack: {direction: .column, item-gap: 2px}},
    children: [inst, tally],

    inst = frame : fct.fact {
      height: spc.controls.st-fact,

      disc {
        fill[0].linear-gradient.from: [0%, 50%],
        fill[0].linear-gradient.stops[3].position: 100%,
        fill[0].linear-gradient.stops[2].position: 50%,
        fill[0].linear-gradient.stops[1].position: 50%,
        fill[0].linear-gradient.stops[0].position: 0%,

        glyph {
          fill[0].color: col.roles.dark-fg,
          contents: musicIcon
        }

        fill[0].linear-gradient.to: [100%, 50%],
        fill[0].linear-gradient.stops[3].color: pal.palette.inst-piano,
        fill[0].linear-gradient.stops[2].color: pal.palette.inst-piano,
        fill[0].linear-gradient.stops[1].color: pal.palette.inst-daw,
        fill[0].linear-gradient.stops[0].color: pal.palette.inst-daw
      }

      sub {
        display: .none
      }

      label {
        contents: "DAW + Piano"
      }
    }

    tally = text : txt.metaCard {
      contents: "5 DAW · 1 Piano",
      font-size: typ.sizes.st-small
    }
  }
}

// ---- "On the card" (.st-shows): the site card's own facts, live.
// Children: `head` (prt.eyebrow), `fact`.
export showsStrip = frame {
  title: "On the card",
  left: 1596px,
  top: 1536px,
  width: spc.controls.st-form-w,
