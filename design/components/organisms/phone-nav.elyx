file {
  draw-connections: .true
}

// The phones' navigation (< 960; kit COMPONENTS.md §16 + §21, ?mnav=spool
// and ?msearch=fab: the decided defaults in i9, i10 and i11). There is no
// bottom bar: the page's top keeps only the brand (organisms/nav.elyx
// `navPhone`) and the sound tag, and everything else floats in one layer
// over the page, measured up from the screen's bottom:
//   the slot  a 360 × 64 strip 17 above the bottom, 15 in from each edge:
//             whatever is open fills it (the player's bar, the search bar)
//   the row   the slot's centre line: closed knobs rest on it (the sections
//             pill left; the search knob, then the player's disc, right)
//   the up    the line one slot higher: what waits while the slot is held
//             (the pill and the knob at .846; search's chip row)
// Parts here: the knobs (search · Browse · Studio's +), the sections menu
// (the pill unspooled) and its rows, the search bar in the slot, the
// floating chip row, and `phoneLayer`: the whole layer in each state.
// ---- knobs (.yfab__btn) ----
// One quiet white knit button (52, its stitch 6 in), the magnifier in fg-2.
// Up: .846 (44) while the player's bar holds the slot. Open: at the search
// bar's right end, 44, on cotton-2 (pressed in), ⌄ (it folds the bar
// away). Count: the filters that are on, a badge on its shoulder.
// Children: `knobStitch`, `glyph`, `badge` (`n`).
@variants(searchKnobUp, searchKnobOpen, searchKnobCount, browseKnob, newKnob)
export searchKnob = frame {
  title: "Search knob · rest",
  left: 0px,
  top: 40px,
  width: spc.controls.knob,
  height: spc.controls.knob,
  layout: {stack: {justify-content: .center, align-items: .center}},
  fill: col.roles.surface,
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: pal.palette.shadow-pop,
        offset: point(0px, 6px),
        blur-radius: 16px,
        spread: -5px
      }
    }
  ],
  corner-radius: spc.radii.pill,
  children: [knobStitch, glyph, badge],

  knobStitch = frame : surf.stitch {
    left: spc.layout.stitch-in,
    top: spc.layout.stitch-in,
    right: spc.layout.stitch-in,
    bottom: spc.layout.stitch-in,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.pill,
    border[0].width: spc.layout.stitch-w-sm
  }

  glyph = asset {
    width: spc.controls.knob-icon,
    height: spc.controls.knob-icon,
    fill: col.roles.fg-2,
    contents: findIcon
  }

  badge = frame {
    top: -2px,
    right: -2px,
    width: spc.controls.knob-badge,
    height: spc.controls.knob-badge,
    display: .none,
    ignore-stack: .true,
    layout: {stack: {justify-content: .center, align-items: .center}},
    fill: col.roles.primary-bg,
    corner-radius: spc.radii.pill,
    children: n,

    n = text : txt.micro {
      contents: "2",
      fill[0].color: col.roles.primary-fg
    }
  }
}

export searchKnobUp = frame : searchKnob {
  title: "Search knob · up (the player has the slot)",
  left: 470px,
  top: 40px,
  width: spc.controls.knob-up,
  height: spc.controls.knob-up,

  glyph {
    width: spc.controls.knob-up-icon,
    height: spc.controls.knob-up-icon
  }
}

export searchKnobOpen = frame : searchKnob {
  title: "Search knob · open (folds the bar)",
  left: 940px,
  top: 40px,
  width: spc.controls.knob-up,
  height: spc.controls.knob-up,
  fill[0].color: col.roles.recess,
  shadow[0].inner-shadow.blur-radius: 2px,
  shadow[1]: .nil,

  glyph {
    fill[0].color: col.roles.fg,
    width: spc.controls.knob-up-icon,
    height: spc.controls.knob-up-icon,
    contents: foldIcon
  }

  knobStitch {
    display: .none
  }
}

export searchKnobCount = frame : searchKnob {
  title: "Search knob · 2 filters on",
  left: 1410px,
  top: 40px,

  badge {
    display: .visible
  }
}

// Browse (the floating chip row's end): the same knob, 44, the faders.
export browseKnob = frame : searchKnob {
  title: "Browse knob (the chip row's end)",
  left: 1880px,
  top: 40px,
  width: spc.controls.knob-up,
  height: spc.controls.knob-up,

  glyph {
    fill[0].color: col.roles.fg,
    width: spc.controls.knob-up-icon,
    height: spc.controls.knob-up-icon,
    contents: browseIcon
  }
}

// Studio's + (new): the ink knob (the view's primary), a white stitch.
export newKnob = frame : searchKnob {
  title: "New knob (Studio's +)",
  left: 2350px,
  top: 40px,
  fill[0].color: col.roles.dark,

  knobStitch {
    border[0].color: pal.palette.on-dark-stitch
  }

  glyph {
    fill[0].color: col.roles.dark-fg,
    contents: newIcon
  }
}

// ---- the sections menu (.yspool__menu) ----
// A row: the section's felt dot (32: its hue in i9; from i10 grey until
// it's here) and its name. Here (aria-current): cotton-2, the HERE rope on
// its edge (i9 red; from i10 the page's hue), the filled glyph.
// Children: `dot` (`glyph`), `label`.
@variants(spoolRowHere)
export spoolRow = frame {
  title: "Sections menu · row",
  left: 0px,
  top: 212px,
  width: spc.controls.spool-menu-w,
  height: spc.controls.spool-row,
  layout: {stack: {align-items: .center, item-gap: spc.layout.spool-row-gap}},
  corner-radius: spc.radii.spool-row,
  padding: [0px, spc.layout.spool-row-r, 0px, spc.layout.spool-row-l],
  children: [dot, label],

  dot = frame : tab.navTab.dot {
    width: spc.controls.spool-row-dot,
    height: spc.controls.spool-row-dot,
    fill[0].color: sec.section.hue-home,

    glyph {
      width: spc.controls.spool-row-icon,
      height: spc.controls.spool-row-icon,
      contents: homeIcon
    }
  }

  label = text : txt.label {
    contents: "Home",
    fill[0].color: col.roles.fg-2
  }
}

export spoolRowHere = frame : spoolRow {
  title: "Sections menu · row · here",
  left: 470px,
  top: 212px,
  fill[0].color: col.roles.recess,
  overrides: [insert(rowRope, after = spoolRow.label)],

  label {
    fill[0].color: col.roles.fg
  }

  dot {
    glyph {
      fill[0].color: col.roles.dot-fg,
      contents: homeIconFill
    }

    dotStitch {
      border[0].color: col.roles.dot-stitch
    }

    dotRest {
      display: .none
    }
  }

  rowRope = frame : surf.ropeHere {
    left: 0px,
    top: 0px,
    right: 0px,
    bottom: 0px,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.spool-row
  }
}

// The menu: white knit (22, a stitch 5 in), 200 wide at least, the site's
// four sections in a column (9 in, 4 apart), the page's own roped. It
// rises 8 above the pill (see `phoneLayerMenu`). One variant per section
// (`section=…`); Studio lists its own pages.
// Children: `menuStitch`, `rows` (`home`, `projects`, `music`, `thoughts`).
@variants(
  sectionsMenuProjects,
  sectionsMenuMusic,
  sectionsMenuThoughts,
  sectionsMenuStudio
)
export sectionsMenu = frame {
  title: "Sections menu · Home here",
  left: 0px,
  top: 380px,
  min-width: spc.controls.spool-menu-w,
  layout: {stack: {direction: .column, align-items: .stretch}},
  fill: col.roles.surface,
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    {
      drop-shadow: {
        color: pal.palette.shadow-pop,
        offset: point(0px, 18px),
        blur-radius: 40px,
        spread: -12px
      }
    },
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 2px),
        blur-radius: 6px
      }
    }
  ],
  corner-radius: spc.radii.spool-menu,
  children: [menuStitch, rows],

  menuStitch = frame : surf.stitch {
    left: spc.steps.s1,
    top: spc.steps.s1,
    right: spc.steps.s1,
    bottom: spc.steps.s1,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.spool-menu-stitch,
    border[0].width: spc.layout.stitch-w-sm
  }

  rows = frame {
    layout: {
      stack: {
        direction: .column,
        align-items: .stretch,
        item-gap: spc.layout.spool-rows-gap
      }
    },
    padding: spc.layout.spool-menu-in,
    children: [home, projects, music, thoughts],

    home = frame : spoolRowHere {
      width: 100%
    }

    projects = frame : spoolRow {
      width: 100%,

      dot {
        fill[0].color: sec.section.hue-projects,

        glyph {
          contents: projectsIcon
        }
      }

      label {
        contents: "Projects"
      }
    }

    music = frame : spoolRow {
      width: 100%,

      dot {
        fill[0].color: sec.section.hue-music,

        glyph {
          contents: musicIcon
        }
      }

      label {
        contents: "Music"
      }
    }

    thoughts = frame : spoolRow {
      width: 100%,

      dot {
        fill[0].color: sec.section.hue-thoughts,

        glyph {
          contents: thoughtsIcon
        }
      }

      label {
        contents: "Thoughts"
      }
    }
  }
}

@context(section="projects")
export sectionsMenuProjects = frame : sectionsMenu {
  title: "Sections menu · Projects here",
  left: 470px,
  top: 380px,

  rows {
    @with-variant(spoolRowHere)
    projects {
      dot {
        glyph {
          contents: projectsIconFill
        }
      }
    }

    @with-variant(spoolRow)
    home {}
  }
}

@context(section="music")
export sectionsMenuMusic = frame : sectionsMenu {
  title: "Sections menu · Music here",
  left: 940px,
  top: 380px,

  rows {
    @with-variant(spoolRowHere)
    music {
      dot {
        glyph {
          contents: musicIconFill
        }
      }
    }

    @with-variant(spoolRow)
    home {}
  }
}

@context(section="thoughts")
export sectionsMenuThoughts = frame : sectionsMenu {
  title: "Sections menu · Thoughts here",
  left: 1410px,
  top: 380px,

  rows {
    @with-variant(spoolRowHere)
    thoughts {
      dot {
        glyph {
          contents: thoughtsIconFill
        }
      }
