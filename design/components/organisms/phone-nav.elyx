// Studio's own pages: Studio (here) · Projects · Music · Thoughts · Media.
@context(section="studio")
export sectionsMenuStudio = frame : sectionsMenu {
  title: "Sections menu · Studio here",
  left: 1880px,
  top: 380px,

  rows {
    overrides: [insert(media, after = sectionsMenu.rows.thoughts)],

    home {
      dot {
        fill[0].color: sec.section.hue-studio,

        glyph {
          contents: studioIconFill
        }
      }

      label {
        contents: "Studio"
      }
    }
  }

  media = frame : spoolRow {
    width: 100%,

    dot {
      fill[0].color: sec.section.hue-studio,

      glyph {
        contents: mediaIcon
      }
    }

    label {
      contents: "Media"
    }
  }
}

// ---- search (?msearch=fab) ----
// The search bar in the slot (.yfab__panel): the knob unrolled into a 360 ×
// 64 white knit bar (20; its stitch 6 in, solid ink while it has focus),
// the field's own chrome stepped back (just the magnifier and the words),
// the open knob (⌄) at its right end. Children: `barStitch`, `field`,
// `fold`.
@variants(searchSlotTyped)
export searchSlot = frame {
  title: "Search bar in the slot · focused",
  left: 0px,
  top: 774px,
  width: spc.controls.slot-w,
  height: spc.controls.slot,
  layout: {stack: {align-items: .center, item-gap: spc.layout.fab-knob-gap}},
  fill: col.roles.surface,
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.shadow-1,
        offset: point(0px, 1px),
        blur-radius: 1px
      }
    },
    {
      drop-shadow: {
        color: pal.palette.shadow-lift,
        offset: point(0px, 10px),
        blur-radius: 22px
      }
    }
  ],
  corner-radius: spc.radii.slot,
  padding: [0px, spc.layout.fab-knob-r, 0px, spc.layout.fab-l],
  children: [barStitch, field, fold],

  barStitch = frame : surf.stitch {
    left: spc.layout.stitch-in,
    top: spc.layout.stitch-in,
    right: spc.layout.stitch-in,
    bottom: spc.layout.stitch-in,
    width: .nil,
    height: .nil,
    ignore-stack: .true,
    corner-radius: spc.radii.slot-stitch,
    border[0].color: col.roles.focus,
    border[0].dash: .nil
  }

  field = frame : srch.search {
    width: 100%,
    border[0].visible: .false,
    fill[0].visible: .false,
    shadow[0].inner-shadow.visible: .false,

    searchStitch {
      display: .none
    }

    key {
      display: .none
    }

    lead {
      entry {
        query {
          contents: "Search music"
        }
      }
    }
  }

  fold = frame : searchKnobOpen {}
}

// Typed: the words in ink.
export searchSlotTyped = frame : searchSlot {
  title: "Search bar in the slot · typed",
  left: 470px,
  top: 774px,

  field {
    lead {
      entry {
        query {
          fill[0].color: col.roles.fg,
          contents: "shadow"
        }
      }
    }
  }
}

// The floating chip row (.yfab__float) on the up line while search is
// open: Music's filter strip (All · instruments · statuses), cut at the
// row's end by Browse's knob. Children: `strip` (the tools' `scroll`),
// `browse`.
export filterFloat = frame {
  title: "Floating chip row (search open)",
  left: 940px,
  top: 774px,
  width: spc.controls.slot-w,
  layout: {stack: {align-items: .center}},
  children: [strip, browse],

  strip = frame {
    left: 0px,
    top: 662.5px,
    width: 316px,
    height: 45px,
    layout: {stack: {align-items: .center}},
    overflow: .clip,
    children: chips,

    chips = frame : mt.musicTools.filters.scroll {}
  }

  browse = frame : browseKnob {}
}

// ---- the floating layer (.ylayer), the whole bottom chrome ----
// A transparent 390 × 844 layer to lay over a phone frame (left 0, top 0).
// Its `dock` stacks the up line over the slot's row, 17 above the bottom.
// Rest: the sections pill (Home; pick the page's with `@with-variant` on
// `dock.row.spool.pill`) and the search knob. States: Disc (a song is
// loaded: the knob steps left of the player's disc), Bar (the player's bar
// holds the slot: the pill and the knob wait on the up line; paused too),
// Search (the search bar holds the slot, its chip row on the up line, the
// pill steps away), Menu (the pill unspooled into the sections), New
// (Studio: the + instead of search).
// Children: `dock` (`up` (`upPill`, `upKnob`, `float`), `row` (`spool`
// (`pill`, `menu`), `knobs` (`knob`, `disc`), `bar`, `search`)).
@variants(
  phoneLayerDisc,
  phoneLayerBar,
  phoneLayerSearch,
  phoneLayerMenu,
  phoneLayerNew
)
export phoneLayer = frame {
  title: "Floating layer · rest (pill · search knob)",
  left: 0px,
  top: 958px,
  width: spc.controls.phone-w,
  height: spc.controls.phone-h,
  children: dock,

  dock = frame {
    left: 0px,
    right: 0px,
    bottom: 0px,
    layout: {stack: {direction: .column, align-items: .stretch}},
    padding: [0px, spc.layout.slot-side, spc.layout.slot-bottom],
    children: [up, row],

    // the up line: what waits while the slot is held
    up = frame {
      height: spc.controls.slot,
      display: .none,
      layout: {stack: {justify-content: .space-between, align-items: .center}},
      padding-right: spc.layout.knob-up-r,
      children: [upPill, upKnob, float],

      upPill = frame : spl.sectionsPillUp {}

      upKnob = frame : searchKnobUp {}

      float = frame : filterFloat {
        width: 100%,
        display: .none
      }
    }

    // the slot's row: the closed knobs, or what fills the slot
    row = frame {
      height: spc.controls.slot,
      layout: {stack: {justify-content: .space-between, align-items: .center}},
      children: [spool, knobs, bar, search],

      // the pill; its menu rises 8 above it
      spool = frame {
        layout: {stack: {align-items: .center}},
        children: [pill, menu],

        pill = frame : spl.sectionsPill {}

        menu = frame : sectionsMenu {
          left: 0px,
          bottom: spc.layout.spool-menu-b,
          display: .none,
          ignore-stack: .true
        }
      }

      knobs = frame {
        layout: {stack: {align-items: .center, item-gap: spc.layout.knob-gap}},
        padding-right: spc.layout.knob-r,
        children: [knob, disc],

        knob = frame : searchKnob {}

        disc = frame : pp.playerDisc {
          display: .none
        }
      }

      bar = frame : pl.playerPhone {
        width: 100%,
        display: .none
      }

      search = frame : searchSlot {
        width: 100%,
        display: .none
      }
    }
  }
}

// A song is loaded (closed): the disc rests at the row's right end, the
// knob steps left of it.
export phoneLayerDisc = frame : phoneLayer {
  title: "Floating layer · disc (a song loaded)",
  left: 470px,
  top: 958px,

  dock {
    row {
      knobs {
        padding-right: 0px,

        disc {
          display: .visible
        }
      }
    }
  }
}

// The player's bar holds the slot; the pill and the knob wait on the up
// line.
@variants(phoneLayerBarPaused)
export phoneLayerBar = frame : phoneLayer {
  title: "Floating layer · the player's bar (playing)",
  left: 940px,
  top: 958px,

  dock {
    row {
      spool {
        display: .none
      }

      knobs {
        display: .none
      }

      bar {
        display: .visible
      }
    }

    up {
      display: .visible
    }
  }
}

export phoneLayerBarPaused = frame : phoneLayerBar {
  title: "Floating layer · the player's bar (paused)",
  left: 1410px,
  top: 958px,

  dock {
    row {
      @with-variant(pl.playerPhonePaused)
      bar {}
    }
  }
}

// Search open: the bar in the slot, the chip row on the up line; the pill
// steps away.
export phoneLayerSearch = frame : phoneLayer {
  title: "Floating layer · search open",
  left: 1880px,
  top: 958px,

  dock {
    up {
      upPill {
        display: .none
      }

      upKnob {
        display: .none
      }

      display: .visible,
      layout.stack.align-items: .end,
      padding-bottom: spc.layout.slot-gap,
      padding-right: 0px,

      float {
        display: .visible
      }
    }

    row {
      spool {
        display: .none
      }

      knobs {
        display: .none
      }

      search {
        display: .visible
      }
    }
  }
}

// The pill unspooled: the sections menu 8 above it, the caret down.
export phoneLayerMenu = frame : phoneLayer {
