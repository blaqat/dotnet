@variants(phoneNavStatesI10)
phoneNavStates = frame : doc.docBoard {
  title: "Phone nav · states · i9",
  left: 0px,
  top: 2034px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Phone nav · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-searchKnob, after = .nil),
      insert(st-searchKnobUp, after = st-searchKnob),
      insert(st-searchKnobOpen, after = st-searchKnobUp),
      insert(st-searchKnobCount, after = st-searchKnobOpen),
      insert(st-browseKnob, after = st-searchKnobCount),
      insert(st-newKnob, after = st-browseKnob)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-spoolRow, after = .nil),
      insert(st-spoolRowHere, after = st-spoolRow)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-searchSlot, after = .nil),
      insert(st-searchSlotTyped, after = st-searchSlot),
      insert(st-filterFloat, after = st-searchSlotTyped)
    ]
  }

  row-4 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-phoneLayer, after = .nil),
      insert(st-phoneLayerDisc, after = st-phoneLayer),
      insert(st-phoneLayerBar, after = st-phoneLayerDisc),
      insert(st-phoneLayerBarPaused, after = st-phoneLayerBar),
      insert(st-phoneLayerSearch, after = st-phoneLayerBarPaused),
      insert(st-phoneLayerMenu, after = st-phoneLayerSearch),
      insert(st-phoneLayerNew, after = st-phoneLayerMenu)
    ]
  }

  st-searchKnob = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "searchKnob"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the search knob · rest"
    }

    it = frame : searchKnob {}
  }

  st-searchKnobUp = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "searchKnobUp"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "up: on the line"
    }

    it = frame : searchKnobUp {}
  }

  st-searchKnobOpen = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "searchKnobOpen"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "open: unrolled"
    }

    it = frame : searchKnobOpen {}
  }

  st-searchKnobCount = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "searchKnobCount"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "with a filter count"
    }

    it = frame : searchKnobCount {}
  }

  st-browseKnob = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "browseKnob"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "browse (filters)"
    }

    it = frame : browseKnob {}
  }

  st-newKnob = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "newKnob"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Studio's new"
    }

    it = frame : newKnob {}
  }

  st-spoolRow = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "spoolRow"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a sections row"
    }

    it = frame : spoolRow {}
  }

  st-spoolRowHere = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "spoolRowHere"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "here"
    }

    it = frame : spoolRowHere {}
  }

  st-searchSlot = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "searchSlot"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "search in the slot · focused"
    }

    it = frame : searchSlot {}
  }

  st-searchSlotTyped = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "searchSlotTyped"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "typed"
    }

    it = frame : searchSlotTyped {}
  }

  st-filterFloat = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "filterFloat"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the chip row on the up line"
    }

    it = frame : filterFloat {}
  }

  st-phoneLayer = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "phoneLayer"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the floating layer · rest"
    }

    it = frame : phoneLayer {}
  }

  st-phoneLayerDisc = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "phoneLayerDisc"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a song loaded"
    }

    it = frame : phoneLayerDisc {}
  }

  st-phoneLayerBar = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "phoneLayerBar"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the bar · playing"
    }

    it = frame : phoneLayerBar {}
  }

  st-phoneLayerBarPaused = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "phoneLayerBarPaused"
    }

