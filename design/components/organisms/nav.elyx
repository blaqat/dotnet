import "tokens/color/sections.elyx" as sec
import "tokens/space/space.elyx" as spc
import "components/atoms/logo.elyx" as brandLogo
import "components/atoms/doc.elyx" as doc
import "components/molecules/nav-tab.elyx" as tab
import "assets/icons/bold/music-notes.svg" as musicIcon
import "assets/icons/fill/music-notes.svg" as musicIconFill
import "assets/icons/bold/cloud.svg" as thoughtsIcon
import "assets/icons/fill/cloud.svg" as thoughtsIconFill

// <yarn-nav> on desktop: the brand on the page column's left edge, the
// section tabs on its right edge (18 above, 8 below, 40 in from the sheet).
// Home is the brand, so with no section (or section=home) no tab is here.
// The tab of the page's section wears the HERE rope: each section has a
// contextual variant (`section=projects|music|thoughts`), so a top-level
// instance picks it from the canvas. Inside another component, pick it
// with `@with-variant(nav.navMusic)`. i9 → i10 is all tokens: the rope
// turns the section's hue and the other tabs' dots go grey until hover.
@variants(navProjects, navMusic, navThoughts, navPhone)
export nav = frame {
  title: "Nav · Home (no tab here)",
  left: 0px,
  top: 40px,
  width: 1412px,
  layout: {stack: {justify-content: .space-between, align-items: .center}},
  padding: [spc.layout.nav-top, spc.layout.page-x, spc.layout.nav-bottom],
  children: [brand, tabs],

  brand = frame : brandLogo.logo {}

  tabs = frame {
    layout: {stack: {align-items: .center, item-gap: spc.layout.nav-gap}},
    children: [projectsTab, musicTab, thoughtsTab],

    projectsTab = frame : tab.navTab {}

    musicTab = frame : tab.navTab {
      dot {
        fill[0].color: sec.section.hue-music,

        glyph {
          contents: musicIcon
        }
      }

      label {
        contents: "Music"
      }
    }

    thoughtsTab = frame : tab.navTab {
      dot {
        fill[0].color: sec.section.hue-thoughts,

        glyph {
          contents: thoughtsIcon
        }
      }

      label {
        contents: "Thoughts"
      }
    }
  }
}

@context(section="projects")
export navProjects = frame : nav {
  title: "Nav · Projects",
  left: 0px,
  top: 232px,

  tabs {
    @with-variant(tab.navTabHere)
    projectsTab {}
  }
}

@context(section="music")
export navMusic = frame : nav {
  title: "Nav · Music",
  left: 0px,
  top: 424px,

  tabs {
    @with-variant(tab.navTabHere)
    musicTab {
      dot {
        glyph {
          contents: musicIconFill
        }
      }
    }
  }
}

@context(section="thoughts")
export navThoughts = frame : nav {
  title: "Nav · Thoughts",
  left: 0px,
  top: 616px,

  tabs {
    @with-variant(tab.navTabHere)
    thoughtsTab {
      dot {
        glyph {
          contents: thoughtsIconFill
        }
      }
    }
  }
}

// Phones (< 960): the brand alone on the page column's left edge (14
// above, 4 below, 14 in); the tabs give way to the floating layer's
// sections pill (organisms/phone-nav.elyx), so no section variant is needed.
export navPhone = frame : nav {
  title: "Nav · phone (the brand)",
  left: 1692px,
  top: 40px,
  width: spc.controls.phone-w,
  padding-top: spc.layout.nav-top-phone,
  padding-left: spc.layout.page-x-phone,
  padding-bottom: spc.layout.nav-bottom-phone,
  padding-right: spc.layout.page-x-phone,

  tabs {
    display: .none
  }
}

// ==== states page (labels over the definitions, then the states boards: i9 · i10 · i11) ====
lbl-nav = text : doc.specLabel {
  left: 0px,
  top: 0px,
  contents: "nav"
}

note-nav = text : doc.specNote {
  left: 0px,
  top: 16px,
  contents: "desktop · Home here"
}

lbl-navPhone = text : doc.specLabel {
  left: 1692px,
  top: 0px,
  contents: "navPhone"
}

note-navPhone = text : doc.specNote {
  left: 1692px,
  top: 16px,
  contents: "phones: the top line (sections pill on the floating row)"
}

lbl-navProjects = text : doc.specLabel {
  left: 0px,
  top: 192px,
  contents: "navProjects"
}

note-navProjects = text : doc.specNote {
  left: 0px,
  top: 208px,
  contents: "section = projects"
}

lbl-navMusic = text : doc.specLabel {
  left: 0px,
  top: 384px,
  contents: "navMusic"
}

note-navMusic = text : doc.specNote {
  left: 0px,
  top: 400px,
  contents: "section = music"
}

lbl-navThoughts = text : doc.specLabel {
  left: 0px,
  top: 576px,
  contents: "navThoughts"
}

note-navThoughts = text : doc.specNote {
  left: 0px,
  top: 592px,
  contents: "section = thoughts"
}

@variants(navStatesI10, navStatesProjects, navStatesMusic, navStatesThoughts)
navStates = frame : doc.docBoard {
  title: "Nav · states · i9",
  left: 0px,
  top: 832px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [insert(row-1, after = .nil), insert(row-2, after = row-1)]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Nav · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-nav, after = .nil)]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-navPhone, after = .nil)]
  }

  st-nav = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "nav"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "desktop · Home here"
    }

    it = frame : nav {}
  }

  st-navPhone = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "navPhone"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "phones: the top line (sections pill on the floating row)"
    }

    it = frame : navPhone {}
  }
}

