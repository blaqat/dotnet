@variants(studioChromeStatesI10)
studioChromeStates = frame : doc.docBoard {
  title: "Studio chrome · states · i9",
  left: 0px,
  top: 2574px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3),
      insert(row-5, after = row-4),
      insert(row-6, after = row-5),
      insert(row-7, after = row-6),
      insert(row-8, after = row-7)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Studio chrome · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-studioTag, after = .nil)]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-studioNav, after = .nil)]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-studioNavMusic, after = .nil)]
  }

  row-4 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-studioNavThoughts, after = .nil)]
  }

  row-5 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-studioNavPhone, after = .nil)]
  }

  row-6 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-studioSheet, after = .nil)]
  }

  row-7 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-studioSheetMusic, after = .nil)]
  }

  row-8 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-studioSheetThoughts, after = .nil)]
  }

  st-studioTag = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "studioTag"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the Studio tag"
    }

    it = frame : studioTag {}
  }

  st-studioNav = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "studioNav"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Studio's nav · Dashboard"
    }

    it = frame : studioNav {}
  }

  st-studioNavMusic = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "studioNavMusic"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Music here"
    }

    it = frame : studioNavMusic {}
  }

  st-studioNavThoughts = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "studioNavThoughts"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Thoughts here"
    }

    it = frame : studioNavThoughts {}
  }

  st-studioNavPhone = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "studioNavPhone"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "phones"
    }

    it = frame : studioNavPhone {}
  }

  st-studioSheet = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "studioSheet"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Studio's sheet · Dashboard"
    }

    it = frame : studioSheet {}
  }

  st-studioSheetMusic = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "studioSheetMusic"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Music here"
    }

    it = frame : studioSheetMusic {}
  }

  st-studioSheetThoughts = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "studioSheetThoughts"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Thoughts here"
    }

    it = frame : studioSheetThoughts {}
  }
}

