    headline = text : txt.titleCard {
      width: 100%,
      contents: "My favorite browsers, ranked",
      font-size: typ.sizes.post-title-list,
      letter-spacing: typ.tracking.post-title
    }
  }

  view = frame : segm.seg {
    @with-variant(segm.segBtn)
    grid {
      glyph {
        contents: everyoneIcon
      }

      label {
        contents: "Everyone"
      }
    }

    @with-variant(segm.segBtnPicked)
    timeline {
      glyph {
        display: .none
      }

      label {
        contents: "Mine"
      }
    }
  }

  tiers = frame {
    width: 100%,
    layout: {stack: {direction: .column, item-gap: spc.steps.s1}},
    children: [rS, rA, rB, rC, rD],

    rS = frame : postTier {
      width: 100%
    }

    rA = frame : postTier {
      width: 100%,

      key {
        fill[0].color: pal.palette.tier-a,

        letter {
          fill[0].color: col.roles.fg,
          contents: "A"
        }
      }

      tray {
        i1 {
          dot {
            fill[0].color: pal.palette.tier-a
          }

          name {
            contents: "Zen"
          }
        }

        i2 {
          dot {
            fill[0].color: pal.palette.tier-a
          }

          name {
            contents: "Arc"
          }

          display: .visible
        }
      }
    }

    rB = frame : postTier {
      width: 100%,

      key {
        fill[0].color: pal.palette.tier-b,

        letter {
          fill[0].color: col.roles.fg,
          contents: "B"
        }
      }

      tray {
        i1 {
          dot {
            fill[0].color: pal.palette.tier-b
          }

          name {
            contents: "Firefox"
          }
        }

        i2 {
          dot {
            fill[0].color: pal.palette.tier-b
          }

          name {
            contents: "Safari"
          }

          display: .visible
        }

        i3 {
          dot {
            fill[0].color: pal.palette.tier-b
          }

          name {
            contents: "Orion"
          }

          display: .visible
        }
      }
    }

    rC = frame : postTier {
      width: 100%,

      key {
        fill[0].color: pal.palette.tier-c,

        letter {
          fill[0].color: col.roles.fg,
          contents: "C"
        }
      }

      tray {
        i1 {
          dot {
            fill[0].color: pal.palette.tier-c
          }

          name {
            contents: "Vivaldi"
          }
        }

        i2 {
          dot {
            fill[0].color: pal.palette.tier-c
          }

          name {
            contents: "Brave"
          }

          display: .visible
        }
      }
    }

    rD = frame : postTier {
      width: 100%,

      key {
        fill[0].color: pal.palette.tier-d,

        letter {
          fill[0].color: col.roles.fg,
          contents: "D"
        }
      }

      tray {
        i1 {
          dot {
            fill[0].color: pal.palette.tier-d
          }

          name {
            contents: "Chrome"
          }
        }

        i2 {
          dot {
            fill[0].color: pal.palette.tier-d
          }

          name {
            contents: "Edge"
          }

          display: .visible
        }
      }
    }
  }

  writeup = frame : postWriteup {
    count {
      contents: "3 min"
    }
  }

  actions = frame {
    width: 100%,
    layout: {stack: {align-items: .center, item-gap: spc.steps.s2}},
    children: [add, comments],

    add = frame : btns.btnSm {
      border[0].color: col.roles.act-line,
      fill[0].color: col.roles.act-bg,

      btnStitch {
        border[0].color: col.roles.ctl-stitch-fill
      }

      glyph {
        fill[0].color: col.roles.act-fg,
        contents: plusIcon
      }

      label {
        fill[0].color: col.roles.act-fg,
        contents: "Add your ranking"
      }
    }

    comments = frame : btns.btnGhost {
      height: spc.controls.btn-sm,
      padding-left: spc.layout.btn-sm-x,
      padding-right: spc.layout.btn-sm-x,

      glyph {
        width: spc.controls.icon-sm,
        height: spc.controls.icon-sm,
        contents: commentIcon,
        display: .visible
      }

      label {
        contents: "4 comments",
        font-size: typ.sizes.label-card
      }
    }
  }

  foot = frame {
    width: 100%,
    height: spc.controls.post-foot-h,
    children: tags,

    tags = frame : postTags {
      left: spc.layout.tag-pull,
      top: 0px,

      t1 {
        label {
          contents: "browsers"
        }
      }

      t2 {
        label {
          contents: "ranked"
        }
      }
    }
  }
}

