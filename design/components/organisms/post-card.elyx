      }

      dek = text : txt.bodyCard {
        width: 100%,
        contents: "Stuff I've been writing to. Mostly mine, sorry."
      }

      count = text : txt.metaCard {
        contents: "4 tracks · 10:11"
      }
    }
  }

  tracks = frame {
