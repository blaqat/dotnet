// A playlist: the record leads its head, the track rows under a dashed
// rule, then Play all (the kit's play part) and the tags. Children:
// `kicker`, `head` (`record` (`grooves`, `label` > `cat`), `info`
// (`headline`, `dek`, `count`)), `tracks` (`tr1`…`tr4`), `foot`.
export postPlaylist = frame : surf.patch {
  title: "Playlist",
  left: 1206px,
  top: 987px,
  width: spc.controls.post-w,
  min-height: .nil,
  layout.stack.item-gap: spc.layout.post-gap,
  overrides: [
    insert(kicker, after = surf.patch.patchStitch),
    insert(head, after = kicker),
    insert(tracks, after = head),
    insert(foot, after = tracks)
  ],

  kicker = frame : postKicker {
