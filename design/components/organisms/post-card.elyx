// Thoughts' post cards (kit/posts.js, Y.post). Every card reads, top to
// bottom: the kicker (`postKicker`: the type in its felt circle, the read
// time, the date on the right), the title, the dek, an about / write-up
// pill, then the foot (the tags; "Read →" on an article until i11 T8 cut
// it). The kicker's words are content: i9 writes them "2 min read" and
// "Nov 7" (Maple Mono), i10+ "· 2 MIN" and "NOV 7" (Micro caps), so a
// screen restates them in its i10 variant.
// Types: `postArticle` (+ `postArticleCover`), `postNote` (a scratch on a
// sticky note, + colours), `postPick` (a hang tag on red yarn), `postPlaylist`
// (record + track rows + Play all), `postImages` (1 + 3 · 2 · 1 + 2),
// `postRanking` (a mini felt board). Bookmarks (the ribbon, the yarn) stay
// the `mark` red everywhere; gold (`sec.section` on Thoughts) is the shelf
// pill only. Owner colours (note paper, pick stub, tier felts) are content.
// i9 → i10 is tokens except the pick's links (`postPickI10`); i11 cuts the
// article's "Read →" (`postArticleI11`, `postArticleCoverI11`).
// ---- parts ----------------------------------------------------------------
// The kicker. Children: `lead` (`badge` (`disc` > `glyph`, `kind`), `extra`
// (`sep` (the i10 ·), `xGlyph`, `x`)), `date`. Hide `lead.extra` when a type
// has no read time; show `xGlyph` for a ranking's people.
export postKicker = frame {
  title: "Post · kicker",
  left: 0px,
  top: 40px,
  width: spc.controls.post-w,
  min-height: spc.controls.kick-h,
  layout: {
    stack: {
      justify-content: .space-between,
      align-items: .center,
      item-gap: spc.steps.s2
    }
  },
  children: [lead, date],

  lead = frame {
    layout: {stack: {align-items: .center, item-gap: spc.layout.kick-x-gap}},
    children: [badge, extra],

    badge = frame {
      layout: {stack: {align-items: .center, item-gap: spc.layout.chip-gap}},
      children: [disc, kind],

      disc = frame {
        width: spc.controls.kick-badge,
        height: spc.controls.kick-badge,
        layout: {stack: {justify-content: .center, align-items: .center}},
        fill: col.roles.recess,
        shadow: {
          inner-shadow: {
            color: col.roles.line,
            offset: point(0px, 0px),
            blur-radius: 0px,
            spread: 1px
          }
        },
        corner-radius: spc.radii.pill,
        children: glyph,

        glyph = asset {
          width: spc.controls.kick-badge-icon,
          height: spc.controls.kick-badge-icon,
          fill: col.roles.kick,
          contents: articleIcon
        }
      }

      kind = text : txt.micro {
        contents: "ARTICLE",
        letter-spacing: typ.tracking.caps,
        fill[0].color: col.roles.kick
      }
    }

    extra = frame {
      layout: {stack: {align-items: .center, item-gap: spc.steps.s1}},
      children: [sep, xGlyph, x],

      sep = text : txt.micro {
        contents: "·",
        font-size: typ.sizes.kick-x,
        font-family: typ.faces.kick-x,
        font-style: typ.faces.kick-x-style,
        fill[0].color: col.roles.kick-sep
      }

      xGlyph = asset {
        width: spc.controls.kick-badge-icon,
        height: spc.controls.kick-badge-icon,
        display: .none,
        fill: col.roles.fg-3,
        contents: usersIcon
      }

      x = text : txt.micro {
        contents: "2 min read",
        font-size: typ.sizes.kick-x,
        font-family: typ.faces.kick-x,
        font-style: typ.faces.kick-x-style,
        letter-spacing: typ.tracking.kick-x,
        fill[0].color: col.roles.fg-3
      }
    }
  }

  date = text : txt.micro {
    contents: "Nov 7",
    font-size: typ.sizes.kick-x,
    font-family: typ.faces.kick-x,
    font-style: typ.faces.kick-x-style,
    letter-spacing: typ.tracking.kick-x,
    fill[0].color: col.roles.fg-3
  }
}

// The about pill (.yabout): what a post is about, on the recess, the
// control's stitch (i9) or ring (i10). "about" + a glyph + the name + →.
// `tier` (a tiny felt key) replaces the glyph for a ranked thing.
@variants(postWriteup)
export postAbout = frame : chips.chipSm {
  title: "Post · about pill",
  left: 402px,
  top: 40px,
  fill[0].color: col.roles.recess,
  overrides: [
    insert(key, after = chips.chip.chipStitch),
    insert(tier, after = chips.chip.glyph),
    insert(go, after = chips.chip.count)
  ],
  shadow[0].drop-shadow.visible: .false,
  shadow[1].drop-shadow.visible: .false,

  label {
    fill[0].color: col.roles.fg,
    contents: "Ghostty",
    font-size: typ.sizes.label-card
  }

  count {
    fill[0].color: col.roles.fg-3
  }

  glyph {
    width: spc.controls.kick-badge-icon,
    height: spc.controls.kick-badge-icon,
    contents: pickIcon
  }

  key = text : txt.metaCard {
    contents: "about"
  }

  tier = frame {
    width: spc.controls.fact-wip,
    height: spc.controls.fact-wip,
    display: .none,
    layout: {stack: {justify-content: .center, align-items: .center}},
    fill: [
      pal.palette.tier-s,
      {image: {ref: twillTexture, sizing: {scale: 1, offset: [0px, 0px]}}}
    ],
    corner-radius: spc.radii.kbd,
    children: tierLetter,

    tierLetter = text : txt.micro {
      contents: "S",
      fill[0].color: col.roles.dark-fg
    }
  }

  go = asset {
    width: spc.controls.kick-badge-icon,
    height: spc.controls.kick-badge-icon,
    fill: col.roles.fg-2,
    contents: goIcon
  }
}

// The write-up pill (.yabout--wu): the scroll, "Write-up", its read time.
export postWriteup = frame : postAbout {
  title: "Post · write-up pill",
  left: 804px,
  top: 40px,

  key {
    display: .none
  }

  glyph {
    contents: writeupIcon
  }

  label {
    contents: "Write-up"
  }

  count {
    display: .visible,
    contents: "2 min"
  }
}

// A go-link (.ypost__go, .ypost__coll): the link role's words + →. i9 red
// words; i10 ink words on a 1.5px underline (col.roles.go-line).
export postGo = frame {
  title: "Post · go link",
  left: 1206px,
  top: 40px,
  layout: {stack: {align-items: .center, item-gap: spc.layout.btn-d-gap}},
  children: [words, arrow],

  words = frame {
    layout: {stack: {}},
    border: {
      color: col.roles.go-line,
      width: spc.layout.stitch-w-sm,
      sides: .bottom
    },
    padding-bottom: 2px,
    children: label,

    label = text : txt.labelCard {
      contents: "Read",
      fill[0].color: col.roles.link
    }
  }

  arrow = asset {
    width: spc.controls.icon-sm,
    height: spc.controls.icon-sm,
    fill: col.roles.link,
    contents: goIcon
  }
}

// The red twill bookmark (an article): 20 × 40, notched, sewn.
export postRibbon = frame {
  title: "Post · bookmark",
  left: 1608px,
  top: 40px,
  width: spc.controls.ribbon-w,
  height: spc.controls.ribbon-h,
  children: [cloth, sewing],

  cloth = asset {
    left: 0px,
    top: 0px,
    width: spc.controls.ribbon-w,
    height: spc.controls.ribbon-h,
    fill: col.roles.mark,
    shadow: {
      drop-shadow: {
        color: pal.palette.shadow-lift,
        offset: point(0px, 1px),
        blur-radius: 0px
      }
    },
    contents: ribbonShape
  }

  sewing = asset {
    left: 0px,
    top: 0px,
    width: spc.controls.ribbon-w,
    height: spc.controls.ribbon-h,
    contents: ribbonSew
  }
}

// A card's tags (pressable): pulled out by their own inset from i10 so the
// # lines up with the words above. Hide `t3` (or `t2`) for fewer.
export postTags = frame {
  title: "Post · tags",
  left: 1747px,
  top: 40px,
  layout: {stack: {align-items: .center, item-gap: spc.steps.s1}},
  children: [t1, t2, t3],

  t1 = frame : tg.tagPress {
    label {
      contents: "tools"
    }
  }

  t2 = frame : tg.tagPress {
    label {
      contents: "terminal"
    }
  }

  t3 = frame : tg.tagPress {
    display: .none,

    label {
      contents: "design"
    }
  }
}

// ---- article --------------------------------------------------------------
// An article: a patch with the red bookmark. Children: `body` (`head`
// (`kicker`, `words` (`headline`, `dek`)), `about`, `foot` (`tags`, `go`)),
// `ribbon`. Hide `body.about` when it's about nothing.
@variants(postArticleCover, postArticleI11)
export postArticle = frame : surf.patch {
  title: "Article",
  left: 0px,
  top: 200px,
  width: spc.controls.post-w,
  min-height: .nil,
  padding-top: 0px,
  padding-left: 0px,
  padding-bottom: 0px,
  padding-right: 0px,
  layout.stack.item-gap: 0,
  overrides: [
    insert(body, after = surf.patch.patchStitch),
    insert(ribbon, after = body)
  ],

  body = frame {
    width: 100%,
    layout: {stack: {direction: .column, item-gap: spc.layout.post-gap}},
    padding: [spc.layout.inset-y, spc.layout.inset-x],
    children: [head, about, foot],

    head = frame {
      width: 100%,
      layout: {stack: {direction: .column, item-gap: spc.layout.post-kick}},
      children: [kicker, words],

      kicker = frame : postKicker {
        width: 100%,
        padding-right: spc.layout.kick-clear
      }

      words = frame {
        width: 100%,
        layout: {stack: {direction: .column, item-gap: spc.layout.post-dek}},
        children: [headline, dek],

        headline = text : txt.titleCard {
          width: 100%,
          contents: "Ghostty, three months in",
          font-size: typ.sizes.post-title,
          letter-spacing: typ.tracking.post-title
        }

        dek = text : txt.bodyCard {
          width: 100%,
          contents: "The terminal I stopped tweaking."
        }
      }
    }

    about = frame : postAbout {}

    foot = frame {
      width: 100%,
      height: spc.controls.post-foot-h,
      layout: {stack: {justify-content: .end, align-items: .center}},
      children: [tags, go],

      tags = frame : postTags {
        left: spc.layout.tag-pull,
        top: 0px,
        ignore-stack: .true
      }

      go = frame : postGo {}
    }
  }

  ribbon = frame : postRibbon {
    top: 0px,
    right: spc.layout.ribbon-r,
    ignore-stack: .true
  }
}

// With a cover (2 : 1): i9 / i10 flush with the top, 8 in; i11 on the inset.
@variants(postArticleCoverI11)
export postArticleCover = frame : postArticle {
  title: "Article · cover",
  left: 402px,
  top: 200px,
  overrides: [insert(cover, after = surf.patch.patchStitch)],

  body {
    about {
      display: .none
    }

    head {
      words {
        headline {
          contents: "Moving a site from Astro to SvelteKit without losing the music"
        }

        dek {
          contents: "One <audio> element, a root layout, and why the player kept restarting."
        }
      }

      kicker {
        padding-right: 0px
      }
    }

    foot {
      tags {
        t1 {
          label {
            contents: "svelte"
          }
        }

        t2 {
          label {
            contents: "learnings"
          }
        }
      }
    }
  }

  cover = frame {
    width: 100%,
    layout: {stack: {}},
    padding: [spc.layout.cover-top, spc.layout.cover-x, 0px],
    children: coverArt,

    coverArt = frame {
      width: 100%,
      height: spc.controls.cover-h,
      fill: [col.roles.recess, {image: {ref: sitePlanImage}}],
      corner-radius: spc.radii.art,
      overflow: .clip
    }
  }
}

// i11 T8: the card is the link, so "Read →" is cut.
@context(i10="on", i11="on")
export postArticleI11 = frame : postArticle {
  title: "Article · i11 (no Read →)",
  left: 804px,
  top: 200px,

  body {
    foot {
      go {
        display: .none
      }
    }
  }
}

@context(i10="on", i11="on")
export postArticleCoverI11 = frame : postArticleCover {
  title: "Article · cover · i11",
  left: 1206px,
  top: 200px,

  body {
    foot {
      go {
        display: .none
      }
    }
  }
}

// ---- scratch (a sticky note) -----------------------------------------------
// A scratch: the owner's quote on a sticky note under a strip of tape.
// Paper colours are content (canary, pink, mint, sky). Children: `tapeStrip`
// (> `tape`), `kicker`, `quote`, `foot` (> `tags`).
@variants(postNotePink, postNoteMint, postNoteSky)
export postNote = frame {
  title: "Scratch · canary",
  left: 0px,
  top: 713px,
  width: spc.controls.post-w,
  layout: {stack: {direction: .column, item-gap: spc.layout.post-gap}},
  fill: pal.palette.note-canary,
  shadow: [
    {
      drop-shadow: {
        color: pal.palette.note-edge,
        offset: point(0px, 1px),
        blur-radius: 1px
      }
    },
    {
      drop-shadow: {
        color: pal.palette.note-drop,
        offset: point(0px, 7px),
        blur-radius: 12px,
        spread: -9px
      }
    }
  ],
  corner-radius: [
    spc.radii.note,
    spc.radii.note,
    spc.radii.note-curl,
    spc.radii.note
  ],
  padding: [spc.layout.note-top, spc.layout.note-x, spc.layout.note-bottom],
  children: [tapeStrip, kicker, quote, foot],

  tapeStrip = frame {
    left: 0px,
    top: spc.layout.tape-top,
    right: 0px,
    height: spc.controls.tape-h,
    ignore-stack: .true,
    layout: {stack: {justify-content: .center}},
    children: tape,

    tape = asset {
      width: spc.controls.tape-w,
      height: spc.controls.tape-h,
      contents: tapeArt
    }
  }

  kicker = frame : postKicker {
    width: 100%,

    lead {
      badge {
        disc {
          fill[0].color: pal.palette.note-chip,

          glyph {
            fill[0].color: pal.palette.note-canary-fg,
            contents: scratchIcon
          }
        }

        kind {
          fill[0].color: pal.palette.note-canary-fg,
          contents: "SCRATCH"
        }
      }

      extra {
        display: .none
      }
    }

    date {
      fill[0].color: pal.palette.note-canary-fg-3,
      contents: "Nov 7 · 11:41 pm"
    }
  }

  // the quote is a Title; its opening mark sits inline in the deco colour
  quote = text : txt.titleCard {
    width: 100%,
    contents: "“what if every website had a little cat that judged your scroll speed",
    font-size: typ.sizes.quote,
    line-height: typ.leading.quote,
    fill[0].color: col.roles.fg,
    subrange[0].fill[0].color: col.roles.deco,
    subrange[0].range: [0, 1]
  }

  foot = frame {
    width: 100%,
    height: spc.controls.post-foot-h,
    children: tags,

    tags = frame : postTags {
      left: spc.layout.tag-pull,
      top: 0px,

      t1 {
        label {
          fill[0].color: pal.palette.note-canary-fg-3,
          contents: "shower"
        }

        hash {
          fill[0].color: pal.palette.note-canary-fg-3
        }
      }

      t2 {
        display: .none
      }
    }
  }
}

