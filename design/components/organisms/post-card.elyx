  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-postKicker, after = .nil),
      insert(st-postAbout, after = st-postKicker),
      insert(st-postWriteup, after = st-postAbout),
      insert(st-postGo, after = st-postWriteup),
      insert(st-postRibbon, after = st-postGo),
      insert(st-postTags, after = st-postRibbon)
    ]
