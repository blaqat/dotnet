postCardStates = frame : doc.docBoard {
  title: "Post cards · states · i9",
  left: 0px,
  top: 2734px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3),
      insert(row-5, after = row-4)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Post cards · every state"
    }
