// ---- pick (a hang tag on a loop of red yarn) ---------------------------------
// A pick: the owner's stub on the left (content colour: tan knit; ink, red,
// blue twill), the eyelet + the red yarn, then the text past the stub.
// i9: the link in mono with ↗ after, the shelf a gold pill; i10
// (`postPickI10`): the link a small link button, the shelf plain words.
// Children: `stub`, `eyelet`, `yarn` (`strand`, `twist`, `knot`), `head`
// (`kicker`, `words`), `writeup` (hidden), `foot` (`links` (`ext`, `extBtn`,
// `coll`), `tags`). Recolour the stub: `stub { fill[0].color: … }` and show
// its twill (`fill[1].visible`).
@variants(postPickI10)
export postPick = frame : surf.patch {
  title: "Pick",
  left: 0px,
  top: 987px,
  width: spc.controls.post-w,
  min-height: .nil,
  corner-radius: [spc.radii.art, spc.radii.card, spc.radii.card, spc.radii.art],
  padding-top: spc.layout.pick-y,
  padding-left: spc.layout.pick-l,
  padding-bottom: spc.layout.pick-y,
  padding-right: spc.layout.pick-r,
  layout.stack.item-gap: spc.layout.post-gap,
  overrides: [
    insert(stub, after = .nil),
    insert(eyelet, after = stub),
    insert(head, after = surf.patch.patchStitch),
    insert(writeup, after = head),
    insert(foot, after = writeup),
    insert(yarn, after = foot)
  ],

  patchStitch {
    left: spc.controls.stub
  }

  stub = frame {
    left: 0px,
    top: 0px,
    bottom: 0px,
    width: spc.controls.stub,
    ignore-stack: .true,
    fill: [
      pal.palette.stub-tan,
      {
        visible: .false,
        image: {ref: twillTexture, sizing: {scale: 1, offset: [0px, 0px]}}
      }
    ],
    border: {
      color: pal.palette.stub-tan-seam,
      width: spc.layout.stitch-w-sm,
      dash: [4px, 3px],
      sides: .right
    },
    corner-radius: [spc.radii.art, 0px, 0px, spc.radii.art]
  }

  eyelet = frame {
    left: 11px,
    top: spc.layout.inset-y,
    width: spc.controls.eyelet,
    height: spc.controls.eyelet,
    ignore-stack: .true,
    fill: col.roles.sheet,
    border: [
      {color: col.roles.surface, width: 2.5px, position: .outside},
      {color: pal.palette.stitch, position: .outside}
    ],
    shadow: {
      inner-shadow: {
        color: pal.palette.shadow-lift,
        offset: point(0px, 1px),
        blur-radius: 2px
      }
    },
    corner-radius: spc.radii.pill
  }

  yarn = frame {
