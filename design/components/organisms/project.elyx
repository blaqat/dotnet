@variants(projectStatesI10)
projectStates = frame : doc.docBoard {
  title: "Project · states · i9",
  left: 0px,
  top: 1368px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Project · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-project, after = .nil),
      insert(st-projectText, after = st-project)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-projectRow, after = .nil),
      insert(st-projectRowPicked, after = st-projectRow)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-writeup, after = .nil),
      insert(st-writeupMark, after = st-writeup)
    ]
