            wu {
              display: .visible
            }
          }
        }
      }

      info {
        main {
          descBox {
            desc {
              contents: "Developed a FreeRTOS-based real-time simulation of a bank environment, leveraging a multifunction shield on a STM32 microcontroller for displaying and managing customer queues and teller operations on an LCD…."
