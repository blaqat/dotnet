@variants(detailStatesI10)
detailStates = frame : doc.docBoard {
  title: "Detail shell + parts · states · i9",
  left: 0px,
  top: 1250px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3),
      insert(row-5, after = row-4),
      insert(row-6, after = row-5),
      insert(row-7, after = row-6),
      insert(row-8, after = row-7)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Detail shell + parts · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-detailBack, after = .nil),
      insert(st-detailNavDisc, after = st-detailBack),
      insert(st-detailNavDiscOff, after = st-detailNavDisc),
      insert(st-asideFact, after = st-detailNavDiscOff),
      insert(st-tocItem, after = st-asideFact),
      insert(st-tocItemCurrent, after = st-tocItem),
      insert(st-tocItemSub, after = st-tocItemCurrent)
