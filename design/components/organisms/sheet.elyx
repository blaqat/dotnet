note-filledExample = text : doc.specNote {
  left: 0px,
  top: 1183px,
  contents: "filled as a screen fills it (follows the section)"
}

@variants(
  sheetStatesI10,
  sheetStatesProjects,
  sheetStatesMusic,
  sheetStatesThoughts
)
sheetStates = frame : doc.docBoard {
  title: "Sheet · states · i9",
  left: 0px,
  top: 2077px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [insert(row-1, after = .nil), insert(row-2, after = row-1)]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Sheet · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-sheet, after = .nil),
      insert(st-sheetPhone, after = st-sheet)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-filledExample, after = .nil)]
  }

  st-sheet = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "sheet"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the cord frame + sheet (Home)"
    }

    it = frame : sheet {}
  }

  st-sheetPhone = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "sheetPhone"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "phones"
    }

    it = frame : sheetPhone {}
  }

  st-filledExample = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "filledExample"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "filled as a screen fills it (follows the section)"
    }

    it = frame : filledExample {}
  }
}

