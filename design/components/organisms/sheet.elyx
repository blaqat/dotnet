import "tokens/color/roles.elyx" as col
import "tokens/color/palette.elyx" as pal
import "tokens/color/sections.elyx" as sec
import "tokens/space/space.elyx" as spc
import "components/atoms/surface.elyx" as surf
import "components/atoms/doc.elyx" as doc
import "components/organisms/nav.elyx" as nav
import "components/organisms/page-header.elyx" as head
import "assets/textures/cord.svg" as cordTexture
import "components/molecules/sound-tag.elyx" as snd

// The page (`body.frame > main.sheet`): the section-coloured cord frame
// (14px) around the cotton sheet (radius 22, its stitch 9px in), the nav
// on top, then `page`: the content column (`.ypage`, 40px gutters, 6 above,
// 56 below) with `section-gap` between its sections (i9/i10 24, i11 48).
// A screen fills `paper.page`:
//   paper { page { overrides: [insert(header, after = .nil), insert(list, after = header)] } }
// The section's variant (`section=projects|music|thoughts`) puts the HERE
// rope on its nav tab; a top-level instance picks it from the canvas.
@variants(sheetProjects, sheetMusic, sheetThoughts, sheetPhone)
export sheet = frame {
  title: "Sheet · page template (Home: no tab here)",
  left: 0px,
  top: 40px,
  width: 1440px,
  layout: {stack: {direction: .column, align-items: .stretch}},
  fill: [
    sec.section.sec,
    {image: {ref: cordTexture, sizing: {scale: 3.24, offset: [0px, 0px]}}}
  ],
  padding: spc.layout.frame,
  children: paper,

  // the cotton sheet
  paper = frame {
    layout: {stack: {direction: .column, align-items: .stretch}},
    fill: col.roles.sheet,
    shadow: [
      {
        inner-shadow: {
          color: pal.palette.shadow-1,
          offset: point(0px, 0px),
          blur-radius: 0px,
          spread: 1px
        }
      },
      {
        drop-shadow: {
          color: pal.palette.shadow-lift,
          offset: point(0px, 3px),
          blur-radius: 10px
        }
      }
    ],
    corner-radius: spc.radii.page,
    children: [paperStitch, sheetNav, page],

    paperStitch = frame : surf.stitch {
      left: spc.layout.sheet-stitch-in,
      top: spc.layout.sheet-stitch-in,
      right: spc.layout.sheet-stitch-in,
      bottom: spc.layout.sheet-stitch-in,
      width: .nil,
      height: .nil,
      ignore-stack: .true,
      corner-radius: spc.radii.page-stitch,
      border[0].color: col.roles.line
    }

    sheetNav = frame : nav.nav {
      width: 100%
    }

    // the content column: insert the page's sections here, top to bottom
    page = frame {
      layout: {
        stack: {
          direction: .column,
          align-items: .stretch,
          item-gap: spc.layout.section-gap
        }
      },
      padding: [spc.layout.page-top, spc.layout.page-x, spc.layout.page-bottom]
    }
  }
}

@context(section="projects")
export sheetProjects = frame : sheet {
  title: "Sheet · Projects",
  left: 0px,
  top: 361px,

  paper {
    @with-variant(nav.navProjects)
    sheetNav {}
  }
}

