// Filled, as a screen fills it: the header, then two placeholder sections
// (the tools line, the list) one section-gap apart. An instance, so it takes
// the canvas's section (render with `--context section=music`).
filledExample = frame : sheet {
  title: "Sheet · filled (example; follows the canvas section)",
  left: 0px,
  top: 1207px,

  paper {
    page {
      overrides: [
        insert(exampleHeader, after = .nil),
        insert(exampleTools, after = exampleHeader),
        insert(exampleList, after = exampleTools)
      ]
    }
  }

  exampleHeader = frame : head.pageHeader {
    width: .nil
  }

  exampleTools = frame {
    height: spc.controls.field,
    fill: col.roles.recess,
    corner-radius: spc.radii.pill
  }

  exampleList = frame {
    height: 360px,
    fill: col.roles.recess,
    corner-radius: spc.radii.card
  }
}

// ---- phones (< 960) ----
// The page on a 390 phone: the cord frame 7, the sheet's corners 16 (its
// stitch 7), the nav down to the brand (`navPhone`: the sections live in
// the floating layer, organisms/phone-nav.elyx), the sound tag hanging 14
// in from the right edge, the page column 14 in (`page-x-phone`) with the
// phone's section gap (i9 / i10 20, i11 32). One sheet for every section:
// the frame's hue is the canvas's `section`. A phone frame sets the
// sheet's height and lays the floating layer over it.
// Children: as the sheet's, plus `soundRow` (`soundTag`).
export sheetPhone = frame : sheet {
  title: "Sheet · phone (390)",
  left: 1728px,
  top: 40px,
  width: spc.controls.phone-w,
  padding-top: spc.layout.frame-phone,
  padding-left: spc.layout.frame-phone,
  padding-bottom: spc.layout.frame-phone,
  padding-right: spc.layout.frame-phone,

  paper {
    overrides: [insert(soundRow, after = sheet.paper.page)],

    page {
      layout.stack.item-gap: spc.layout.section-gap-phone,
      padding-top: 0px,
      padding-left: spc.layout.page-x-phone,
      padding-bottom: spc.layout.page-bottom-phone,
      padding-right: spc.layout.page-x-phone
    }

    corner-radius: spc.radii.page-phone,

    @with-variant(nav.navPhone)
    sheetNav {}

    paperStitch {
      corner-radius: spc.radii.page-stitch-phone
    }
  }

  // the sound tag: top right on phones
  soundRow = frame {
    left: 0px,
    top: 0px,
    right: 0px,
    ignore-stack: .true,
    layout: {stack: {justify-content: .end}},
    padding-right: spc.layout.sound-r-phone,
    children: soundTag,

    soundTag = frame : snd.soundTag {}
  }
}

