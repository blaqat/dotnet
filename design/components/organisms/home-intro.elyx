@variants(homeIntroStatesI10)
homeIntroStates = frame : doc.docBoard {
  title: "Home intro · states · i9",
  left: 0px,
  top: 1194px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Home intro · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-lockup, after = .nil),
      insert(st-lockupPhone, after = st-lockup)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-leadText, after = .nil)]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-intro, after = .nil),
      insert(st-introPhone, after = st-intro)
    ]
  }

  row-4 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-bio, after = .nil),
      insert(st-bioPhone, after = st-bio)
    ]
  }

  st-lockup = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "lockup"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the name lockup"
    }

    it = asset : lockup {}
  }

  st-lockupPhone = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "lockupPhone"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "phones"
    }

    it = asset : lockupPhone {}
  }

  st-leadText = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "leadText"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the lead line"
    }

    it = text : leadText {}
  }

  st-intro = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "intro"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the intro (lockup + lead)"
    }

    it = frame : intro {}
  }

  st-introPhone = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "introPhone"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "phones"
    }

    it = frame : introPhone {}
  }

  st-bio = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "bio"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the bio"
    }

    it = frame : bio {}
  }

  st-bioPhone = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "bioPhone"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "phones"
    }

    it = frame : bioPhone {}
  }
}

@variants(homeIntroStatesI11)
@context(i10="on")
homeIntroStatesI10 = frame : homeIntroStates {
  title: "Home intro · states · i10",
  left: 1380px,
  top: 1194px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }
}

@context(i10="on", i11="on")
homeIntroStatesI11 = frame : homeIntroStatesI10 {
  title: "Home intro · states · i11",
  left: 2760px,
  top: 1194px,

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
    }
  }
}
