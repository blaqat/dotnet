@variants(surfaceStatesI10)
surfaceStates = frame : doc.docBoard {
  title: "Surfaces · states · i9",
  left: 0px,
  top: 672px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Surfaces · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-stitch, after = .nil),
      insert(st-disc, after = st-stitch),
      insert(st-focusRing, after = st-disc)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-patch, after = .nil),
      insert(st-patchLifted, after = st-patch)
    ]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-rope, after = .nil),
      insert(st-ropeHere, after = st-rope)
    ]
  }

  st-stitch = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "stitch"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the dashed stitch"
    }

    it = frame : stitch {}
  }

  st-disc = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "disc"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a round felt base"
    }

    it = frame : disc {}
  }

  st-focusRing = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "focusRing"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "focus (keys): the ink ring"
    }

    it = frame : focusRing {}
  }

  st-patch = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "patch"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "a card's cloth · rest"
    }

    it = frame : patch {}
  }

  st-patchLifted = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "patchLifted"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "hover: lifts"
    }

    it = frame : patchLifted {}
  }

  st-rope = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "rope"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "pick: a single choice"
    }

    it = frame : rope {}
  }

  st-ropeHere = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "ropeHere"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "here: the nav's current tab"
    }

    it = frame : ropeHere {}
  }
}

@variants(surfaceStatesI11)
@context(i10="on")
surfaceStatesI10 = frame : surfaceStates {
  title: "Surfaces · states · i10",
  left: 912px,
  top: 672px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }
}

@context(i10="on", i11="on")
surfaceStatesI11 = frame : surfaceStatesI10 {
  title: "Surfaces · states · i11",
  left: 1824px,
  top: 672px,

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
    }
  }
}
