@variants(textStatesI10)
textStates = frame : doc.docBoard {
  title: "Text roles · states · i9",
  left: 0px,
  top: 1327px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(row-1, after = .nil),
      insert(row-2, after = row-1),
      insert(row-3, after = row-2),
      insert(row-4, after = row-3),
      insert(row-5, after = row-4),
      insert(row-6, after = row-5),
      insert(row-7, after = row-6),
      insert(row-8, after = row-7)
    ]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Text roles · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-display, after = .nil),
      insert(st-displayPhone, after = st-display)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-heading, after = .nil)]
  }

  row-3 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-title, after = .nil),
      insert(st-titleCard, after = st-title)
    ]
  }

  row-4 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-body, after = .nil),
      insert(st-bodyCard, after = st-body)
    ]
  }

  row-5 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-meta, after = .nil),
      insert(st-metaCard, after = st-meta)
    ]
  }

  row-6 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-label, after = .nil),
      insert(st-labelCard, after = st-label)
    ]
  }

  row-7 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-micro, after = .nil)]
  }

  row-8 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-num, after = .nil),
      insert(st-numCard, after = st-num)
    ]
  }

  st-display = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "display"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Display · the page title"
    }

    it = text : display {}
  }

  st-displayPhone = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "displayPhone"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Display · phones"
    }

    it = text : displayPhone {}
  }

  st-heading = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "heading"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Heading"
    }

    it = text : heading {}
  }

  st-title = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "title"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Title · on the page"
    }

    it = text : title {}
  }

  st-titleCard = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "titleCard"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Title · in a card or row"
    }

    it = text : titleCard {}
  }

  st-body = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "body"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Body · on the page"
    }

    it = text : body {}
  }

  st-bodyCard = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "bodyCard"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Body · in a card"
    }

    it = text : bodyCard {}
  }

  st-meta = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "meta"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Meta · on the page"
    }

    it = text : meta {}
  }

  st-metaCard = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "metaCard"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Meta · in a card"
    }

    it = text : metaCard {}
  }

  st-label = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "label"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Label · a button's words"
    }

    it = text : label {}
  }

  st-labelCard = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "labelCard"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "Label · in a card"
    }

    it = text : labelCard {}
  }

  st-micro = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

