import "tokens/color/palette.elyx" as pal
import "tokens/space/space.elyx" as spc
import "components/molecules/year-pill.elyx" as yp
import "components/atoms/doc.elyx" as doc
import "components/organisms/post-card.elyx" as pc
import "components/molecules/media-thumb.elyx" as mt
import "assets/icons/bold/ranking.svg" as rankingIcon
import "components/organisms/thoughts-tools.elyx" as tools
import "assets/icons/bold/folder-simple.svg" as projectIcon
import "redesign/v3-yarn-11/media/portal-coach.gif" as portalCoachImage
import "redesign/v3-yarn-11/media/portal-student.png" as portalStudentImage
import "redesign/v3-yarn-11/media/fitr-redesign.gif" as fitrImage

// Thoughts' stitched feed (thoughts/stitched.html): the rail on the left,
// then the posts by month, newest first. A month is its ruled pill (the
// month + a Meta count) and 14 below it three columns of post cards (the
// masonry, i9 16 apart, i10 24), a month-gap to the next (i9 / i10 32,
// i11 48: a section). Cards are `components/organisms/post-card.elyx`
// filled with the real posts (kit/thoughts-data.js).
// i10 / i11 are iteration variants of each month: the kicker's words in
// Micro caps ("2 MIN", "NOV 7"), the pick's link button (postPickI10), the
// 1 + 2 images on top of each other (postImages3I10), i11's cut "Read →"
// (postArticleI11) and, where the masonry falls differently in the mock,
// a card moved to its column. `thoughtsFeed` (+ I10 / I11) is the rail and
// the months side by side, as a screen inserts it into the sheet.
@variants(monthNovI10)
export monthNov = frame {
  title: "Feed · November 2026",
  left: 0px,
  top: 40px,
  width: spc.controls.feed-w,
  layout: {stack: {direction: .column, item-gap: spc.layout.month-head}},
  children: [heading, grid],

  heading = frame : yp.yearHeader {
    width: 100%,
    padding-top: 0px,
    padding-left: 0px,
    padding-bottom: 0px,
    padding-right: 0px,

    pill {
      year {
        contents: "November 2026"
      }

      count {
        contents: "9 posts"
      }
    }
  }

  grid = frame {
    width: 100%,
    layout: {
      grid: {columns: [1fr, 1fr, 1fr], column-gap: spc.layout.post-gutter}
    },
    children: [c1, c2, c3],

    c1 = frame {
      width: 100%,
      layout: {stack: {direction: .column, item-gap: spc.layout.post-gutter}},
      children: [scratchCat, movingSite, scratchFeedback],

      scratchCat = frame : pc.postNote {
        width: 100%,

        kicker {
          date {
            contents: "Nov 7 · 11:41 pm"
          }
        }

        quote {
          contents: "“what if every website had a little cat that judged your scroll speed"
        }

        foot {
          tags {
            t1 {
              label {
                contents: "shower"
              }
            }
          }
        }
      }

      movingSite = frame : pc.postArticleCover {
        width: 100%,

        body {
          about {
            display: .none
          }

          head {
            kicker {
              lead {
                extra {
                  x {
                    contents: "7 min read"
                  }
                }
              }

              date {
                contents: "Nov 5"
              }
            }

            words {
              headline {
                contents: "Moving a site from\nAstro to SvelteKit\nwithout losing the music"
              }

              dek {
                contents: "One <audio> element, a root layout, and why the player kept restarting."
              }
            }
          }

          foot {
            tags {
              t1 {
                label {
                  contents: "svelte"
                }
              }

              t2 {
                label {
                  contents: "learnings"
                }
              }
            }
          }
        }
      }

      scratchFeedback = frame : pc.postNotePink {
        width: 100%,

        foot {
          display: .none
        }

        kicker {
          date {
            contents: "Nov 1 · 8:12 am"
          }
        }

        quote {
          contents: "“the best ui feedback is the one you only notice when it's missing"
        }
      }
    }

    c2 = frame {
      width: 100%,
      layout: {stack: {direction: .column, item-gap: spc.layout.post-gutter}},
      children: [ghosttyArticle, tenBrowsers, browsersRanked],

      ghosttyArticle = frame : pc.postArticle {
        width: 100%,

        body {
          head {
            kicker {
              lead {
                extra {
                  x {
                    contents: "2 min read"
                  }
                }
              }

              date {
                contents: "Nov 7"
              }
            }

            words {
              headline {
                contents: "Ghostty, three months in"
              }

              dek {
                contents: "The terminal I stopped tweaking."
              }
            }
          }

          about {
            label {
              contents: "Ghostty"
            }
          }

          foot {
            tags {
              t1 {
                label {
                  contents: "tools"
                }
              }

              t2 {
                label {
                  contents: "terminal"
                }
              }
            }
          }
        }
      }

      tenBrowsers = frame : pc.postArticle {
        width: 100%,

        body {
          about {
            glyph {
              contents: rankingIcon
            }

            label {
              contents: "My favorite browsers, ranked"
            }
          }

          head {
            kicker {
              lead {
                extra {
                  x {
                    contents: "3 min read"
                  }
                }
              }

              date {
                contents: "Nov 4"
              }
            }

            words {
              headline {
                contents: "Ten browsers, a month each"
              }

              dek {
                contents: "How the ranking happened, and why Chrome is in D."
              }
            }
          }

          foot {
            tags {
              t1 {
                label {
                  contents: "browsers"
                }
              }

              t2 {
                label {
                  contents: "ranked"
                }
              }
            }
          }
        }
      }

      browsersRanked = frame : pc.postRanking {
        width: 100%,

        head {
          kicker {
            lead {
              extra {
                x {
                  contents: "214 ranked"
                }
              }
            }

            date {
              contents: "Nov 2"
            }
          }

          headline {
            contents: "My favorite browsers, ranked"
          }
        }

        writeup {
          count {
            contents: "3 min"
          }
        }

        actions {
          comments {
            label {
              contents: "4 comments"
            }
          }
        }

        foot {
          tags {
            t1 {
              label {
                contents: "browsers"
              }
            }

            t2 {
              label {
                contents: "ranked"
              }
            }
          }
        }
      }
    }

    c3 = frame {
      width: 100%,
      layout: {stack: {direction: .column, item-gap: spc.layout.post-gutter}},
      children: [heliumArticle, zedPick, ghosttyPick],

      heliumArticle = frame : pc.postArticle {
        width: 100%,

        body {
          about {
            glyph {
              display: .none
            }

            label {
              contents: "Helium"
            }

            tier {
              display: .visible
            }
          }

          head {
            kicker {
              lead {
                extra {
                  x {
                    contents: "2 min read"
                  }
                }
              }

              date {
                contents: "Nov 6"
              }
            }

            words {
              headline {
                contents: "Helium, the quiet one"
              }

              dek {
                contents: "A month in, I forgot I'd switched. That's why it's in S."
              }
            }
          }

          foot {
            tags {
              t1 {
                label {
                  contents: "browser"
                }
              }

              t2 {
                label {
                  contents: "tools"
                }
              }
            }
          }
        }
      }

      zedPick = frame : pc.postPick {
        width: 100%,

        head {
          kicker {
            date {
              contents: "Nov 4"
            }
          }

          words {
            headline {
              contents: "Zed"
            }

            dek {
              contents: "Fast editor. I write my own themes for it."
            }
          }
        }

        foot {
          links {
            ext {
              extLabel {
                contents: "zed.dev"
              }
            }

            extBtn {
              label {
                contents: "zed.dev"
              }
            }
          }

          tagLine {
            tags {
              t1 {
                label {
                  contents: "tools"
                }
              }

              t2 {
                label {
                  contents: "editor"
                }
              }
            }
          }
        }
      }

      ghosttyPick = frame : pc.postPick {
        width: 100%,

        stub {
          fill[0].color: pal.palette.stub-ink,
          border[0].color: pal.palette.stub-seam,
          fill[1].visible: .true
        }

        head {
          kicker {
            date {
              contents: "Nov 3"
            }
          }

          words {
            headline {
              contents: "Ghostty"
            }

            dek {
              contents: "A terminal that gets out of the way."
            }
          }
        }

        writeup {
          count {
            contents: "2 min"
          }

          display: .visible
        }

        foot {
          links {
            ext {
              extLabel {
                contents: "ghostty.org"
              }
            }

            extBtn {
              label {
                contents: "ghostty.org"
              }
            }
          }

          tagLine {
            tags {
              t1 {
                label {
                  contents: "tools"
                }
              }

              t2 {
                label {
                  contents: "terminal"
                }
              }
            }
          }
        }
      }
    }
  }
}

