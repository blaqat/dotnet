        stub {
          fill[0].color: pal.palette.red,
          border[0].color: pal.palette.stub-seam,
          fill[1].visible: .true
        }

        head {
          kicker {
            date {
              contents: "Oct 26"
            }
          }

          words {
            headline {
              contents: "chezmoi"
            }

            dek {
              contents: "Dotfiles across machines, with encrypted secrets."
            }
          }
        }

        foot {
          links {
            ext {
              extLabel {
                contents: "chezmoi.io"
              }
            }

            extBtn {
              label {
                contents: "chezmoi.io"
              }
            }
          }

          tagLine {
            tags {
              t1 {
                label {
                  contents: "tools"
                }
              }

              t2 {
                label {
                  contents: "dotfiles"
                }
              }
            }
          }
        }
      }

      scratchFolders = frame : pc.postNoteMint {
        width: 100%,

        kicker {
          date {
            contents: "Oct 24 · 1:03 am"
          }
        }

        quote {
          contents: "“folders are just tabs that grew up"
        }

        foot {
          tags {
            t1 {
              label {
                contents: "shower"
              }
            }
          }
        }
      }

      springs = frame : pc.postArticle {
        width: 100%,

        body {
          about {
            display: .none
          }

          head {
            kicker {
              lead {
                extra {
                  x {
                    contents: "4 min read"
                  }
                }
              }

              date {
                contents: "Oct 20"
              }
            }

            words {
              headline {
                contents: "Springs, not durations"
              }

              dek {
                contents: "What I took from Apple's fluid interface talk and how it maps to CSS."
              }
            }
          }

          foot {
            tags {
              t1 {
                label {
                  contents: "design"
                }
              }

              t2 {
                label {
                  contents: "learnings"
                }
              }
            }
          }
        }
      }

      seniorPortal = frame : pc.postImages2 {
        width: 100%,

        grid {
          row {
            s1 {
              fill[1].image.ref: portalCoachImage,
              overrides: [insert(coachGif, after = mt.mediaThumb.thumbStitch)]
            }

            s2 {
              fill[1].image.ref: portalStudentImage
            }
          }
        }

        head {
          words {
            dek {
              display: .none
            }

            headline {
              contents: "Senior project portal, coach view"
            }
          }

          kicker {
            lead {
              extra {
                x {
                  contents: "2 images"
                }
              }
            }

            date {
              contents: "Oct 15"
            }
          }
        }

        foot {
          tags {
            t2 {
              display: .none
            }

            t1 {
              label {
                contents: "projects"
              }
            }
          }
        }

        coachGif = frame : pc.postGif {
          right: spc.layout.stack-tight,
          bottom: spc.layout.stack-tight
        }
      }
    }
  }
}

