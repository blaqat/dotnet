        foot {
          display: .none
        }

        kicker {
          date {
            contents: "Oct 2 · 5:20 pm"
          }
        }

        quote {
          contents: "“a playlist is a mood with a tracklist"
        }
      }
    }

    c2 = frame {
      width: 100%,
      layout: {stack: {direction: .column, item-gap: spc.layout.post-gutter}},
      children: [sonaSheets, codingFonts],

      sonaSheets = frame : pc.postImages {
        width: 100%,

        head {
          kicker {
            lead {
              extra {
                x {
