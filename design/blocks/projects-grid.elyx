// Projects' grid (`.ygroups` with `grid: true`): the projects by year, newest
// first. Each year is its ruled pill (the year + a Meta count, the dashed
// rule across the column) and 16 below it a two-column grid of project
// cards, the same gap across and down (i9 20 · 20; i10 R6: 24 · 24); the
// grid stretches the cards in a row to one height, so their feet line up.
// Years are i9 34 · i10 32 · i11 48 apart (spc.layout.pj-group-gap).
// `projectsGrid` holds the twelve real projects (kit/data.js, i8's order);
// its I10 variant picks the cards' I10 variant (the duotone discs and the
// write-up pill). i11 changes nothing here but tokens.
// ---- one year: the pill + rule, then up to four cards (c1…c4; hide the
// slots a year doesn't use)
export projectsYear = frame {
  title: "Projects · a year (pill + grid)",
  left: 0px,
  top: 40px,
  width: 1332px,
  layout: {stack: {direction: .column, item-gap: spc.steps.s4}},
  children: [head, cards],

  head = frame : yp.yearHeader {
    width: 100%,
    padding-top: 0px,
    padding-left: 0px,
    padding-bottom: 0px,
    padding-right: 0px,

    pill {
      year {
        contents: "2025"
      }

      count {
        contents: "2 projects"
      }
    }
  }

  cards = frame {
    width: 100%,
    layout: {
      grid: {
        columns: [1fr, 1fr],
        column-gap: spc.layout.gutter-x,
        row-gap: spc.layout.pj-grid-y
      }
    },
    children: [c1, c2, c3, c4],

    c1 = frame : pj.project {
      width: 100%,
      height: 100%
    }

    c2 = frame : pj.project {
      width: 100%,
      height: 100%
    }

    c3 = frame : pj.project {
      width: 100%,
      height: 100%,
      display: .none
    }

    c4 = frame : pj.project {
      width: 100%,
      height: 100%,
      display: .none
    }
  }
}

