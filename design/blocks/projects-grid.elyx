// i10: every card's I10 variant; where the i9 grid shows a card's write-up
// or swaps its second disc, it re-picks their I10 variants too
@context(i10="on")
export projectsGridI10 = frame : projectsGrid {
  title: "Projects · grid · i10",
  left: 1596px,
  top: 462px,

  y2020 {
    cards {
      @with-variant(pj.projectI10)
      c1 {}
    }
  }

  y2021 {
    cards {
      @with-variant(pj.projectI10)
      c1 {}
    }
  }

  y2023 {
    cards {
      @with-variant(pj.projectI10)
      c4 {}

      @with-variant(pj.projectTextI10)
      c3 {}

      @with-variant(pj.projectTextI10)
      c2 {}

      @with-variant(pj.projectI10)
      c1 {
        cols {
          side {
            foot {
              links {
                @with-variant(lnk.linkDiscDiscordI10)
                disc2 {}
              }
            }
          }
        }
      }
    }
  }

  y2024 {
    cards {
      @with-variant(pj.projectI10)
      c4 {}

      @with-variant(pj.projectI10)
      c3 {
        cols {
          side {
            foot {
              links {
                @with-variant(lnk.linkDiscGithubI10)
                disc2 {}
              }
            }
          }
        }
      }

      @with-variant(pj.projectI10)
      c2 {}

      @with-variant(pj.projectI10)
      c1 {}
    }
  }

  y2025 {
    cards {
      @with-variant(pj.projectI10)
      c2 {}

      @with-variant(pj.projectI10)
      c1 {}
    }
  }
}

