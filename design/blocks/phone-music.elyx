@variants(musicPhoneStatesI10)
musicPhoneStates = frame : doc.docBoard {
  title: "Music · phone · states · i9",
  left: 0px,
  top: 2356px,

  body {
    layout.stack.item-gap: 48px,
    overrides: [insert(row-1, after = .nil), insert(row-2, after = row-1)]
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Music · phone · every state"
    }
  }

  row-1 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [
      insert(st-musicPhone, after = .nil),
      insert(st-musicPhonePlayer, after = st-musicPhone),
      insert(st-musicPhoneSearch, after = st-musicPhonePlayer),
      insert(st-musicPhoneMenu, after = st-musicPhoneSearch)
    ]
  }

  row-2 = frame : doc.specRow {
    layout.stack.item-gap: 48px,
    overrides: [insert(st-musicListPhone, after = .nil)]
  }

  st-musicPhone = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "musicPhone"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "i9 · the bar playing"
    }

    it = frame : musicPhone {}
  }

  st-musicPhonePlayer = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "musicPhonePlayer"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the player's page open"
    }

    it = frame : musicPhonePlayer {}
  }

  st-musicPhoneSearch = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "musicPhoneSearch"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "search open (example)"
    }

    it = frame : musicPhoneSearch {}
  }

  st-musicPhoneMenu = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "musicPhoneMenu"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the sections menu open (example)"
    }

    it = frame : musicPhoneMenu {}
  }

  st-musicListPhone = frame : doc.spec {
    overrides: [insert(note, after = doc.spec.label)],

    label {
      contents: "musicListPhone"
    }

    slot {
      overrides: [insert(it, after = .nil)]
    }

    note = text : doc.specNote {
      contents: "the list · i9"
    }

    it = frame : musicListPhone {}
  }
}

