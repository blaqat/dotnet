                contents: "🙅‍♂️ no shot she got kidnapped again🤦‍♂️"
              }

              number {
                contents: "03"
              }
            }

            layout.stack.item-gap: spc.layout.folder-tab-overlap-5,

            after2 {
              layout.stack.item-gap: spc.layout.folder-tab-overlap-5,
              overrides: [
                insert(
                  fifthTournamentTab5,
                  after = ft.folderTabs.strip.after1.after2.tab4
                )
              ],

              tab3 {
                number {
                  contents: "04"
                }

                name {
                  contents: "waaaterrfront"
                }
              }

              tab4 {
                number {
                  contents: "05"
                }

                name {
                  contents: "a wish for humanity"
                }
              }
            }
          }

          layout.stack.item-gap: spc.layout.folder-tab-overlap-5,

          tab1 {
            number {
              contents: "01"
            }

            name {
              contents: "Land of Sugar and Spice"
            }
          }
        }
      }

      card {
        top {
          head {
            art {
              fill[1].image.ref: fifthTournamentCover
            }

            tt {
              nameRow {
                name {
                  width: 100%,
                  contents: "The 5th Beepbox Tournament"
                }

                layout.stack.direction: .column,

