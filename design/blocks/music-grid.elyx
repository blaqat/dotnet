      fifthTournamentTab5 = frame : ft.folderTab {
        number {
          contents: "06"
        }

        name {
          contents: "peacefulliment"
        }
      }
    }

    gentleOrbit = frame : fc.folderCardSingle {
      width: 100%,

      card {
        top {
