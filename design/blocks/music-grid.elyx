// ---- the list under the tools ----
@variants(musicListI10)
export musicList = frame {
  title: "Music · list (results line + year groups)",
  left: 0px,
  top: 1962px,
  width: 1332px,
  layout: {
    stack: {
      direction: .column,
      align-items: .stretch,
      item-gap: spc.layout.results-gap
    }
  },
  children: [results, groups],

  // i10+: the counts and Play / Shuffle; i9 shows its counts in the header
  results = frame : rl.resultsLine {
    width: .nil,
    display: .none
  }

  groups = frame {
    layout: {
      stack: {
        direction: .column,
        align-items: .stretch,
        item-gap: spc.layout.group-gap
      }
    },
    children: [first, second],

    first = frame : yearGroup2022 {
      width: .nil
    }

    second = frame : yearGroup2021 {
      width: .nil
    }
  }
}

@variants(musicListI11)
@context(i10="on")
export musicListI10 = frame : musicList {
  title: "Music · list · i10",
  left: 1596px,
  top: 1962px,

  groups {
    @with-variant(yearGroup2021I10)
    second {}

    @with-variant(yearGroup2022I10)
    first {}
  }

  results {
    display: .visible
  }
}

@context(i10="on", i11="on")
export musicListI11 = frame : musicListI10 {
  title: "Music · list · i11",
  left: 3192px,
  top: 1962px,

  groups {
    @with-variant(yearGroup2022I11)
    first {}
  }
}

