import "tokens/space/space.elyx" as spc
import "components/molecules/year-pill.elyx" as yp
import "components/atoms/doc.elyx" as doc
import "components/molecules/fact.elyx" as fct
import "components/molecules/folder-tab.elyx" as ft
import "components/molecules/link-disc.elyx" as lnk
import "components/molecules/add-button.elyx" as addb
import "components/organisms/folder-card.elyx" as fc
import "assets/art/revealed.svg" as revealedCover
import "assets/art/aikisus-shorts.svg" as aikisuCover
import "assets/art/peppy-snowday.svg" as peppyCover
import "assets/art/farewell-my-star.svg" as farewellCover
import "assets/art/gleaming-shadows.svg" as gleamingCover
import "components/organisms/results-line.elyx" as rl
import "assets/art/of-the-stars.svg" as ofTheStarsCover
import "assets/art/marmalade-cafe.svg" as marmaladeCover
import "assets/art/lofi-song-solo.svg" as lofiCover
import "assets/art/winterland-dream.svg" as winterlandCover
import "assets/art/layers-of-elegance.svg" as layersCover
import "assets/art/the-5th-beepbox-tournament.svg" as fifthTournamentCover
import "assets/art/gentle-orbit.svg" as gentleOrbitCover
import "assets/art/vgm-class-final-project.svg" as vgmCover
import "assets/art/cat-with-pants.svg" as catPantsCover
import "assets/art/home-region-ambient.svg" as homeRegionCover
import "assets/art/cat-walt-3.svg" as catWaltCover
import "assets/art/village-night-symphony-cover.svg" as villageNightCover

// Music's grid (view=grid): a year group = its year pill + a dashed rule
// across the column, 16 above four columns of folder cards with one
// gutter across and down (i9 20 + every row keeps the tabs' 22 room; i10
// 24 / 24, the room only on a row with a collection). Real content
// (kit/data.js, i11's order), glooming shadows (Alphabet City Collection)
// playing.
// i10 variants pick each card's i10 variant (the count joins the facts,
// duotone link discs, the live tint) and drop the room on rows without a
// collection; i11 picks the playing card's i11 variant ("more" cut).
// `musicList` is the list under the tools: the results line (i10+; i9 has
// none) one gutter above the year groups, the groups `group-gap` apart.
@variants(yearGroup2022I10)
export yearGroup2022 = frame {
  title: "Year group · 2022 – 2026",
  left: 0px,
  top: 40px,
  width: 1332px,
  layout: {
    stack: {direction: .column, align-items: .stretch, item-gap: spc.steps.s2}
  },
  children: [head, grid],

  // the pill starts the group (no space above it)
  head = frame : yp.yearHeader {
    width: 100%,
    padding-top: 0px,

    pill {
      year {
        contents: "2022 – 2026"
      }

      count {
        contents: "10 releases"
      }
    }
  }

  // 16 under the pill (the header's own 8 + 8); four columns, one gutter
  // across and down; every card in a row as tall
  // as the tallest (the foot on the bottom edge)
  grid = frame {
    layout: {
      grid: {
        columns: [1fr, 1fr, 1fr, 1fr],
        column-gap: spc.layout.gutter-x,
        row-gap: spc.layout.gutter-x,
        align-items: .stretch
      }
    },
    children: [
      ofTheStars,
      revealed,
      alphabetCity,
      aikisu,
      castAdrift,
      peppySnowday,
      marmaladeCafe,
      farewellMyStar,
      lofiSongSolo,
      gleamingShadows
    ],

    ofTheStars = frame : fc.folderCardSingle {
      width: 100%,

      card {
        foot {
          links {
            @with-variant(lnk.linkDiscBeepbox)
            link1 {}
          }
        }

        top {
          face {
            desc {
              contents: "Revealed but different... The original song of this was for a 1 hour composition competition which eventually got expanded into this, but also diverged into the piano iteration."
            }
          }

          head {
            tt {
              @with-variant(fct.factWip)
              facts {
                label {
                  contents: "WIP since Jun 2021"
                }
              }

              nameRow {
                name {
                  subrange[0].range: [12, 13],
                  subrange[0].font-family: "Apple Color Emoji",
                  contents: "of.the.stars✨"
                }
              }
            }

            art {
              fill[1].image.ref: ofTheStarsCover
            }
          }
        }
      }
    }

    revealed = frame : fc.folderCard {
      width: 100%,

      tabs {
        strip {
          after1 {
            after2 {
              tab4 {
                name {
                  contents: "revealed"
                }
              }

              tab3 {
                name {
                  contents: "prelude"
                }
              }
            }

            tab2 {
              name {
                contents: "libterrene"
              }
            }
          }

          tab1 {
            name {
              contents: "seeds you planted"
            }
          }
        }
      }

      card {
        top {
          face {
            desc {
              contents: "A short piano EP about finding what your place is in the vast universe around you. Currently Contains Unfinished Planning Tracks"
            }
          }

          head {
            tt {
              @with-variant(fct.factWip)
              facts {}

              nameRow {
                name {
                  contents: "Revealed"
                }
              }
            }

            art {
              fill[1].image.ref: revealedCover
            }
          }
        }
      }
    }

    alphabetCity = frame : fc.folderCardLive {
      width: 100%
    }

    aikisu = frame : fc.folderCard {
      width: 100%,

      tabs {
        strip {
          layout.stack.item-gap: spc.layout.folder-tab-overlap-7,

          after1 {
            layout.stack.item-gap: spc.layout.folder-tab-overlap-7,

            after2 {
              layout.stack.item-gap: spc.layout.folder-tab-overlap-7,
              overrides: [
                insert(
                  aikisuTab5,
                  after = ft.folderTabs.strip.after1.after2.tab4
                ),
                insert(aikisuTab6, after = aikisuTab5),
                insert(aikisuTab7, after = aikisuTab6)
              ],

              tab3 {
                number {
                  contents: "03"
                }

                name {
                  contents: "VS 10% Remaining"
                }
              }

              tab4 {
                number {
                  contents: "04"
                }

                name {
                  contents: "melón parfait"
                }
              }
            }

            tab2 {
              number {
                contents: "02"
              }

              name {
                contents: "Wall Staring Contest"
              }
            }
          }

          tab1 {
            number {
              contents: "01"
            }

            name {
              contents: "Jumper and Lily"
            }
          }
        }
      }

      card {
        top {
          head {
            art {
              fill[1].image.ref: aikisuCover
            }

            tt {
              nameRow {
                name {
                  contents: "aikisu's shorts"
                }

                count {
                  contents: "(7 tracks)"
                }
              }

              facts {
                label {
                  contents: "Completed Jul 2025"
                }

                sub {
                  contents: "· 7 tracks"
                }
              }
            }
          }

          face {
            desc {
              contents: "A collection of short cute chippy songs made in Beepbox using the 'moon.honey' instruments. \"Aikisu\" means 'Amai Tsuki Mitsu' or 'Sweet Moon Honey'."
            }
          }
        }
      }

      aikisuTab5 = frame : ft.folderTab {
        number {
          contents: "05"
        }

        name {
          contents: "kakiguava island heatwave"
        }
      }

      aikisuTab6 = frame : ft.folderTab {
        number {
          contents: "06"
        }

        name {
          contents: "kakiguava paradise"
        }
      }

      aikisuTab7 = frame : ft.folderTab {
        number {
          contents: "07"
        }

        name {
          contents: "helpless cat blues (dramatic)"
        }
      }
    }

    castAdrift = frame : fc.folderCardSingle {
      width: 100%,

      card {
        foot {
          acts {
            @with-variant(addb.addBtnAdded)
            add {}
          }

          links {
            overrides: [
              insert(
                castAdriftLink2,
                after = fc.folderCard.card.foot.links.link1
              )
            ]
          }
        }
      }

      castAdriftLink2 = frame : lnk.linkDiscYoutube {}
    }

    peppySnowday = frame : fc.folderCardSingle {
      width: 100%,

      card {
        foot {
          links {
            @with-variant(lnk.linkDiscYoutube)
            link1 {}
          }
        }

        top {
          head {
            art {
              fill[1].image.ref: peppyCover
            }

            tt {
              facts {
                label {
                  contents: "Completed Jan 2023"
                }
              }

              nameRow {
                name {
                  contents: "peppy snowday"
                }
              }
            }
          }

          face {
            desc {
              contents: "joy and fun"
            }
          }
        }
      }
    }

    marmaladeCafe = frame : fc.folderCardSingle {
      width: 100%,

      card {
        foot {
          acts {
            @with-variant(addb.addBtnAdded)
            add {}
          }

          links {
            overrides: [
              insert(
                marmaladeCafeLink2,
                after = fc.folderCard.card.foot.links.link1
              )
            ],

            @with-variant(lnk.linkDiscYoutube)
            link1 {}
          }
        }

        top {
          head {
            art {
              fill[1].image.ref: marmaladeCover
            }

            tt {
              facts {
                label {
                  contents: "Completed Dec 2022"
                }
              }

              nameRow {
                name {
                  contents: "marmalade cafe"
                }
              }
            }
          }

          face {
            desc {
              contents: "sip sip mmmm"
            }
          }
        }
      }

      marmaladeCafeLink2 = frame : lnk.linkDiscSoundcloud {}
    }

    farewellMyStar = frame : fc.folderCardSingle {
      width: 100%,

      card {
        foot {
          acts {
            @with-variant(addb.addBtnAdded)
            add {}
          }

          links {
            link1 {
              display: .none
            }
          }
        }

        top {
          head {
            art {
              fill[1].image.ref: farewellCover
            }

            tt {
              facts {
                label {
                  contents: "Completed Apr 2022"
                }
              }

              nameRow {
                name {
                  contents: "farewell my star"
                }
              }
            }
          }

          face {
            display: .none
          }
        }
      }
    }

    lofiSongSolo = frame : fc.folderCardSingle {
      width: 100%,

      card {
        foot {
          links {
            link1 {
              display: .none
            }
          }
        }

        top {
          face {
            desc {
              contents: "Dont know what happened to the full song unfortunately, but I really liked the ending"
            }
          }

          head {
            tt {
              @with-variant(fct.factDropped)
              facts {
                label {
                  contents: "Dropped, started Mar 2022"
                }
              }

              nameRow {
                name {
                  contents: "lofi song solo"
                }
              }
            }

            art {
              fill[1].image.ref: lofiCover
            }
          }
        }
      }
    }

    gleamingShadows = frame : fc.folderCardSingle {
      width: 100%,

      card {
        foot {
          acts {
            @with-variant(addb.addBtnAdded)
            add {}
          }

          links {
            overrides: [
              insert(
                gleamingShadowsLink2,
                after = fc.folderCard.card.foot.links.link1
              )
            ]
          }
        }

        top {
          head {
            art {
              fill[1].image.ref: gleamingCover
            }

            tt {
              facts {
                label {
                  contents: "Completed Feb 2022"
                }
              }

              nameRow {
                name {
                  contents: "gleaming shadows"
                }
              }
            }
          }

          face {
            desc {
              contents: "An adventurer explores the depths of a dark cavern and stumbles upon beautiful fluorescent lights illuminating the new world around them. A remake of a track I made for the 4th Beepbox Tournament"
            }
          }
        }
      }

      gleamingShadowsLink2 = frame : lnk.linkDiscBeepbox {}
    }
  }
}

@variants(yearGroup2021I10)
export yearGroup2021 = frame {
  title: "Year group · 2021",
