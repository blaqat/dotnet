// ---- i10 · the cards' i10 variants; a row without a collection has no room ----
@variants(yearGroup2022I11)
@context(i10="on")
export yearGroup2022I10 = frame : yearGroup2022 {
  title: "Year group · 2022 – 2026 · i10",
  left: 1596px,
  top: 40px,

  grid {
    gleamingShadows {
      padding-top: 0px,

      card {
        foot {
          links {
            @with-variant(lnk.linkDiscBeepboxI10)
            gleamingShadowsLink2 {}

            @with-variant(lnk.linkDiscSoundcloudI10)
            link1 {}
          }
        }
      }
    }

    lofiSongSolo {
      padding-top: 0px
    }

    farewellMyStar {
      padding-top: 0px
    }

    marmaladeCafe {
      padding-top: 0px,

      card {
        foot {
          links {
            @with-variant(lnk.linkDiscSoundcloudI10)
            marmaladeCafeLink2 {}

            @with-variant(lnk.linkDiscYoutubeI10)
            link1 {}
          }
        }
      }
    }

