// Spacing, insets, radii and control sizes. i9 is the base; i10 / i11
// are context layers (DESIGN-i10 §6, DESIGN-i11 T6 + T10).
// i11 rule 13: a nested surface's radius = outer radius − the inset
// between them (min 4). Circles and pills are exempt.
import "./space-i10.elyx" as i10

// the 4 · 8 · 12 · 16 · 24 · 32 · 48 · 64 step scale (fixed)
export steps = tokens {
  s1: 4px,
  s2: 8px,
  s3: 12px,
  s4: 16px,
  s5: 24px,
  s6: 32px,
  s7: 48px,
  s8: 64px
}

@variants(i10.layoutI10)
export layout = tokens {
  // the page
  page-x: 40px,
  page-x-phone: 14px,
  frame: 14px,
  section-gap: 24px,
  section-gap-phone: 20px,
  // the nav (18 above, 8 below, 10 between tabs) and the page column
  // under it (6 above, 56 below); the sheet's stitch sits 9px in
  nav-top: 18px,
  nav-bottom: 8px,
  nav-gap: 10px,
  page-top: 6px,
