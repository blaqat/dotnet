@variants(i10.radiiI10)
export radii = tokens {
  inner: 8px,
  card: 16px,
  row: 14px,
  pop: 16px,
  field: 14px,
  sheet: 22px,
  pane: 22px,
  panel: 24px,
  art: 10px,
  pill: 999px,
  // the page sheet (22 in every iteration) and its stitch (22 − 9), a folder
  // tab's top corners, the folder's back cover
  page: 22px,
  page-stitch: 13px,
  folder-tab: 11px,
  fold: 15px,
  // an equalizer bar's round top
  eq: 1.5px,
  // the search line, a popover's option row, the hint, the toast, a key
  search: 18px,
  opt: 11px,
  tip: 9px,
  toast: 20px,
  kbd: 6px,
  // Thoughts: a sticky note (2, its curled corner 12); a track row; a photo
  // thumb; a tier item
  note: 2px,
  note-curl: 12px,
  track: 12px,
  thumb: 12px,
  tier-item: 6px,
  // Projects: a card's media (i11: 24 − 16 = 8), the opened item's media
  pj-thumb: 12px,
  pj-media: 12px,
  // the white stitch inside a card's media (4 in: i9 12 − 4; i11 8 − 4)
  pj-thumb-in: 8px,
  // the sound tag's bottom corners (it hangs from the sheet's top edge)
  sound: 7px,
  // phones: the page sheet (16) and its stitch (16 − 9)
  page-phone: 16px,
  page-stitch-phone: 7px,
  // Studio: the site strip; a track tab's top corners and the folder
  // body's corner tucked under them; the folder body; the editor's
  // toolbar + its buttons; the woven STUDIO tag
  st-strip: 18px,
  st-tab: 10px,
  st-tuck: 4px,
  st-folder: 18px,
  st-bar: 14px,
  st-tb: 10px,
  st-woven: 4px,
  // ---- Music ----
  // a card's stitch (the card's radius − its 6px stitch-in); the folder
  // card's art (i8 12; i11 the card's 24 − its inset 16); the player bar
  // and its stitch (6 in); a track row's art
  card-stitch: 10px,
  folder-art: 12px,
  player: 22px,
  player-stitch: 16px,
  trk-art: 10px,
  // Studio · a pattern swatch (+ its rope), a track tab's swatch
  st-motif: 12px,
  st-tab-sw: 5px,
  // phones: the sections menu (22; its stitch 5 in: 17) and its rows (14);
  // the search bar in the slot (20; its stitch 6 in: 14); the player's page
  // (24 at its top corners), its art (22; its stitch 8 in: 14), a queue
  // row (13), its swatch (9)
  spool-menu: 22px,
  spool-menu-stitch: 17px,
  spool-row: 14px,
  slot: 20px,
  slot-stitch: 14px,
  psheet: 24px,
  psheet-art: 22px,
  psheet-art-stitch: 14px,
  q-row: 13px,
  q-sw: 9px
}

