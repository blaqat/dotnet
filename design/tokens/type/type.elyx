export leading = tokens {
  display: 0.95,
  heading: 1.1,
  title: 1.15,
  body: 1.5,
  meta: 1.3,
  label: 1,
  micro: 1,
  num: 1.3,
  // a scratch's quote
  quote: 1.32,
  // Projects: the card's title, the opened item's title, its prose
  title-project: 1.15,
  title-item: 1.04,
  prose: 1.65,
  // Home: the bio (i9 1.7; i11 Body's 1.5), the tagline
  lead: 1.7,
  tagline: 1.2,
  // Studio · a quiet line in a card and a change in Recently (1.35; i11 Body)
  st-quiet: 1.35,
  // an opened article's title; the prose's words (17 / 29)
  article-title: 1.02,
  article-prose: 1.72,
  // Studio · the editor's title field (1.08; from i10 Display's), a field's label (1.2)
  st-title: 1.08,
  st-lab: 1.2
