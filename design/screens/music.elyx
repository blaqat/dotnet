// ---- phone · grid ----
phoneHeading = text : doc.specHeading {
  left: 32px,
  top: 3840px,
  contents: "Music · phone · 390 × 844 (the player's bar in the slot)"
}

// blocks/phone-music.elyx: one column of phone cards by year; i10 the
// results line and the cards' i10 variants, i11 the playing card's i11.
@variants(phoneI10, phonePlayer)
phone = frame : doc.docBoard {
  title: "Music · phone · i9",
  left: 0px,
  top: 3912px,

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Music · phone · grid"
    }
  }

  body {
    overrides: [insert(screen, after = .nil)]
  }

  screen = frame : pm.musicPhone {
    left: 0px,
    top: 0px
  }
}

@variants(phoneI11)
@context(i10="on")
phoneI10 = frame : phone {
  title: "Music · phone · i10",
  left: 1840px,
  top: 3912px,

  body {
    @with-variant(pm.musicPhoneI10)
    screen {
      left: 0px
    }
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }
}

@context(i10="on", i11="on")
phoneI11 = frame : phoneI10 {
  title: "Music · phone · i11",
  left: 3680px,
  top: 3912px,

  body {
    @with-variant(pm.musicPhoneI11)
    screen {}
  }

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
    }
  }
}

// ---- phone · the player open ----
phonePlayerHeading = text : doc.specHeading {
  left: 32px,
  top: 5120px,
  contents: "Music · phone · the player open (its page over a scrim)"
}

// `musicPhonePlayer` (the bar dragged up); i10 / i11 pick the list and the
// header the way `musicPhoneI10` / `musicPhoneI11` do, under the scrim.
@variants(phonePlayerI10)
phonePlayer = frame : phone {
  title: "Music · phone · player open · i9",
  left: 0px,
  top: 5192px,

  body {
    @with-variant(pm.musicPhonePlayer)
    screen {
      left: 0px
    }
  }

  boardHead {
    boardCaption {
      contents: "Music · phone · player open"
    }
  }
}

