    }
  }
}

@context(i10="on", i11="on")
articleI11 = frame : articleI10 {
  title: "Thoughts · article · 1440 · i11",
  left: 3680px,
  top: 4552px,

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
