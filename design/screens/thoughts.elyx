// ---- phone · 390 × 844 ----
phoneHeading = text : doc.specHeading {
  left: 32px,
  top: 7080px,
  contents: "Thoughts · phone · 390 × 844 (the feed, November)"
}

// blocks/phone-thoughts.elyx: the posts newest first in one column under
// each month's pill; i10 / i11 pick the month's iteration variants.
@variants(phoneI10)
phone = frame : doc.docBoard {
  title: "Thoughts · phone · i9",
  left: 0px,
  top: 7152px,

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "Thoughts · phone · feed"
    }
  }

  body {
    overrides: [insert(screen, after = .nil)]
  }

  screen = frame : pt.thoughtsPhone {
    left: 0px,
    top: 0px
  }
}

@variants(phoneI11)
@context(i10="on")
phoneI10 = frame : phone {
  title: "Thoughts · phone · i10",
  left: 1840px,
  top: 7152px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }

  body {
    @with-variant(pt.thoughtsPhoneI10)
    screen {}
  }
}

@context(i10="on", i11="on")
phoneI11 = frame : phoneI10 {
  title: "Thoughts · phone · i11",
  left: 3680px,
  top: 7152px,

  boardHead {
    boardTag {
      iterName {
        contents: "i11"
      }
    }
  }

  body {
    @with-variant(pt.thoughtsPhoneI11)
    screen {}
  }
}
