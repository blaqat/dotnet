  }

  screen = frame : sh.sheetThoughts {
    paper {
      page {
        overrides: [insert(opened, after = .nil)]
      }
    }

    opened = frame : art.articlePage {}
  }
}

@variants(articleI11)
@context(i10="on")
articleI10 = frame : article {
  title: "Thoughts · article · 1440 · i10",
  left: 1840px,
  top: 4552px,

  boardHead {
    boardTag {
      iterName {
        contents: "i10"
      }
    }
  }

  body {
    screen {
      fill[1].image.sizing.scale: 0.9485,

      paper {
        page {
          @with-variant(art.articlePageI10)
