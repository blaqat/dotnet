  title: "1b · Section hues · Home · i9",
  left: 0px,
  top: 6032px,

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "1b · Section hues · Home · no section (= Home)"
    }
  }

  body {
    overrides: [
      insert(hueHead, after = .nil),
      insert(hueSub1, after = hueHead),
      insert(hueSub2, after = hueSub1),
      insert(hueSub3, after = hueSub2)
    ]
  }

  hueHead = frame {
    layout: {stack: {direction: .column, item-gap: 10px}},
    children: [hueTitle, hueIntro],

    hueTitle = text : doc.specHeading {
      contents: "1b · Section hues · Home"
    }

    hueIntro = text : doc.specIntro {
      width: 1100px,
      contents: "The axis section=home|projects|music|thoughts|studio dyes the cord frame (i9) and, from i10, the section-coloured roles: here (the nav’s rope), on (a toggle’s fill), now, link hover, deco. Live is Music’s purple on every page from i10. Each board renders in its section; under each swatch, the palette colour it resolves to there."
    }
  }

