@variants(radiiI10)
radii = frame : doc.docBoard {
  title: "2b · Insets + radii · control sizes · i9",
  left: 0px,
  top: 17647px,

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "2b · Insets + radii · control sizes · base · no context"
    }
  }

  body {
    overrides: [
      insert(radiiHead, after = .nil),
      insert(radiiSub1, after = radiiHead),
      insert(radiiSub2, after = radiiSub1),
      insert(radiiSub3, after = radiiSub2)
    ]
  }

  radiiHead = frame {
    layout: {stack: {direction: .column, item-gap: 10px}},
    children: [radiiTitle, radiiIntro],

    radiiTitle = text : doc.specHeading {
      contents: "2b · Insets + radii · control sizes"
    }

    radiiIntro = text : doc.specIntro {
      width: 1100px,
      contents: "i11 rule 13: a surface holds its content the same distance from all four edges, and a surface nested in another has radius = outer radius − the inset between them (min 4). Circles and pills are exempt. Below: surfaces with their content one inset in, every radius token, then the control sizes."
    }
  }

  radiiSub1 = frame {
    layout: {stack: {direction: .column, item-gap: 16px}},
    children: [radiiSub1Head, radiiSub1Row1],

