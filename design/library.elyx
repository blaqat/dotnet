@variants(typeScaleI10)
typeScale = frame : doc.docBoard {
  title: "2 · Type scale · i9",
  left: 0px,
  top: 14917px,

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "2 · Type scale · base · no context"
    }
  }

  body {
    overrides: [
      insert(typeScaleHead, after = .nil),
      insert(typeScaleSub1, after = typeScaleHead),
      insert(typeScaleSub2, after = typeScaleSub1)
    ]
  }

  typeScaleHead = frame {
    layout: {stack: {direction: .column, item-gap: 10px}},
    children: [typeScaleTitle, typeScaleIntro],

    typeScaleTitle = text : doc.specHeading {
      contents: "2 · Type scale"
    }

    typeScaleIntro = text : doc.specIntro {
      width: 1100px,
      contents: "The type roles (components/atoms/text.elyx), each at its size in this iteration: size · face · tracking · line height. A -Card role is the same role inside a card or row (i11 rule 5: 1px smaller there). Components never set a size: they use a role or a part size below."
    }
  }

  typeScaleSub1 = frame {
    layout: {stack: {direction: .column, item-gap: 16px}},
    children: [
      typeScaleSub1Head,
      typeScaleSub1Row1,
      typeScaleSub1Row2,
      typeScaleSub1Row3,
      typeScaleSub1Row4,
      typeScaleSub1Row5,
      typeScaleSub1Row6,
      typeScaleSub1Row7,
      typeScaleSub1Row8
    ],

    typeScaleSub1Head = frame {
      layout: {stack: {align-items: .center, item-gap: 14px}},
      children: [typeScaleSub1Name, typeScaleSub1Path],

      typeScaleSub1Name = text : doc.specSubheading {
        contents: "Roles (txt.*): on the page | in a card or row"
      }

      typeScaleSub1Path = text : doc.specNote {
        contents: "components/atoms/text.elyx · tokens/type/type.elyx"
      }
    }

    typeScaleSub1Row1 = frame : doc.specRow {
