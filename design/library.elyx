@variants(facesI10)
faces = frame : doc.docBoard {
  title: "2c · Faces · i9",
  left: 0px,
  top: 19524px,

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "2c · Faces · base · no context"
    }
  }

  body {
    overrides: [
      insert(facesHead, after = .nil),
      insert(facesSub1, after = facesHead)
    ]
  }

  facesHead = frame {
    layout: {stack: {direction: .column, item-gap: 10px}},
    children: [facesTitle, facesIntro],

    facesTitle = text : doc.specHeading {
      contents: "2c · Faces"
    }

    facesIntro = text : doc.specIntro {
      width: 1100px,
      contents: "Two families: Nunito for headings and labels, Nunito Sans for everything else (from i10). Each specimen is set in the face token it names, as this iteration resolves it. Maple Mono (i9’s Meta and Numeric) is not bundled with the project, so it renders in a fallback face here."
    }
  }

  facesSub1 = frame {
    layout: {stack: {direction: .column, item-gap: 16px}},
    children: [facesSub1Head, facesSub1Row1],

    facesSub1Head = frame {
      layout: {stack: {align-items: .center, item-gap: 14px}},
      children: [facesSub1Name, facesSub1Path],

      facesSub1Name = text : doc.specSubheading {
        contents: "Faces (typ.faces.*)"
      }

      facesSub1Path = text : doc.specNote {
        contents: "tokens/type/type.elyx (+ type-i10, type-i11)"
      }
    }

    facesSub1Row1 = frame : doc.specRow {
      width: 1456px,
      layout.stack.item-gap: 40px,
      layout.stack.line-gap: 28px,
      layout.stack.wrap: .true,
      overrides: [
        insert(facesDisplayDisplayStyleSpec, after = .nil),
        insert(
          facesHeadingHeadingStyleSpec,
