@variants(rolesI10)
roles = frame : doc.docBoard {
  title: "1a · Colour roles · i9",
  left: 0px,
  top: 3379px,

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "1a · Colour roles · base · no context"
    }
  }

  body {
    overrides: [
      insert(rolesHead, after = .nil),
      insert(rolesSub1, after = rolesHead),
      insert(rolesSub2, after = rolesSub1),
      insert(rolesSub3, after = rolesSub2),
      insert(rolesSub4, after = rolesSub3),
      insert(rolesSub5, after = rolesSub4),
      insert(rolesSub6, after = rolesSub5),
      insert(rolesSub7, after = rolesSub6),
      insert(rolesSub8, after = rolesSub7),
      insert(rolesSub9, after = rolesSub8),
      insert(rolesSub10, after = rolesSub9),
      insert(rolesSub11, after = rolesSub10),
      insert(rolesSub12, after = rolesSub11)
    ]
  }

  rolesHead = frame {
    layout: {stack: {direction: .column, item-gap: 10px}},
    children: [rolesTitle, rolesIntro],

    rolesTitle = text : doc.specHeading {
      contents: "1a · Colour roles"
    }

    rolesIntro = text : doc.specIntro {
      width: 1100px,
      contents: "Every accent, text and surface colour in a component goes through a role (col.roles.*). Under each swatch: the palette colour it points at in this iteration. i9 is red everywhere; i10 re-points the roles (a colour is a word: here · pick · on · live); i11 keeps i10’s. This page has no section, so section-coloured roles show their red (Home) value; 1b shows them per section."
    }
  }

