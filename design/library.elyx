// The component library: every component and every state, in the kit's
// order (redesign/v3-yarn-11/kit/COMPONENTS.md), in i9 | i10 | i11 columns.
// Each section is a local board (i9, the base) with local contextual
// variants (…I10 @context(i10=on), …I11 @context(i10=on, i11=on)): an
// instance of an imported contextual variant would not keep its context.
// A component's structural iteration variant is picked at its tree
// position in the …I10 / …I11 board. 1b (hue*) adds the section axis.
libraryHead = frame {
  title: "Yarn · component library",
  left: 0px,
  top: 0px,
  width: 5200px,
  layout: {stack: {direction: .column, item-gap: 24px}},
  children: [headTitle, headLead, headCols, headHow, headIndex],

  headTitle = text : doc.specHeading {
    contents: "Yarn · component library",
    font-size: 56
  }

  headLead = text : doc.specIntro {
    width: 1500px,
    contents: "Every component of the Yarn design system and every state it has, on one page, in the order of the kit (redesign/v3-yarn-11/kit/COMPONENTS.md): Foundations, Components, Patterns, then Studio. Each section is three boards side by side, one per iteration: i9 (the base) | i10 | i11. Each board renders in its own iteration, so a specimen reads across its row from left to right.",
    font-size: 17
  }

  headCols = frame {
    layout: {stack: {item-gap: 320px}},
    children: [colI9, colI10, colI11],

    colI9 = frame {
      width: 1520px,
      layout: {stack: {align-items: .center, item-gap: 12px}},
      border: {color: pal.palette.ink, sides: .top},
      padding-top: 14px,
      padding-bottom: 14px,
      children: [colI9Tag, colI9Words],

      colI9Tag = frame : doc.iterTag {
        iterName {
          contents: "i9"
        }
      }

      colI9Words = text : doc.specLabel {
        contents: "i9 · the base: the i9 kit (no context)",
        font-size: 15
      }
    }

    colI10 = frame {
      width: 1520px,
      layout: {stack: {align-items: .center, item-gap: 12px}},
      border: {color: pal.palette.ink, sides: .top},
      padding-top: 14px,
      padding-bottom: 14px,
      children: [colI10Tag, colI10Words],

      colI10Tag = frame : doc.iterTag {
        iterName {
          contents: "i10"
        }
      }

      colI10Words = text : doc.specLabel {
        contents: "i10 · colour roles + the state ladder, six type roles (i10=on)",
        font-size: 15
      }
    }

    colI11 = frame {
      width: 1520px,
      layout: {stack: {align-items: .center, item-gap: 12px}},
      border: {color: pal.palette.ink, sides: .top},
      padding-top: 14px,
      padding-bottom: 14px,
      children: [colI11Tag, colI11Words],

      colI11Tag = frame : doc.iterTag {
        iterName {
          contents: "i11"
        }
      }

      colI11Words = text : doc.specLabel {
        contents: "i11 · type + spacing rules, insets, nested radii (i10=on, i11=on)",
        font-size: 15
      }
    }
  }

  headHow = frame {
    layout: {stack: {direction: .column, item-gap: 6px}},
    children: [how1, how2, how3, how4],

    how1 = text : doc.specIntro {
      width: 1500px,
      contents: "The grey label over a specimen is its exported symbol; the line under it says what the state means (or, in Foundations, the token’s value in that iteration).",
      font-size: 16
    }

    how2 = text : doc.specIntro {
      width: 1500px,
      contents: "Where a component has a structural iteration variant (…I10, …I11), the i10 / i11 columns show that variant and the label names it. Everything else changes through tokens alone.",
      font-size: 16
    }

    how3 = text : doc.specIntro {
      width: 1500px,
      contents: "This page has no section: section-coloured roles show Home’s red. 1b shows each section’s hues, sheets, pills and menus in that section. Leave the canvas context empty when you view this page: every board sets its own.",
      font-size: 16
    }

    how4 = text : doc.specIntro {
      width: 1500px,
      contents: "Components live in components/atoms, components/molecules and components/organisms (each heading names the file); tokens in tokens/; page sections in blocks/; screens in screens/ (one page per screen, every iteration on it). Conventions: SYSTEM.md.",
      font-size: 16
    }
  }

  headIndex = frame {
    layout: {stack: {item-gap: 80px}},
    padding-top: 8px,
    children: [indexFoundations, indexComponents, indexPatterns, indexStudio],

    indexFoundations = frame {
      layout: {stack: {direction: .column, item-gap: 6px}},
      children: [
        indexFoundationsHead,
        indexFoundations1,
        indexFoundations2,
        indexFoundations3,
        indexFoundations4,
        indexFoundations5,
        indexFoundations6,
        indexFoundations7,
        indexFoundations8,
        indexFoundations9
      ],

      indexFoundationsHead = text : doc.specSubheading {
        contents: "Foundations"
      }

      indexFoundations1 = text : doc.specLabel {
        contents: "1 · Colour · palette",
        font-size: 16
      }

      indexFoundations2 = text : doc.specLabel {
        contents: "1a · Colour roles",
        font-size: 16
      }

      indexFoundations3 = text : doc.specLabel {
        contents: "1b · Section hues",
        font-size: 16
      }

      indexFoundations4 = text : doc.specLabel {
        contents: "2 · Type scale",
        font-size: 16
      }

      indexFoundations5 = text : doc.specLabel {
        contents: "2a · Spacing",
        font-size: 16
      }

      indexFoundations6 = text : doc.specLabel {
        contents: "2b · Insets + radii · control sizes",
        font-size: 16
      }

      indexFoundations7 = text : doc.specLabel {
        contents: "2c · Faces",
        font-size: 16
      }

      indexFoundations8 = text : doc.specLabel {
        contents: "3 · Textures + depth",
        font-size: 16
      }

      indexFoundations9 = text : doc.specLabel {
        contents: "4 · The state ladder",
        font-size: 16
      }
    }

    indexComponents = frame {
      layout: {stack: {direction: .column, item-gap: 6px}},
      children: [
        indexComponentsHead,
        indexComponents1,
        indexComponents2,
        indexComponents3,
        indexComponents4,
        indexComponents5,
        indexComponents6,
        indexComponents7,
        indexComponents8,
        indexComponents9,
        indexComponents10,
        indexComponents11,
        indexComponents12,
        indexComponents13,
        indexComponents14
      ],

      indexComponentsHead = text : doc.specSubheading {
        contents: "Components"
      }

      indexComponents1 = text : doc.specLabel {
        contents: "5 · Buttons + link icons",
        font-size: 16
      }

      indexComponents2 = text : doc.specLabel {
        contents: "5b · Links",
        font-size: 16
      }

      indexComponents3 = text : doc.specLabel {
        contents: "6 · Chips + segmented",
        font-size: 16
      }

      indexComponents4 = text : doc.specLabel {
        contents: "7 · Tags",
        font-size: 16
      }

      indexComponents5 = text : doc.specLabel {
        contents: "8 · Facts + card meta",
        font-size: 16
      }

      indexComponents6 = text : doc.specLabel {
        contents: "9 · Search + fields",
        font-size: 16
      }

      indexComponents7 = text : doc.specLabel {
        contents: "10 · Pills + year marks",
        font-size: 16
      }

      indexComponents8 = text : doc.specLabel {
        contents: "11 · Toast · hint · empty state",
        font-size: 16
      }

      indexComponents9 = text : doc.specLabel {
        contents: "12 · Sound tag",
        font-size: 16
      }

      indexComponents10 = text : doc.specLabel {
        contents: "13 · Media",
        font-size: 16
      }

      indexComponents11 = text : doc.specLabel {
        contents: "14 · Disc · wave · folder",
        font-size: 16
      }

      indexComponents12 = text : doc.specLabel {
        contents: "15 · Cards: projects + posts",
        font-size: 16
      }

      indexComponents13 = text : doc.specLabel {
        contents: "15b · Markdown blocks",
        font-size: 16
      }

      indexComponents14 = text : doc.specLabel {
        contents: "16 · Navigation",
        font-size: 16
      }
    }

    indexPatterns = frame {
      layout: {stack: {direction: .column, item-gap: 6px}},
      children: [
        indexPatternsHead,
        indexPatterns1,
        indexPatterns2,
        indexPatterns3,
        indexPatterns4,
        indexPatterns5
      ],

      indexPatternsHead = text : doc.specSubheading {
        contents: "Patterns"
      }

      indexPatterns1 = text : doc.specLabel {
        contents: "17 · Filters",
        font-size: 16
      }

      indexPatterns2 = text : doc.specLabel {
        contents: "18 · Detail shell",
        font-size: 16
      }

      indexPatterns3 = text : doc.specLabel {
        contents: "19 · Timeline + year groups",
        font-size: 16
      }

      indexPatterns4 = text : doc.specLabel {
        contents: "20 · Player",
        font-size: 16
      }

      indexPatterns5 = text : doc.specLabel {
        contents: "21 · Floating layer (phone chrome)",
        font-size: 16
      }
    }

    indexStudio = frame {
      layout: {stack: {direction: .column, item-gap: 6px}},
      children: [indexStudioHead, indexStudio1, indexStudio2],

      indexStudioHead = text : doc.specSubheading {
        contents: "Studio"
      }

      indexStudio1 = text : doc.specLabel {
        contents: "22 · Studio: chrome + dashboard",
        font-size: 16
      }

      indexStudio2 = text : doc.specLabel {
        contents: "23 · Studio: editors + preview",
        font-size: 16
      }
    }
  }
}

bandFoundations = frame : doc.groupBand {
  title: "Foundations",
  left: 0px,
  top: 1211px,
  width: 5200px,

  bandNote {
    width: 1600px,
    contents: "Colour, type, spacing, insets and radii, faces, textures, and the state ladder every control climbs. Values come from tokens/: the same token resolves differently in each column."
  }

  bandTitle {
    contents: "Foundations"
  }
}

palette = frame : doc.docBoard {
  title: "1 · Colour · palette",
  left: 0px,
  top: 1471px,

  boardHead {
    boardTag {
      iterName {
        contents: "i9 · i10 · i11"
      }
    }

    boardCaption {
      contents: "1 · Colour · palette · the same in every iteration"
    }
  }

  body {
    overrides: [
      insert(paletteHead, after = .nil),
      insert(paletteSub1, after = paletteHead),
      insert(paletteSub2, after = paletteSub1),
      insert(paletteSub3, after = paletteSub2),
      insert(paletteSub4, after = paletteSub3),
      insert(paletteSub5, after = paletteSub4),
      insert(paletteSub6, after = paletteSub5),
      insert(paletteSub7, after = paletteSub6),
      insert(paletteSub8, after = paletteSub7),
      insert(paletteSub9, after = paletteSub8)
    ]
  }

  paletteHead = frame {
    layout: {stack: {direction: .column, item-gap: 10px}},
    children: [paletteTitle, paletteIntro],

    paletteTitle = text : doc.specHeading {
      contents: "1 · Colour · palette"
    }

    paletteIntro = text : doc.specIntro {
      width: 1600px,
      contents: "The raw yarn colours (tokens/color/palette.elyx). They never vary by iteration or section, so they show once. Components never use them directly except content colours (project types, instruments, notes, tiers): every accent goes through a role (1a)."
    }
  }

  paletteSub1 = frame {
    layout: {stack: {direction: .column, item-gap: 16px}},
    children: [paletteSub1Head, paletteSub1Row1],

    paletteSub1Head = frame {
      layout: {stack: {align-items: .center, item-gap: 14px}},
      children: [paletteSub1Name, paletteSub1Path],

      paletteSub1Name = text : doc.specSubheading {
        contents: "Base"
      }

      paletteSub1Path = text : doc.specNote {
        contents: "tokens/color/palette.elyx"
      }
    }

    paletteSub1Row1 = frame : doc.specRow {
      width: 5136px,
      layout.stack.item-gap: 16px,
      layout.stack.line-gap: 20px,
      layout.stack.wrap: .true,
      overrides: [
        insert(swInk, after = .nil),
        insert(swInk2, after = swInk),
        insert(swInk3, after = swInk2),
        insert(swCotton, after = swInk3),
        insert(swCotton2, after = swCotton),
        insert(swCotton3, after = swCotton2),
        insert(swWhite, after = swCotton3)
      ],

      swInk = frame : doc.specSwatch {
        chip {
          fill[0].color: pal.palette.ink
        }

        name {
          contents: "ink"
        }

        refName {
          contents: "#1f1e1e"
        }
      }

      swInk2 = frame : doc.specSwatch {
        chip {
          fill[0].color: pal.palette.ink-2
        }

        name {
          contents: "ink-2"
        }

        refName {
          contents: "#4a4646"
        }
      }

      swInk3 = frame : doc.specSwatch {
        chip {
          fill[0].color: pal.palette.ink-3
        }

        name {
          contents: "ink-3"
        }

        refName {
          contents: "#625c5c"
        }
      }

      swCotton = frame : doc.specSwatch {
        chip {
          fill[0].color: pal.palette.cotton
        }

        name {
          contents: "cotton"
        }

        refName {
          contents: "#fbf8f3"
