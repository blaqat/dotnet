@variants(spacingI10)
spacing = frame : doc.docBoard {
  title: "2a · Spacing · i9",
  left: 0px,
  top: 16617px,

  boardHead {
    boardTag {
      iterName {
        contents: "i9"
      }
    }

    boardCaption {
      contents: "2a · Spacing · base · no context"
    }
  }

  body {
    overrides: [
      insert(spacingHead, after = .nil),
      insert(spacingSub1, after = spacingHead),
      insert(spacingSub2, after = spacingSub1)
    ]
  }

  spacingHead = frame {
    layout: {stack: {direction: .column, item-gap: 10px}},
    children: [spacingTitle, spacingIntro],

    spacingTitle = text : doc.specHeading {
      contents: "2a · Spacing"
    }

    spacingIntro = text : doc.specIntro {
      width: 1100px,
      contents: "The step scale is fixed (4 · 8 · 12 · 16 · 24 · 32 · 48 · 64). Layout tokens set the page, the gutters, the insets and the gaps inside a section; each bar is the token’s length in this iteration. Only the shared ones are here: tokens/space/space.elyx has every part’s own."
    }
  }

  spacingSub1 = frame {
    layout: {stack: {direction: .column, item-gap: 16px}},
    children: [spacingSub1Head, spacingSub1Row1],

    spacingSub1Head = frame {
      layout: {stack: {align-items: .center, item-gap: 14px}},
      children: [spacingSub1Name, spacingSub1Path],

      spacingSub1Name = text : doc.specSubheading {
        contents: "Steps (spc.steps.*)"
      }

      spacingSub1Path = text : doc.specNote {
        contents: "tokens/space/space.elyx"
      }
    }

    spacingSub1Row1 = frame : doc.specRow {
      width: 1456px,
      layout.stack.item-gap: 40px,
      layout.stack.line-gap: 32px,
      layout.stack.wrap: .true,
      overrides: [
        insert(stepsS1Spec, after = .nil),
        insert(stepsS2Spec, after = stepsS1Spec),
        insert(stepsS3Spec, after = stepsS2Spec),
        insert(stepsS4Spec, after = stepsS3Spec),
        insert(stepsS5Spec, after = stepsS4Spec),
        insert(stepsS6Spec, after = stepsS5Spec),
        insert(stepsS7Spec, after = stepsS6Spec),
        insert(stepsS8Spec, after = stepsS7Spec)
      ],

      stepsS1Spec = frame : doc.spec {
        overrides: [insert(stepsS1SpecNote, after = doc.spec.label)],

        label {
          contents: "steps.s1"
